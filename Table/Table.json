{
  "schema": "face",
  "schema-version": 1,
  "name": "Table",
  "description": "Data table with sorting and row selection",
  "props": {
    "columns": {
      "type": "array",
      "required": false,
      "description": "Column definitions."
    },
    "rows": {
      "type": "array",
      "required": false,
      "description": "Row data."
    },
    "rowKey": {
      "type": "string",
      "required": false,
      "description": "Key field on each row, or a function returning a unique key."
    },
    "sortColumn": {
      "type": "string",
      "required": false,
      "description": "Controlled sort column.",
      "default": null
    },
    "sortDirection": {
      "type": "enum",
      "required": false,
      "description": "Controlled sort direction.",
      "options": [
        "asc",
        "desc"
      ],
      "default": "asc"
    },
    "onSortChange": {
      "type": "function",
      "required": false,
      "description": "Callback when sort changes."
    },
    "direction": {
      "type": "function",
      "required": true,
      "description": "direction prop"
    },
    "selectedRows": {
      "type": "array",
      "required": false,
      "description": "Controlled selected row IDs."
    },
    "onSelectedRowsChange": {
      "type": "function",
      "required": false,
      "description": "Callback when selection changes."
    },
    "selectable": {
      "type": "boolean",
      "required": false,
      "description": "Enable row selection.",
      "default": false
    },
    "showRowNumbers": {
      "type": "boolean",
      "required": false,
      "description": "Show row number column.",
      "default": false
    },
    "stickyHeader": {
      "type": "boolean",
      "required": false,
      "description": "Make header sticky on scroll.",
      "default": true
    },
    "showDividers": {
      "type": "boolean",
      "required": false,
      "description": "Show divider lines between rows.",
      "default": true
    },
    "className": {
      "type": "string",
      "required": false,
      "description": "Additional CSS class."
    },
    "getRowId": {
      "type": "function",
      "required": false,
      "description": "Legacy components API alias. Prefer rowKey for new code."
    },
    "onColumnResize": {
      "type": "function",
      "required": false,
      "description": "Callback fired while a resizable column is dragged."
    },
    "resizable": {
      "type": "boolean",
      "required": false,
      "description": "Enable column resizing and fixed table layout.",
      "default": false
    },
    "stickyLastColumn": {
      "type": "boolean",
      "required": false,
      "description": "Keep the last column visually sticky for dense action tables.",
      "default": false
    },
    "onRowClick": {
      "type": "function",
      "required": false,
      "description": "Callback when a row is clicked."
    },
    "onRowMouseEnter": {
      "type": "function",
      "required": false,
      "description": "Callback when mouse enters a row."
    },
    "onRowMouseLeave": {
      "type": "function",
      "required": false,
      "description": "Callback when mouse leaves a row."
    },
    "activeRowId": {
      "type": "string",
      "required": false,
      "description": "Row ID to highlight as active (applies `data-active` attribute)."
    },
    "membrane": {
      "type": "boolean",
      "required": false,
      "description": "Enable membrane (tile-like) row styles: rounded corners, hover bg, padding.",
      "default": false
    },
    "ariaLabel": {
      "type": "string",
      "required": false,
      "description": "Accessible label for the table when there is no visible caption."
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "selectable": false,
        "showRowNumbers": true,
        "stickyHeader": true,
        "showDividers": true,
        "resizable": false,
        "stickyLastColumn": false,
        "columns": [
          {
            "id": "name",
            "header": "Name",
            "accessor": "name",
            "truncate": true
          },
          {
            "id": "status",
            "header": "Status",
            "accessor": "status"
          },
          {
            "id": "price",
            "header": "Price",
            "accessor": "price",
            "align": "right"
          }
        ],
        "rows": [
          {
            "id": "r1",
            "name": "Akt Typeface 1.0",
            "status": "Published",
            "price": "₽ 2 990"
          },
          {
            "id": "r2",
            "name": "Begriffsschrift",
            "status": "Draft",
            "price": "₽ 1 990"
          },
          {
            "id": "r3",
            "name": "A very long row name to test truncation",
            "status": "Archived",
            "price": "—"
          }
        ]
      }
    },
    {
      "name": "Selectable",
      "props": {
        "selectable": true
      }
    },
    {
      "name": "Sorted Ascending",
      "props": {
        "sortColumn": "name",
        "sortDirection": "asc"
      }
    },
    {
      "name": "Sorted Descending",
      "props": {
        "sortColumn": "name",
        "sortDirection": "desc"
      }
    }
  ],
  "behavior": {},
  "keyboard": {
    "ArrowDown": {
      "action": "focusNextRow"
    },
    "ArrowUp": {
      "action": "focusPreviousRow"
    },
    "Space": {
      "action": "toggleRowSelection",
      "condition": "selectable"
    }
  },
  "aria": {
    "role": "table",
    "required": [
      "aria-label"
    ]
  },
  "composition": {
    "required": [
      "root",
      "header",
      "body",
      "row",
      "cell"
    ],
    "recommended": [
      "headerCell",
      "sortIndicator"
    ],
    "parts": {
      "root": {
        "slot": "root"
      },
      "header": {
        "slot": "header",
        "parent": "root"
      },
      "headerCell": {
        "slot": "headerCell",
        "parent": "header",
        "multiple": true
      },
      "sortIndicator": {
        "slot": "sortIndicator",
        "parent": "headerCell"
      },
      "body": {
        "slot": "body",
        "parent": "root"
      },
      "row": {
        "slot": "row",
        "parent": "body",
        "multiple": true
      },
      "cell": {
        "slot": "cell",
        "parent": "row",
        "multiple": true
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-table-row-number-width",
      "--uf-table-resize-hit-width",
      "--uf-table-resize-line-offset-x",
      "--uf-table-resize-line-inset-y",
      "--uf-table-divider-width",
      "--uf-table-membrane-cell-pad-x",
      "--uf-table-sort-icon-gap"
    ],
    "semanticFallbacks": [
      "--uf-control-height",
      "--uf-control-font-size",
      "--uf-control-line-height",
      "--uf-control-pad-text",
      "--uf-membrane",
      "--uf-font-size-xs",
      "--uf-font-weight-bold",
      "--uf-radius",
      "--uf-color-bg",
      "--uf-color-fg",
      "--uf-color-border",
      "--uf-color-hover-bg",
      "--uf-motion-duration-emphasis",
      "--uf-motion-ease-emphasized"
    ],
    "notes": [
      "Table cell/header text is rendered through Text wrappers to keep typography centralized.",
      "Resizable/sticky compatibility props map to table component tokens, and membrane row emphasis uses shared Face UI motion tokens."
    ]
  },
  "platform": {},
  "usage": {
    "whenToUse": [
      "Structured data display",
      "Sortable/filterable data lists",
      "CRUD data management"
    ],
    "whenNotToUse": [
      "Simple key-value pairs (use Text)",
      "Card-based layouts (use Card grid)"
    ],
    "alternatives": [
      "Card"
    ],
    "context": "both"
  }
}
