{
  "schema": "face",
  "schema-version": 1,
  "name": "Toast",
  "description": "Composable notification surface shared by the declarative Toast and imperative Toaster APIs",
  "props": {
    "title": {
      "type": "ReactNode",
      "required": false,
      "description": "Primary notification text."
    },
    "description": {
      "type": "ReactNode",
      "required": false,
      "description": "Supporting notification text."
    },
    "action": {
      "type": "object",
      "required": false,
      "description": "Optional action button. Invoking it also requests dismissal."
    },
    "tone": {
      "type": "enum",
      "required": false,
      "description": "Semantic notification tone.",
      "options": [
        "destructive",
        "neutral",
        "positive",
        "warning"
      ],
      "default": "neutral"
    },
    "dismissible": {
      "type": "boolean",
      "required": false,
      "description": "Render the icon-only dismiss button.",
      "default": true
    },
    "closeLabel": {
      "type": "string",
      "required": false,
      "description": "Accessible label for the dismiss button.",
      "default": "Close notification"
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "title": "Workspace updated",
        "description": "Your changes are available to collaborators.",
        "tone": "neutral",
        "dismissible": true
      }
    },
    {
      "name": "Positive",
      "props": {
        "title": "Deployment completed",
        "description": "Production is healthy and serving the new release.",
        "tone": "positive",
        "dismissible": true
      }
    },
    {
      "name": "Warning",
      "props": {
        "title": "Usage is near the limit",
        "description": "This workspace has used 82% of its monthly quota.",
        "tone": "warning",
        "dismissible": true
      }
    },
    {
      "name": "Destructive",
      "props": {
        "title": "Deployment failed",
        "description": "Review the build log before retrying.",
        "tone": "destructive",
        "dismissible": true
      }
    }
  ],
  "behavior": {
    "dismissOnEscape": false,
    "autoFocusOnOpen": "none"
  },
  "keyboard": {},
  "aria": {
    "role": "status",
    "live": "polite",
    "toneRolePolicy": "All toast tones stay non-blocking polite status messages. Use Modal or alertdialog for blocking alerts."
  },
  "composition": {
    "required": [
      "root",
      "group",
      "item"
    ],
    "recommended": [
      "title",
      "description",
      "action",
      "close"
    ],
    "parts": {
      "root": {
        "slot": "root"
      },
      "group": {
        "slot": "group",
        "parent": "root"
      },
      "item": {
        "slot": "item",
        "parent": "group",
        "multiple": true
      },
      "title": {
        "slot": "title",
        "parent": "item"
      },
      "description": {
        "slot": "description",
        "parent": "item"
      },
      "action": {
        "slot": "action",
        "parent": "item"
      },
      "close": {
        "slot": "close",
        "parent": "item"
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-toast-container-max-width",
      "--uf-toast-border-width",
      "--uf-toast-compact-inset",
      "--uf-toast-viewport-inset",
      "--uf-z-toast"
    ],
    "semanticFallbacks": [
      "--uf-control-height",
      "--uf-radius-md",
      "--uf-font-size",
      "--uf-font-size-sm",
      "--uf-font-weight-bold",
      "--uf-color-fg-muted",
      "--uf-color-success",
      "--uf-color-warning",
      "--uf-color-destructive",
      "--uf-overlay-surface-bg",
      "--uf-overlay-surface-border",
      "--uf-overlay-surface-blur",
      "--uf-overlay-surface-shadow"
    ],
    "notes": [
      "Toast content uses Text and Bar/Button primitives internally; do not create toast-local typography classes for new copy.",
      "Toast surfaces use the shared overlay/dropdown background while semantic tones map the full border to monochrome feedback tokens.",
      "Toaster renders the same public Toast surface and uses the shared --uf-z-toast layer token."
    ]
  },
  "platform": {},
  "usage": {
    "whenToUse": [
      "Success/error notifications",
      "Non-blocking status messages",
      "Action confirmations"
    ],
    "whenNotToUse": [
      "Blocking alerts (use Modal)",
      "Inline validation (use Input error prop)"
    ],
    "alternatives": [
      "Modal"
    ],
    "context": "app"
  }
}
