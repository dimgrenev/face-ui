{
  "schema": "face",
  "schema-version": 1,
  "name": "Menu",
  "description": "A list of actions opened from its trigger, or at the pointer as a context menu.",
  "props": {
    "children": {
      "type": "ReactNode",
      "required": false,
      "description": "The trigger: one element that takes the trigger props and ref, or text shown as a Button; without it nothing renders."
    },
    "items": {
      "type": "array",
      "required": false,
      "description": "Items, separators and labelled groups in menu order; an item repeating an earlier value is dropped.",
      "contract": {
        "item": {
          "type": "object",
          "required": [
            "value",
            "label"
          ],
          "properties": {
            "value": {
              "type": "string",
              "description": "Stable key, unique within the collection; an empty string is a valid key."
            },
            "label": {
              "type": "node",
              "description": "Visible content."
            },
            "disabled": {
              "type": "boolean",
              "required": false,
              "description": "Keeps the item visible but out of selection and keyboard navigation."
            },
            "textValue": {
              "type": "string",
              "required": false,
              "description": "Plain text for typeahead and filtering when `label` is not a string."
            },
            "icon": {
              "type": "node",
              "required": false,
              "description": "Icon at the start of the label."
            },
            "href": {
              "type": "string",
              "required": false,
              "description": "Makes the item a link to this URL: activation follows it, and modifier keys open it elsewhere as for any link."
            },
            "checked": {
              "type": "boolean",
              "required": false,
              "description": "Makes the item a checkbox item that shows a check and is announced as checked while true."
            },
            "tone": {
              "type": "enum",
              "required": false,
              "options": [
                "neutral",
                "destructive"
              ],
              "default": "neutral",
              "description": "`destructive` marks an action that deletes or cannot be undone. Default neutral."
            }
          }
        },
        "separator": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "literal",
              "value": "separator"
            }
          }
        },
        "group": {
          "type": "object",
          "required": [
            "type",
            "label",
            "items"
          ],
          "properties": {
            "type": {
              "type": "literal",
              "value": "group"
            },
            "label": {
              "type": "node",
              "description": "Visible group heading."
            },
            "items": {
              "type": "array",
              "description": "The grouped items and separators, in order."
            }
          }
        }
      }
    },
    "openOn": {
      "type": "enum",
      "required": false,
      "description": "Opens on a click of the trigger, or on its context menu at the pointer. Default click.",
      "options": [
        "click",
        "context"
      ],
      "default": "click"
    },
    "open": {
      "type": "boolean",
      "required": false,
      "description": "Controlled visibility; a disabled Menu, or one without a trigger, stays closed."
    },
    "defaultOpen": {
      "type": "boolean",
      "required": false,
      "description": "Visibility on mount when `open` is not set; read once.",
      "default": false
    },
    "disabled": {
      "type": "boolean",
      "required": false,
      "description": "Disables the trigger and closes an open menu.",
      "default": false
    },
    "surface": {
      "type": "enum",
      "required": false,
      "description": "Where the menu opens: auto is a popover, or a bottom sheet below 900px.",
      "options": [
        "auto",
        "popover",
        "sheet"
      ],
      "default": "auto"
    },
    "side": {
      "type": "enum",
      "required": false,
      "description": "Preferred side of the trigger for a click menu's popover; flips when the opposite side has more room. Default bottom.",
      "options": [
        "bottom",
        "left",
        "right",
        "top"
      ],
      "default": "bottom"
    },
    "align": {
      "type": "enum",
      "required": false,
      "description": "Alignment of a click menu's popover on the cross axis, following the trigger's direction. Default end.",
      "options": [
        "center",
        "end",
        "start"
      ],
      "default": "end"
    },
    "sideOffset": {
      "type": "number",
      "required": false,
      "description": "Gap in pixels between the trigger and a click menu's popover; negative values overlap them. Default 4."
    },
    "aria-label": {
      "type": "string",
      "required": false,
      "description": "Names the menu and titles the sheet; without it a click menu is named by its trigger."
    },
    "labels": {
      "type": "object",
      "required": false,
      "description": "Strings Menu renders itself: `close` names the sheet's close button."
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "openOn": "click",
        "disabled": false,
        "surface": "auto",
        "side": "bottom",
        "align": "end",
        "sideOffset": 4,
        "items": [
          {
            "value": "edit",
            "label": "Edit"
          },
          {
            "value": "delete",
            "label": "Delete",
            "tone": "destructive"
          }
        ],
        "children": "Menu"
      }
    },
    {
      "name": "Context Menu",
      "props": {
        "openOn": "context"
      }
    },
    {
      "name": "Disabled",
      "props": {
        "disabled": true
      }
    }
  ],
  "behavior": {
    "rovingFocus": true,
    "typeahead": true,
    "dismissOnEscape": true,
    "dismissOnClickOutside": true,
    "closeOnSelect": true,
    "closeOnTab": true,
    "autoFocusOnOpen": "keyboard: first or last item; pointer: the menu list",
    "contextMenuAtPointer": true
  },
  "keyboard": {
    "ArrowDown": {
      "action": "focusNext",
      "scope": "menu"
    },
    "ArrowUp": {
      "action": "focusPrevious",
      "scope": "menu"
    },
    "Home": {
      "action": "focusFirst",
      "scope": "menu"
    },
    "End": {
      "action": "focusLast",
      "scope": "menu"
    },
    "Enter": {
      "action": "select"
    },
    "Space": {
      "action": "select"
    },
    "Escape": {
      "action": "close"
    },
    "Tab": {
      "action": "close"
    }
  },
  "aria": {
    "role": "menu"
  },
  "composition": {
    "required": [
      "root",
      "trigger",
      "content",
      "list"
    ],
    "recommended": [
      "item",
      "separator",
      "group",
      "group-label"
    ],
    "parts": {
      "root": {
        "slot": "root"
      },
      "trigger": {
        "slot": "trigger",
        "parent": "root"
      },
      "content": {
        "slot": "content",
        "parent": "root"
      },
      "list": {
        "slot": "list",
        "parent": "content"
      },
      "item": {
        "slot": "item",
        "parent": "list",
        "multiple": true
      },
      "icon": {
        "slot": "icon",
        "parent": "item"
      },
      "indicator": {
        "slot": "indicator",
        "parent": "item"
      },
      "separator": {
        "slot": "separator",
        "parent": "list",
        "multiple": true
      },
      "group": {
        "slot": "group",
        "parent": "list",
        "multiple": true
      },
      "group-label": {
        "slot": "group-label",
        "parent": "group"
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-menu-min-w",
      "--uf-menu-border-width",
      "--uf-menu-sheet-inset",
      "--uf-menu-sheet-gap",
      "--uf-menu-sheet-enter-y",
      "--uf-menu-separator-h"
    ],
    "semanticFallbacks": [
      "--uf-control-pad-text",
      "--uf-membrane",
      "--uf-spacing-1",
      "--uf-font-size-xs",
      "--uf-font-weight-bold",
      "--uf-radius-md",
      "--uf-z-dropdown",
      "--uf-z-overlay",
      "--uf-duration-enter",
      "--uf-duration-exit",
      "--uf-ease-enter",
      "--uf-color-fg-muted",
      "--uf-color-hover-bg",
      "--uf-color-border",
      "--uf-overlay-surface-bg",
      "--uf-overlay-surface-border",
      "--uf-overlay-surface-blur",
      "--uf-overlay-surface-shadow",
      "--uf-overlay-enter-y",
      "--uf-overlay-enter-scale",
      "--uf-color-destructive"
    ],
    "notes": [
      "Menu items reuse option/control anatomy and should not introduce parallel button typography.",
      "Compact and popover presentations share overlay surface tokens with Select and Popover."
    ]
  },
  "platform": {
    "popover": true
  },
  "usage": {
    "whenToUse": [
      "Contextual actions on an element",
      "Dropdown with action items",
      "Right-click context menu"
    ],
    "whenNotToUse": [
      "Choosing a value for a form field (use Select)",
      "Navigation between pages (use Navigation)",
      "Command search with filtering (use Command)"
    ],
    "alternatives": [
      "Select",
      "Command",
      "Navigation"
    ],
    "context": "app"
  }
}
