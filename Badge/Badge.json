{
  "schema": "face",
  "schema-version": 1,
  "name": "Badge",
  "description": "Status indicator label",
  "props": {
    "text": {
      "type": "string",
      "required": false,
      "description": "Badge text content"
    },
    "variant": {
      "type": "enum",
      "required": false,
      "description": "Structural badge variant. Combine with tone for semantic status color.",
      "options": [
        "default",
        "primary",
        "secondary"
      ],
      "default": "default"
    },
    "appearance": {
      "type": "enum",
      "required": false,
      "description": "Fill or outline appearance",
      "options": [
        "fill",
        "outline"
      ],
      "default": "outline"
    },
    "tone": {
      "type": "enum",
      "required": false,
      "description": "Semantic status tone. Combines with fill or outline appearance.",
      "options": [
        "neutral",
        "accent",
        "positive",
        "warning",
        "destructive"
      ],
      "default": "neutral"
    },
    "children": {
      "type": "string",
      "required": false,
      "description": "Custom children content (overrides text)"
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "text": "Badge"
      }
    },
    {
      "name": "Primary Fill",
      "props": {
        "text": "Primary",
        "variant": "primary",
        "appearance": "fill"
      }
    },
    {
      "name": "Secondary Fill",
      "props": {
        "text": "Secondary",
        "variant": "secondary",
        "appearance": "fill"
      }
    },
    {
      "name": "Accent Outline",
      "props": {
        "text": "Accent",
        "tone": "accent"
      }
    },
    {
      "name": "Positive Outline",
      "props": {
        "text": "Positive",
        "tone": "positive"
      }
    },
    {
      "name": "Warning Outline",
      "props": {
        "text": "Warning",
        "tone": "warning"
      }
    },
    {
      "name": "Destructive Outline",
      "props": {
        "text": "Destructive",
        "tone": "destructive"
      }
    },
    {
      "name": "Destructive Fill",
      "props": {
        "text": "Destructive",
        "appearance": "fill",
        "tone": "destructive"
      }
    }
  ],
  "behavior": {},
  "keyboard": {},
  "aria": {},
  "composition": {
    "required": [
      "root"
    ],
    "parts": {
      "root": {
        "slot": "root"
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-badge-outline-width",
      "--uf-badge-bg",
      "--uf-badge-fg",
      "--uf-badge-border"
    ],
    "semanticFallbacks": [
      "--uf-membrane",
      "--uf-control-pad-icon",
      "--uf-control-line-height",
      "--uf-font-size-xs",
      "--uf-font-weight-bold",
      "--uf-radius-full",
      "--uf-color-primary",
      "--uf-color-primary-fg",
      "--uf-color-hover-bg",
      "--uf-color-fg",
      "--uf-color-border",
      "--uf-color-destructive",
      "--uf-color-destructive-fg",
      "--uf-color-accent",
      "--uf-color-accent-fg",
      "--uf-color-success",
      "--uf-color-success-foreground",
      "--uf-color-warning",
      "--uf-color-warning-foreground"
    ],
    "notes": [
      "Badge content renders through Text with inset=control and membrane enabled.",
      "Variant tokens are local aliases over semantic intent colors."
    ]
  },
  "platform": {},
  "usage": {
    "whenToUse": [
      "Status indicators",
      "Count notifications",
      "Category labels/tags"
    ],
    "whenNotToUse": [
      "Action buttons (use Button)",
      "Large informational blocks (use Card)"
    ],
    "alternatives": [
      "Text",
      "Button"
    ],
    "context": "both"
  }
}
