{
  "schema": "face",
  "schema-version": 1,
  "name": "Select",
  "description": "Option picker with single and multi-select support",
  "props": {
    "disabled": {
      "type": "boolean",
      "required": false,
      "description": "Disable focus, interaction and native form submission.",
      "default": false
    },
    "name": {
      "type": "string",
      "required": false,
      "description": "Native form key; multiple values produce repeated entries."
    },
    "form": {
      "type": "string",
      "required": false,
      "description": "Associate this field with a form by id."
    },
    "aria-label": {
      "type": "string",
      "required": false,
      "description": "Accessible field name when a visible label is not appropriate."
    },
    "options": {
      "type": "array",
      "required": false,
      "description": "Available choices, with unique values."
    },
    "placeholder": {
      "type": "string",
      "required": false,
      "description": "Hint shown when no value or display override is present.",
      "default": "Select option"
    },
    "label": {
      "type": "ReactNode",
      "required": false,
      "description": "Visible field label; native aria-label/aria-labelledby override its accessible name."
    },
    "labelOrientation": {
      "type": "enum",
      "required": false,
      "description": "Label placement. Has no effect without a label.",
      "options": [
        "vertical",
        "horizontal"
      ],
      "default": "vertical"
    },
    "displayValue": {
      "type": "ReactNode",
      "required": false,
      "description": "Replace selected labels in the trigger, for example with a count or icon."
    },
    "iconOnly": {
      "type": "boolean",
      "required": false,
      "description": "A square trigger without a chevron. Supply an accessible field name.",
      "default": false
    },
    "fullWidth": {
      "type": "boolean",
      "required": false,
      "description": "Fill the available inline width. Defaults to true.",
      "default": true
    },
    "stretchText": {
      "type": "boolean",
      "required": false,
      "description": "Expand the value area and align the chevron to the inline end.",
      "default": false
    },
    "required": {
      "type": "boolean",
      "required": false,
      "description": "Require at least one selection for native form validation.",
      "default": false
    },
    "open": {
      "type": "boolean",
      "required": false,
      "description": "Controlled popup visibility. Disabled/empty lists cannot be opened."
    },
    "defaultOpen": {
      "type": "boolean",
      "required": false,
      "description": "Uncontrolled initial popup visibility.",
      "default": false
    },
    "surface": {
      "type": "enum",
      "required": false,
      "description": "Auto uses a sheet on compact viewports; side is a hover/click inspector picker.",
      "options": [
        "auto",
        "popover",
        "sheet",
        "side"
      ],
      "default": "auto"
    },
    "surfaceBreakpoint": {
      "type": "number",
      "required": false,
      "description": "Viewport breakpoint used only by surface=\"auto\"."
    },
    "surfaceTitle": {
      "type": "ReactNode",
      "required": false,
      "description": "Mobile sheet heading. Falls back to the field label or accessible name."
    },
    "closeLabel": {
      "type": "string",
      "required": false,
      "description": "Accessible name for the sheet close button.",
      "default": "Close"
    },
    "contentMinWidth": {
      "type": "any",
      "required": false,
      "description": "Minimum popover width, capped by the viewport. Does not resize side/sheet surfaces."
    },
    "membrane": {
      "type": "boolean",
      "required": false,
      "description": "Shared membrane around the trigger and option geometry.",
      "default": true
    },
    "multiple": {
      "type": "boolean",
      "required": false,
      "description": "Select one option.",
      "default": false
    },
    "value": {
      "type": "any",
      "required": false,
      "description": "Selected option, or null for no selection."
    },
    "defaultValue": {
      "type": "any",
      "required": false,
      "description": "Initial selection, restored on form reset."
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "placeholder": "Choose option",
        "disabled": false,
        "labelOrientation": "vertical",
        "stretchText": false,
        "surface": "auto",
        "membrane": true,
        "options": [
          {
            "value": "1",
            "label": "Option 1"
          },
          {
            "value": "2",
            "label": "Option 2"
          }
        ],
        "label": "Select"
      }
    },
    {
      "name": "Multiselect",
      "props": {
        "options": [
          {
            "value": "1",
            "label": "Option 1"
          },
          {
            "value": "2",
            "label": "Option 2"
          },
          {
            "value": "3",
            "label": "Option 3"
          }
        ],
        "placeholder": "Select items...",
        "multiple": true
      }
    },
    {
      "name": "Side",
      "props": {
        "stretchText": true,
        "options": [
          {
            "value": "icon",
            "label": "Icon"
          },
          {
            "value": "responsive-sheet-header",
            "label": "ResponsiveSheetHeader"
          }
        ],
        "placeholder": "Select...",
        "surface": "side"
      }
    },
    {
      "name": "Icon only",
      "props": {
        "surface": "popover",
        "displayValue": "{}",
        "contentMinWidth": "10rem",
        "options": [
          {
            "value": "string",
            "label": "String"
          },
          {
            "value": "boolean",
            "label": "Boolean"
          },
          {
            "value": "object",
            "label": "Object"
          }
        ],
        "placeholder": "Type",
        "iconOnly": true,
        "fullWidth": false,
        "aria-label": "Change type"
      }
    },
    {
      "name": "Disabled",
      "props": {
        "disabled": true,
        "placeholder": "Disabled"
      }
    }
  ],
  "behavior": {
    "rovingFocus": false,
    "typeahead": true,
    "dismissOnEscape": true,
    "dismissOnClickOutside": true,
    "autoFocusOnOpen": "listbox-in-sheet",
    "activeDescendant": true
  },
  "keyboard": {
    "ArrowDown": {
      "action": "focusNext",
      "scope": "listbox"
    },
    "ArrowUp": {
      "action": "focusPrevious",
      "scope": "listbox"
    },
    "Enter": {
      "action": "select"
    },
    "Space": {
      "action": "select"
    },
    "Escape": {
      "action": "close"
    },
    "Home": {
      "action": "focusFirst",
      "scope": "listbox"
    },
    "End": {
      "action": "focusLast",
      "scope": "listbox"
    }
  },
  "aria": {
    "role": "combobox",
    "labelledBy": "select-label"
  },
  "composition": {
    "required": [
      "root",
      "trigger",
      "content"
    ],
    "recommended": [
      "item",
      "group",
      "label"
    ],
    "parts": {
      "root": {
        "slot": "root"
      },
      "trigger": {
        "slot": "trigger",
        "parent": "root"
      },
      "indicator": {
        "slot": "indicator",
        "parent": "trigger"
      },
      "content": {
        "slot": "content",
        "parent": "root"
      },
      "item": {
        "slot": "item",
        "parent": "content",
        "multiple": true
      },
      "group": {
        "slot": "group",
        "parent": "content",
        "multiple": true
      },
      "label": {
        "slot": "label",
        "parent": "root"
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-select-sheet-inset",
      "--uf-select-sheet-gap",
      "--uf-select-content-max-height",
      "--uf-selector-indicator-gap",
      "--uf-selector-indicator-offset-inline-start",
      "--uf-selector-indicator-edge-gap",
      "--uf-selector-indicator-size",
      "--uf-select-content-min-width",
      "--uf-select-indicator-gap",
      "--uf-select-indicator-edge-gap",
      "--uf-select-indicator-size",
      "--uf-select-panel-pad",
      "--uf-select-sheet-enter-y"
    ],
    "semanticFallbacks": [
      "--uf-control-height",
      "--uf-control-font-size",
      "--uf-control-pad-y",
      "--uf-control-pad-text",
      "--uf-control-pad-icon",
      "--uf-control-gap",
      "--uf-font-size-sm",
      "--uf-font-weight",
      "--uf-font-weight-bold",
      "--uf-radius",
      "--uf-radius-lg",
      "--uf-membrane",
      "--uf-spacing-1",
      "--uf-z-dropdown",
      "--uf-z-overlay",
      "--uf-duration-enter",
      "--uf-duration-exit",
      "--uf-ease-enter",
      "--uf-motion-duration-fast",
      "--uf-motion-ease-out",
      "--uf-color-fg",
      "--uf-color-fg-muted",
      "--uf-color-border",
      "--uf-color-hover-bg",
      "--uf-overlay-backdrop-bg",
      "--uf-overlay-backdrop-blur",
      "--uf-overlay-surface-bg",
      "--uf-overlay-surface-border",
      "--uf-overlay-surface-blur",
      "--uf-overlay-surface-shadow",
      "--uf-overlay-enter-y",
      "--uf-overlay-enter-scale"
    ],
    "notes": [
      "Select shares overlay tokens with responsive sheets and popovers; keep trigger and option geometry on control tokens.",
      "Trigger indicator is a selector-specific system icon and uses compact indicator spacing instead of generic button icon spacing.",
      "Option labels should render through Text-compatible label nodes rather than raw typography classes."
    ]
  },
  "platform": {
    "popover": true
  },
  "usage": {
    "whenToUse": [
      "Choosing one option from a predefined list",
      "Form field with enumerated values",
      "Multi-select for tags or categories"
    ],
    "whenNotToUse": [
      "Binary choice (use Switcher)",
      "2-3 visible options (use Radio or SegmentedControl)",
      "Free text input (use Input)"
    ],
    "alternatives": [
      "Radio",
      "SegmentedControl",
      "Switcher",
      "Command"
    ],
    "context": "both"
  }
}
