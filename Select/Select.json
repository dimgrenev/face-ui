{
  "schema": "face",
  "schema-version": 1,
  "name": "Select",
  "description": "A button that opens a list of items to choose one value, or several with `multiple`.",
  "props": {
    "label": {
      "type": "ReactNode",
      "required": false,
      "description": "Visible name of the value. Empty content leaves naming to aria-label/aria-labelledby."
    },
    "description": {
      "type": "ReactNode",
      "required": false,
      "description": "Help for entering the value, announced with the focused control."
    },
    "error": {
      "type": "ReactNode",
      "required": false,
      "description": "Validation message; marks the field invalid unless aria-invalid is explicit. Not a live region."
    },
    "labelPosition": {
      "type": "enum",
      "required": false,
      "description": "Label above the control, or at its inline start (stacks when narrow). Defaults to top.",
      "options": [
        "top",
        "start"
      ],
      "default": "top"
    },
    "items": {
      "type": "array",
      "required": false,
      "description": "Choices in list and keyboard order; an item repeating an earlier value is dropped."
    },
    "placeholder": {
      "type": "string",
      "required": false,
      "description": "Text in the trigger while nothing is selected and `displayValue` is empty."
    },
    "displayValue": {
      "type": "ReactNode",
      "required": false,
      "description": "Replaces the selected labels in the trigger, for example with a count or an icon."
    },
    "disabled": {
      "type": "boolean",
      "required": false,
      "description": "Disables the trigger and leaves the value out of FormData.",
      "default": false
    },
    "name": {
      "type": "string",
      "required": false,
      "description": "FormData key; a multiple value submits one entry per selected item."
    },
    "form": {
      "type": "string",
      "required": false,
      "description": "Id of the form that submits and resets the value, when it is not an ancestor."
    },
    "required": {
      "type": "boolean",
      "required": false,
      "description": "Blocks form submission until an item is selected and marks the label.",
      "default": false
    },
    "aria-label": {
      "type": "string",
      "required": false,
      "description": "Names the field when there is no visible `label`, and then titles the sheet."
    },
    "aria-labelledby": {
      "type": "string",
      "required": false,
      "description": "Ids of elements that name the field; they take precedence over `label` and `aria-label`."
    },
    "iconOnly": {
      "type": "boolean",
      "required": false,
      "description": "A square trigger without a chevron; name it with `aria-label`.",
      "default": false
    },
    "fullWidth": {
      "type": "boolean",
      "required": false,
      "description": "Fills the available inline width.",
      "default": true
    },
    "stretchText": {
      "type": "boolean",
      "required": false,
      "description": "Expands the value area so the chevron sits at the inline end.",
      "default": false
    },
    "open": {
      "type": "boolean",
      "required": false,
      "description": "Controlled list visibility; a disabled Select, or one without enabled items, stays closed."
    },
    "defaultOpen": {
      "type": "boolean",
      "required": false,
      "description": "List visibility on mount when `open` is not set; read once.",
      "default": false
    },
    "surface": {
      "type": "enum",
      "required": false,
      "description": "Where the list opens: auto is a popover, or a bottom sheet below 900px; side opens beside the trigger on hover or click.",
      "options": [
        "auto",
        "popover",
        "sheet",
        "side"
      ],
      "default": "auto"
    },
    "labels": {
      "type": "object",
      "required": false,
      "description": "Strings Select renders itself: `close` names the sheet's close button."
    },
    "contentMinWidth": {
      "type": "any",
      "required": false,
      "description": "Minimum popover width in pixels or CSS length, capped by the viewport; side and sheet surfaces ignore it."
    },
    "membrane": {
      "type": "boolean",
      "required": false,
      "description": "Shared outer spacing around the trigger and each item; toggling it keeps the trigger.",
      "default": true
    },
    "multiple": {
      "type": "boolean",
      "required": false,
      "description": "Lets the user select any number of items and makes the value a `string[]` instead of `string | null`; selecting then keeps the list open.",
      "default": false
    },
    "value": {
      "type": "any",
      "required": false,
      "description": "Selected value, or values with `multiple`; a value missing from `items` shows as unselected until it appears."
    },
    "defaultValue": {
      "type": "any",
      "required": false,
      "description": "Selection on mount, restored by form reset; same shape as `value`."
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "placeholder": "Choose option",
        "disabled": false,
        "stretchText": false,
        "surface": "auto",
        "membrane": true,
        "items": [
          {
            "value": "1",
            "label": "Option 1"
          },
          {
            "value": "2",
            "label": "Option 2"
          }
        ],
        "label": "Select"
      }
    },
    {
      "name": "Multiselect",
      "props": {
        "items": [
          {
            "value": "1",
            "label": "Option 1"
          },
          {
            "value": "2",
            "label": "Option 2"
          },
          {
            "value": "3",
            "label": "Option 3"
          }
        ],
        "placeholder": "Select items...",
        "multiple": true,
        "label": "Tags"
      }
    },
    {
      "name": "Side",
      "props": {
        "stretchText": true,
        "items": [
          {
            "value": "icon",
            "label": "Icon"
          },
          {
            "value": "responsive-sheet-header",
            "label": "ResponsiveSheetHeader"
          }
        ],
        "placeholder": "Select...",
        "surface": "side",
        "label": "Component"
      }
    },
    {
      "name": "Icon only",
      "props": {
        "surface": "popover",
        "displayValue": "{}",
        "contentMinWidth": "10rem",
        "items": [
          {
            "value": "string",
            "label": "String"
          },
          {
            "value": "boolean",
            "label": "Boolean"
          },
          {
            "value": "object",
            "label": "Object"
          }
        ],
        "placeholder": "Type",
        "iconOnly": true,
        "fullWidth": false,
        "aria-label": "Change type"
      }
    },
    {
      "name": "Disabled",
      "props": {
        "disabled": true,
        "placeholder": "Disabled",
        "label": "Plan"
      }
    }
  ],
  "behavior": {
    "rovingFocus": false,
    "typeahead": true,
    "dismissOnEscape": true,
    "dismissOnClickOutside": true,
    "autoFocusOnOpen": "listbox-in-sheet",
    "activeDescendant": true
  },
  "keyboard": {
    "ArrowDown": {
      "action": "focusNext",
      "scope": "listbox"
    },
    "ArrowUp": {
      "action": "focusPrevious",
      "scope": "listbox"
    },
    "Enter": {
      "action": "select"
    },
    "Space": {
      "action": "select"
    },
    "Escape": {
      "action": "close"
    },
    "Home": {
      "action": "focusFirst",
      "scope": "listbox"
    },
    "End": {
      "action": "focusLast",
      "scope": "listbox"
    }
  },
  "aria": {
    "role": "combobox",
    "labelledBy": "select-label"
  },
  "composition": {
    "required": [
      "root",
      "trigger",
      "content"
    ],
    "recommended": [
      "item",
      "group",
      "label"
    ],
    "parts": {
      "root": {
        "slot": "root"
      },
      "trigger": {
        "slot": "trigger",
        "parent": "root"
      },
      "indicator": {
        "slot": "indicator",
        "parent": "trigger"
      },
      "content": {
        "slot": "content",
        "parent": "root"
      },
      "item": {
        "slot": "item",
        "parent": "content",
        "multiple": true
      },
      "group": {
        "slot": "group",
        "parent": "content",
        "multiple": true
      },
      "label": {
        "slot": "label",
        "parent": "root"
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-select-sheet-inset",
      "--uf-select-sheet-gap",
      "--uf-select-content-max-height",
      "--uf-selector-indicator-gap",
      "--uf-selector-indicator-offset-inline-start",
      "--uf-selector-indicator-edge-gap",
      "--uf-selector-indicator-size",
      "--uf-select-content-min-width",
      "--uf-select-indicator-gap",
      "--uf-select-indicator-edge-gap",
      "--uf-select-indicator-size",
      "--uf-select-panel-pad",
      "--uf-select-sheet-enter-y"
    ],
    "semanticFallbacks": [
      "--uf-control-height",
      "--uf-control-font-size",
      "--uf-control-pad-y",
      "--uf-control-pad-text",
      "--uf-control-pad-icon",
      "--uf-control-gap",
      "--uf-font-size-sm",
      "--uf-font-weight",
      "--uf-font-weight-bold",
      "--uf-radius",
      "--uf-radius-lg",
      "--uf-membrane",
      "--uf-spacing-1",
      "--uf-z-dropdown",
      "--uf-z-overlay",
      "--uf-duration-enter",
      "--uf-duration-exit",
      "--uf-ease-enter",
      "--uf-motion-duration-fast",
      "--uf-motion-ease-out",
      "--uf-color-fg",
      "--uf-color-fg-muted",
      "--uf-color-border",
      "--uf-color-hover-bg",
      "--uf-overlay-backdrop-bg",
      "--uf-overlay-backdrop-blur",
      "--uf-overlay-surface-bg",
      "--uf-overlay-surface-border",
      "--uf-overlay-surface-blur",
      "--uf-overlay-surface-shadow",
      "--uf-overlay-enter-y",
      "--uf-overlay-enter-scale"
    ],
    "notes": [
      "Select shares overlay tokens with responsive sheets and popovers; keep trigger and option geometry on control tokens.",
      "Trigger indicator is a selector-specific system icon and uses compact indicator spacing instead of generic button icon spacing.",
      "Option labels should render through Text-compatible label nodes rather than raw typography classes."
    ]
  },
  "platform": {
    "popover": true
  },
  "usage": {
    "whenToUse": [
      "Choosing one option from a predefined list",
      "Form field with enumerated values",
      "Multi-select for tags or categories"
    ],
    "whenNotToUse": [
      "Binary choice (use Switcher)",
      "2-3 visible options (use Radio or SegmentedControl)",
      "Free text input (use Input)"
    ],
    "alternatives": [
      "Radio",
      "SegmentedControl",
      "Switcher",
      "Command"
    ],
    "context": "both"
  }
}
