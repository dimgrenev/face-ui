{
  "schema": "face",
  "schema-version": 1,
  "name": "Bar",
  "description": "A row whose sections lay out from the start edge to the end edge, so a title, controls and actions share one line.",
  "props": {
    "children": {
      "type": "ReactNode",
      "required": false,
      "description": "Content and sections, rendered in the authored order."
    },
    "orientation": {
      "type": "enum",
      "required": false,
      "description": "Layout direction.",
      "options": [
        "horizontal",
        "vertical"
      ]
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "children": [
          {
            "__componentName__": "Text",
            "membrane": false,
            "children": "Workspace"
          },
          {
            "__componentName__": "Bar.Section",
            "children": [
              {
                "__componentName__": "Button",
                "icon": "link",
                "fullWidth": false,
                "children": "Share"
              }
            ],
            "align": "end"
          }
        ]
      }
    },
    {
      "name": "Horizontal",
      "props": {
        "orientation": "horizontal"
      }
    },
    {
      "name": "Vertical",
      "props": {
        "orientation": "vertical"
      }
    }
  ],
  "behavior": {},
  "keyboard": {},
  "aria": {
    "notes": "No implicit widget role. A caller opting into role=toolbar supplies its accessible name and focus-management behavior."
  },
  "composition": {
    "required": [
      "root"
    ],
    "recommended": [
      "section"
    ],
    "parts": {
      "root": {
        "slot": "root"
      },
      "section": {
        "slot": "section",
        "parent": "root"
      }
    }
  },
  "tokenMapping": {
    "component": [],
    "semanticFallbacks": [
      "--uf-control-height",
      "--uf-control-pad-y",
      "--uf-control-pad-text"
    ],
    "notes": [
      "Bar is a layout primitive and intentionally relies on shared control height and spacing.",
      "String/object slots are normalized through Text, Icon or Button rather than raw toolbar markup."
    ]
  },
  "platform": {},
  "usage": {
    "whenToUse": [
      "Top navigation bar",
      "Bottom action bar",
      "Toolbar with actions"
    ],
    "whenNotToUse": [
      "Side navigation (use Panel)",
      "Tab navigation (use Tabs)"
    ],
    "alternatives": [
      "Navigation",
      "Panel"
    ],
    "context": "app"
  }
}
