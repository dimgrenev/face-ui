{
  "name": "Drawer",
  "description": "Side-anchored overlay panel for persistent workflows",
  "props": {
    "side": {
      "type": "enum",
      "required": false,
      "description": "Side from which the drawer slides in.",
      "options": [
        "left",
        "right",
        "top",
        "bottom"
      ],
      "default": "right"
    },
    "title": {
      "type": "string",
      "required": false,
      "description": "Title content rendered inside the modal.",
      "default": "Drawer"
    },
    "className": {
      "type": "string",
      "required": false,
      "description": "Additional class name for the content element."
    },
    "children": {
      "type": "string",
      "required": false,
      "description": "Body content.",
      "default": "Drawer content"
    },
    "open": {
      "type": "boolean",
      "required": false,
      "description": "Controlled open state."
    },
    "closeOnOverlayClick": {
      "type": "boolean",
      "required": false,
      "description": "components API compatibility: overlay click behavior."
    },
    "closable": {
      "type": "boolean",
      "required": false,
      "description": "Whether the modal can be closed via Escape / backdrop click."
    },
    "description": {
      "type": "string",
      "required": false,
      "description": "Description content rendered below the title."
    },
    "actions": {
      "type": "array",
      "required": false,
      "description": "Optional footer actions."
    },
    "trigger": {
      "type": "string",
      "required": false,
      "description": "Trigger element that toggles the modal open.",
      "default": "Open drawer"
    },
    "width": {
      "type": "number",
      "required": false,
      "description": "Width in px for left/right variants."
    },
    "height": {
      "type": "number",
      "required": false,
      "description": "Height in px for top/bottom variants."
    },
    "onOpenChange": {
      "type": "function",
      "required": false,
      "description": "Called when the open state changes."
    },
    "surfaceBreakpoint": {
      "type": "number",
      "required": false,
      "description": "Breakpoint where auto surfaces switch to sheet mode."
    },
    "autoFocusOnOpen": {
      "type": "boolean",
      "required": false,
      "description": "Move focus into the modal when it opens. Disable for bounded previews that render open modals inline."
    },
    "portal": {
      "type": "boolean",
      "required": false,
      "description": "Render overlay into document.body. Disable for bounded component previews."
    },
    "backdropClassName": {
      "type": "string",
      "required": false,
      "description": "Additional class name for the backdrop element."
    },
    "positionerClassName": {
      "type": "string",
      "required": false,
      "description": "Additional class name for the positioner element."
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "open": true,
        "portal": false,
        "trigger": "Open drawer",
        "title": "Right drawer",
        "description": "Persistent side workflow surface.",
        "children": "Drawer content",
        "actions": [
          {
            "label": "Close",
            "variant": "outline"
          },
          {
            "label": "Apply",
            "variant": "accent"
          }
        ]
      }
    },
    {
      "name": "Left Side",
      "props": {
        "open": true,
        "portal": false,
        "side": "left",
        "trigger": "Open left drawer",
        "title": "Left drawer",
        "description": "Persistent side workflow surface.",
        "children": "Drawer content"
      }
    },
    {
      "name": "Bottom Sheet",
      "props": {
        "open": true,
        "portal": false,
        "side": "bottom",
        "trigger": "Open bottom sheet",
        "title": "Bottom sheet",
        "description": "Compact action surface.",
        "children": "Drawer content"
      }
    }
  ],
  "behavior": {
    "focusTrap": true,
    "scrollLock": true,
    "dismissOnEscape": true,
    "dismissOnClickOutside": true,
    "returnFocusOnClose": true,
    "autoFocusOnOpen": "first-focusable"
  },
  "keyboard": {
    "Escape": {
      "action": "close"
    },
    "Tab": {
      "action": "focusTrap",
      "scope": "drawer"
    }
  },
  "aria": {
    "role": "dialog",
    "modal": true,
    "labelledBy": "drawer-title",
    "describedBy": "drawer-description"
  },
  "composition": {
    "required": [
      "root",
      "overlay",
      "content"
    ],
    "recommended": [
      "title",
      "description",
      "close"
    ],
    "parts": {
      "root": {
        "slot": "root"
      },
      "overlay": {
        "slot": "overlay",
        "parent": "root"
      },
      "content": {
        "slot": "content",
        "parent": "root"
      },
      "title": {
        "slot": "title",
        "parent": "content"
      },
      "description": {
        "slot": "description",
        "parent": "content"
      },
      "close": {
        "slot": "close",
        "parent": "content"
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-modal-side-w-default",
      "--uf-modal-stack-h-default",
      "--uf-modal-side-enter-x",
      "--uf-modal-sheet-inset",
      "--uf-modal-sheet-gap",
      "--face-runtime-modal-w",
      "--face-runtime-modal-h"
    ],
    "semanticFallbacks": [
      "--uf-content-inset",
      "--uf-radius-lg",
      "--uf-color-fg",
      "--uf-color-fg-muted",
      "--uf-overlay-backdrop-bg",
      "--uf-overlay-backdrop-blur",
      "--uf-overlay-surface-bg",
      "--uf-overlay-surface-blur",
      "--uf-overlay-surface-shadow",
      "--uf-duration-enter",
      "--uf-duration-exit",
      "--uf-ease-enter",
      "--uf-z-modal"
    ],
    "notes": [
      "Drawer delegates to Modal with side-specific variant and inherits modal overlay tokens.",
      "Width and height props delegate to Modal private runtime custom properties while default sizing remains in the modal token namespace."
    ]
  },
  "platform": {
    "dialog": true,
    "inert": true
  },
  "usage": {
    "whenToUse": [
      "Side panel with detailed content",
      "Mobile navigation menu",
      "Filters panel"
    ],
    "whenNotToUse": [
      "Centered dialog (use Modal)",
      "Inline expandable (use Accordion)",
      "Quick tooltip info (use Popover)"
    ],
    "alternatives": [
      "Modal",
      "Panel",
      "Popover"
    ],
    "context": "app"
  }
}
