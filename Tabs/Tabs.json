{
  "schema": "face",
  "schema-version": 1,
  "name": "Tabs",
  "description": "Tabs that show one content panel at a time; header actions stay ordinary controls.",
  "props": {
    "value": {
      "type": "string",
      "required": false,
      "description": "Controlled selected key; a key missing from `items` shows the first enabled tab until it appears."
    },
    "defaultValue": {
      "type": "string",
      "required": false,
      "description": "Selected key on mount, else the first enabled tab; a key that `items` do not contain yet waits for them."
    },
    "orientation": {
      "type": "enum",
      "required": false,
      "description": "Axis of the tab list and of its arrow keys.",
      "options": [
        "horizontal",
        "vertical"
      ],
      "default": "horizontal"
    },
    "activationMode": {
      "type": "enum",
      "required": false,
      "description": "Automatic selects the tab an arrow key reaches; manual waits for a click, Space or Enter.",
      "options": [
        "automatic",
        "manual"
      ],
      "default": "automatic"
    },
    "disabled": {
      "type": "boolean",
      "required": false,
      "description": "Disables the tabs and header actions; the selected panel stays visible.",
      "default": false
    },
    "variant": {
      "type": "enum",
      "required": false,
      "description": "Pill background or an underline that follows the selected tab's geometry.",
      "options": [
        "pill",
        "underline"
      ],
      "default": "pill"
    },
    "wrap": {
      "type": "boolean",
      "required": false,
      "description": "Wraps the tab list instead of scrolling along its axis.",
      "default": false
    },
    "membrane": {
      "type": "boolean",
      "required": false,
      "description": "Shared outer spacing around each tab; toggling preserves DOM and focus.",
      "default": true
    },
    "actions": {
      "type": "ReactNode",
      "required": false,
      "description": "Header controls outside the tablist, such as New, Close selected or More."
    },
    "autoFocus": {
      "type": "boolean",
      "required": false,
      "description": "Focuses the selected enabled tab, else the first enabled one, once on mount.",
      "default": false
    },
    "aria-label": {
      "type": "string",
      "required": false,
      "description": "Accessible name of the tablist, not the generic outer wrapper."
    },
    "aria-labelledby": {
      "type": "string",
      "required": false,
      "description": "Visible heading IDs naming the tablist."
    },
    "aria-describedby": {
      "type": "string",
      "required": false,
      "description": "Additional description IDs for the tablist."
    },
    "renderPanels": {
      "type": "boolean",
      "required": false,
      "description": "Renders a persistent panel per tab; `false` leaves panels to the consumer, referenced by each item's `panelId`.",
      "default": true
    },
    "items": {
      "type": "array",
      "required": false,
      "description": "The tabs in order, keyed by `value`: label, icon, content, disabled, panelId and native naming (id, title, aria-*).",
      "default": []
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "orientation": "horizontal",
        "activationMode": "automatic",
        "disabled": false,
        "wrap": false,
        "membrane": true,
        "items": [
          {
            "value": "a",
            "label": "Tab A",
            "content": "Content A"
          },
          {
            "value": "b",
            "label": "Tab B",
            "content": "Content B"
          }
        ],
        "defaultValue": "a",
        "variant": "pill",
        "aria-label": "Sections"
      }
    },
    {
      "name": "Vertical",
      "props": {
        "items": [
          {
            "value": "overview",
            "label": "Overview",
            "content": "Overview content"
          },
          {
            "value": "details",
            "label": "Details",
            "content": "Details content"
          },
          {
            "value": "activity",
            "label": "Activity",
            "content": "Activity content"
          }
        ],
        "defaultValue": "overview",
        "orientation": "vertical",
        "aria-label": "Sections"
      }
    },
    {
      "name": "Manual Activation",
      "props": {
        "items": [
          {
            "value": "overview",
            "label": "Overview",
            "content": "Overview content"
          },
          {
            "value": "details",
            "label": "Details",
            "content": "Details content"
          },
          {
            "value": "activity",
            "label": "Activity",
            "content": "Activity content"
          }
        ],
        "defaultValue": "overview",
        "activationMode": "manual",
        "aria-label": "Sections"
      }
    },
    {
      "name": "Disabled",
      "props": {
        "items": [
          {
            "value": "overview",
            "label": "Overview",
            "content": "Overview content"
          },
          {
            "value": "details",
            "label": "Details",
            "content": "Details content"
          },
          {
            "value": "activity",
            "label": "Activity",
            "content": "Activity content"
          }
        ],
        "defaultValue": "overview",
        "disabled": true,
        "aria-label": "Sections"
      }
    }
  ],
  "behavior": {
    "rovingFocus": true,
    "autoFocusOnOpen": "none"
  },
  "keyboard": {
    "ArrowRight": {
      "action": "focusNext",
      "condition": "horizontal"
    },
    "ArrowLeft": {
      "action": "focusPrevious",
      "condition": "horizontal"
    },
    "ArrowDown": {
      "action": "focusNext",
      "condition": "vertical"
    },
    "ArrowUp": {
      "action": "focusPrevious",
      "condition": "vertical"
    },
    "Home": {
      "action": "focusFirst"
    },
    "End": {
      "action": "focusLast"
    },
    "Enter": {
      "action": "activate",
      "condition": "manual"
    },
    "Space": {
      "action": "activate",
      "condition": "manual"
    }
  },
  "aria": {
    "role": "tablist",
    "required": [
      "aria-orientation"
    ]
  },
  "composition": {
    "required": [
      "root",
      "list",
      "trigger",
      "content"
    ],
    "recommended": [],
    "parts": {
      "root": {
        "slot": "root"
      },
      "list": {
        "slot": "list",
        "parent": "root"
      },
      "trigger": {
        "slot": "trigger",
        "parent": "list",
        "multiple": true
      },
      "content": {
        "slot": "content",
        "parent": "root",
        "multiple": true
      }
    }
  },
  "tokenMapping": {
    "component": [],
    "semanticFallbacks": [
      "--uf-control-height",
      "--uf-control-gap",
      "--uf-control-pad-y",
      "--uf-control-pad-text",
      "--uf-radius-full",
      "--uf-border-width-base",
      "--uf-icon-size-sm",
      "--uf-membrane",
      "--uf-color-fg",
      "--uf-color-fg-muted",
      "--uf-color-hover-bg",
      "--uf-color-ring",
      "--uf-duration-enter",
      "--uf-ease-enter"
    ],
    "notes": [
      "Tab labels are plain slot content inside the native tab button; primitive panel content renders through Text.",
      "The underline indicator is the selected slot border (--uf-border-width-base, --uf-color-fg); forced colors switch the selected tab to Highlight/HighlightText."
    ]
  },
  "platform": {},
  "usage": {
    "whenToUse": [
      "Switching between content panels in same view",
      "Organizing settings into categories",
      "Tabbed navigation within a section"
    ],
    "whenNotToUse": [
      "Single toggle between two states (use SegmentedControl)",
      "Selecting a value for a form (use Select or Radio)",
      "Top-level page navigation (use Navigation)"
    ],
    "alternatives": [
      "SegmentedControl",
      "Accordion",
      "Navigation"
    ],
    "context": "both"
  }
}
