{
  "schema": "face",
  "schema-version": 1,
  "name": "Tabs",
  "description": "Tabbed navigation with content panels",
  "props": {
    "items": {
      "type": "array",
      "required": false,
      "description": "Tab definitions. Each item supports value, label, content, disabled, panelId, leadingIcon, trailingIcon, and an optional overlay action via actionIcon, actionLabel, actionVisibility, actionPosition, and onAction."
    },
    "value": {
      "type": "string",
      "required": false,
      "description": "Currently selected tab value."
    },
    "defaultValue": {
      "type": "string",
      "required": false,
      "description": "Uncontrolled initial tab value."
    },
    "orientation": {
      "type": "enum",
      "required": false,
      "description": "Orientation of the tab list.",
      "options": [
        "horizontal",
        "vertical"
      ],
      "default": "horizontal"
    },
    "activationMode": {
      "type": "enum",
      "required": false,
      "description": "Activation mode: automatic selects on focus, manual requires click/Enter.",
      "options": [
        "automatic",
        "manual"
      ],
      "default": "automatic"
    },
    "disabled": {
      "type": "boolean",
      "required": false,
      "description": "Disable the entire tab group.",
      "default": false
    },
    "withLine": {
      "type": "boolean",
      "required": false,
      "description": "Render the active-tab indicator line.",
      "default": false
    },
    "wrap": {
      "type": "boolean",
      "required": false,
      "description": "Allow tab triggers to wrap onto multiple rows.",
      "default": false
    },
    "membrane": {
      "type": "boolean",
      "required": false,
      "description": "Outer membrane wrapper around each tab trigger.",
      "default": true
    },
    "renderPanels": {
      "type": "boolean",
      "required": false,
      "description": "Render internal content panels. Set false when panels are rendered outside Tabs.",
      "default": true
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "orientation": "horizontal",
        "activationMode": "automatic",
        "disabled": false,
        "withLine": false,
        "wrap": false,
        "membrane": true,
        "items": [
          {
            "value": "a",
            "label": "Tab A",
            "content": "Content A"
          },
          {
            "value": "b",
            "label": "Tab B",
            "content": "Content B"
          }
        ],
        "defaultValue": "a"
      }
    },
    {
      "name": "Vertical",
      "props": {
        "items": [
          {
            "value": "overview",
            "label": "Overview",
            "content": "Overview content"
          },
          {
            "value": "details",
            "label": "Details",
            "content": "Details content"
          },
          {
            "value": "activity",
            "label": "Activity",
            "content": "Activity content"
          }
        ],
        "defaultValue": "overview",
        "orientation": "vertical"
      }
    },
    {
      "name": "Manual Activation",
      "props": {
        "items": [
          {
            "value": "overview",
            "label": "Overview",
            "content": "Overview content"
          },
          {
            "value": "details",
            "label": "Details",
            "content": "Details content"
          },
          {
            "value": "activity",
            "label": "Activity",
            "content": "Activity content"
          }
        ],
        "defaultValue": "overview",
        "activationMode": "manual"
      }
    },
    {
      "name": "Disabled",
      "props": {
        "items": [
          {
            "value": "overview",
            "label": "Overview",
            "content": "Overview content"
          },
          {
            "value": "details",
            "label": "Details",
            "content": "Details content"
          },
          {
            "value": "activity",
            "label": "Activity",
            "content": "Activity content"
          }
        ],
        "defaultValue": "overview",
        "disabled": true
      }
    }
  ],
  "behavior": {
    "rovingFocus": true,
    "autoFocusOnOpen": "none"
  },
  "keyboard": {
    "ArrowRight": {
      "action": "focusNext",
      "condition": "horizontal"
    },
    "ArrowLeft": {
      "action": "focusPrevious",
      "condition": "horizontal"
    },
    "ArrowDown": {
      "action": "focusNext",
      "condition": "vertical"
    },
    "ArrowUp": {
      "action": "focusPrevious",
      "condition": "vertical"
    },
    "Home": {
      "action": "focusFirst"
    },
    "End": {
      "action": "focusLast"
    },
    "Enter": {
      "action": "activate",
      "condition": "manual"
    },
    "Space": {
      "action": "activate",
      "condition": "manual"
    }
  },
  "aria": {
    "role": "tablist",
    "required": [
      "aria-orientation"
    ]
  },
  "composition": {
    "required": [
      "root",
      "list",
      "trigger",
      "content"
    ],
    "recommended": [],
    "parts": {
      "root": {
        "slot": "root"
      },
      "list": {
        "slot": "list",
        "parent": "root"
      },
      "trigger": {
        "slot": "trigger",
        "parent": "list",
        "multiple": true
      },
      "content": {
        "slot": "content",
        "parent": "root",
        "multiple": true
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-tabs-rail-h",
      "--uf-tabs-indicator-h",
      "--uf-tabs-line-gap"
    ],
    "semanticFallbacks": [
      "--uf-control-height",
      "--uf-control-pad-y",
      "--uf-control-pad-text",
      "--uf-radius-full",
      "--uf-membrane",
      "--uf-font-weight-bold",
      "--uf-color-fg",
      "--uf-color-fg-muted",
      "--uf-color-hover-bg",
      "--uf-color-border",
      "--uf-motion-duration-fast",
      "--uf-motion-duration-control",
      "--uf-motion-ease-standard"
    ],
    "notes": [
      "Tab labels render through Text when they are primitive strings; custom labels must preserve tab semantics.",
      "Line indicator styling stays tokenized through tabs variables, and trigger/indicator motion uses shared Face UI motion tokens."
    ]
  },
  "platform": {},
  "usage": {
    "whenToUse": [
      "Switching between content panels in same view",
      "Organizing settings into categories",
      "Tabbed navigation within a section"
    ],
    "whenNotToUse": [
      "Single toggle between two states (use SegmentedControl)",
      "Selecting a value for a form (use Select or Radio)",
      "Top-level page navigation (use Navigation)"
    ],
    "alternatives": [
      "SegmentedControl",
      "Accordion",
      "Navigation"
    ],
    "context": "both"
  }
}
