{
  "schema": "face",
  "schema-version": 1,
  "name": "Tabs",
  "description": "Tabbed navigation with content panels",
  "props": {
    "value": {
      "type": "string",
      "required": false,
      "description": "Controlled selected key. Unknown keys show no panel until they exist."
    },
    "defaultValue": {
      "type": "string",
      "required": false,
      "description": "Mount-only selected key. Otherwise use the first enabled tab."
    },
    "orientation": {
      "type": "enum",
      "required": false,
      "description": "Axis of keyboard navigation and the tab list.",
      "options": [
        "horizontal",
        "vertical"
      ],
      "default": "horizontal"
    },
    "activationMode": {
      "type": "enum",
      "required": false,
      "description": "Automatic activates on focus; manual requires a click, Space or Enter.",
      "options": [
        "automatic",
        "manual"
      ],
      "default": "automatic"
    },
    "disabled": {
      "type": "boolean",
      "required": false,
      "description": "Disable tab navigation and header actions, retaining the visible panel.",
      "default": false
    },
    "variant": {
      "type": "enum",
      "required": false,
      "description": "Pill background or an underline that follows the selected tab's geometry.",
      "options": [
        "pill",
        "underline"
      ],
      "default": "pill"
    },
    "wrap": {
      "type": "boolean",
      "required": false,
      "description": "Wrap the tab list instead of scrolling along its axis.",
      "default": false
    },
    "membrane": {
      "type": "boolean",
      "required": false,
      "description": "Shared outer spacing around each tab; toggling preserves DOM and focus.",
      "default": true
    },
    "actions": {
      "type": "ReactNode",
      "required": false,
      "description": "Header controls outside tablist, such as New, Close selected, or More."
    },
    "autoFocus": {
      "type": "boolean",
      "required": false,
      "description": "Focus the selected enabled tab, or first enabled tab, once on mount.",
      "default": false
    },
    "aria-label": {
      "type": "string",
      "required": false,
      "description": "Accessible name of the tablist, not the generic outer wrapper."
    },
    "aria-labelledby": {
      "type": "string",
      "required": false,
      "description": "Visible heading IDs naming the tablist."
    },
    "aria-describedby": {
      "type": "string",
      "required": false,
      "description": "Additional description IDs for the tablist."
    },
    "renderPanels": {
      "type": "boolean",
      "required": false,
      "description": "Render persistent internal panels.",
      "default": true
    },
    "items": {
      "type": "array",
      "required": false,
      "description": "Tab definitions. Each item supports value, label, content, disabled, panelId, leadingIcon, trailingIcon, and an optional overlay action via actionIcon, actionLabel, actionVisibility, actionPosition, and onAction.",
      "default": []
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "orientation": "horizontal",
        "activationMode": "automatic",
        "disabled": false,
        "wrap": false,
        "membrane": true,
        "items": [
          {
            "value": "a",
            "label": "Tab A",
            "content": "Content A"
          },
          {
            "value": "b",
            "label": "Tab B",
            "content": "Content B"
          }
        ],
        "defaultValue": "a",
        "variant": "pill",
        "aria-label": "Sections"
      }
    },
    {
      "name": "Vertical",
      "props": {
        "items": [
          {
            "value": "overview",
            "label": "Overview",
            "content": "Overview content"
          },
          {
            "value": "details",
            "label": "Details",
            "content": "Details content"
          },
          {
            "value": "activity",
            "label": "Activity",
            "content": "Activity content"
          }
        ],
        "defaultValue": "overview",
        "orientation": "vertical",
        "aria-label": "Sections"
      }
    },
    {
      "name": "Manual Activation",
      "props": {
        "items": [
          {
            "value": "overview",
            "label": "Overview",
            "content": "Overview content"
          },
          {
            "value": "details",
            "label": "Details",
            "content": "Details content"
          },
          {
            "value": "activity",
            "label": "Activity",
            "content": "Activity content"
          }
        ],
        "defaultValue": "overview",
        "activationMode": "manual",
        "aria-label": "Sections"
      }
    },
    {
      "name": "Disabled",
      "props": {
        "items": [
          {
            "value": "overview",
            "label": "Overview",
            "content": "Overview content"
          },
          {
            "value": "details",
            "label": "Details",
            "content": "Details content"
          },
          {
            "value": "activity",
            "label": "Activity",
            "content": "Activity content"
          }
        ],
        "defaultValue": "overview",
        "disabled": true,
        "aria-label": "Sections"
      }
    }
  ],
  "behavior": {
    "rovingFocus": true,
    "autoFocusOnOpen": "none"
  },
  "keyboard": {
    "ArrowRight": {
      "action": "focusNext",
      "condition": "horizontal"
    },
    "ArrowLeft": {
      "action": "focusPrevious",
      "condition": "horizontal"
    },
    "ArrowDown": {
      "action": "focusNext",
      "condition": "vertical"
    },
    "ArrowUp": {
      "action": "focusPrevious",
      "condition": "vertical"
    },
    "Home": {
      "action": "focusFirst"
    },
    "End": {
      "action": "focusLast"
    },
    "Enter": {
      "action": "activate",
      "condition": "manual"
    },
    "Space": {
      "action": "activate",
      "condition": "manual"
    }
  },
  "aria": {
    "role": "tablist",
    "required": [
      "aria-orientation"
    ]
  },
  "composition": {
    "required": [
      "root",
      "list",
      "trigger",
      "content"
    ],
    "recommended": [],
    "parts": {
      "root": {
        "slot": "root"
      },
      "list": {
        "slot": "list",
        "parent": "root"
      },
      "trigger": {
        "slot": "trigger",
        "parent": "list",
        "multiple": true
      },
      "content": {
        "slot": "content",
        "parent": "root",
        "multiple": true
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-tabs-rail-h",
      "--uf-tabs-indicator-h",
      "--uf-tabs-line-gap"
    ],
    "semanticFallbacks": [
      "--uf-control-height",
      "--uf-control-pad-y",
      "--uf-control-pad-text",
      "--uf-radius-full",
      "--uf-membrane",
      "--uf-font-weight-bold",
      "--uf-color-fg",
      "--uf-color-fg-muted",
      "--uf-color-hover-bg",
      "--uf-color-border",
      "--uf-motion-duration-fast",
      "--uf-motion-duration-control",
      "--uf-motion-ease-standard"
    ],
    "notes": [
      "Tab labels render through Text when they are primitive strings; custom labels must preserve tab semantics.",
      "Line indicator styling stays tokenized through tabs variables, and trigger/indicator motion uses shared Face UI motion tokens."
    ]
  },
  "platform": {},
  "usage": {
    "whenToUse": [
      "Switching between content panels in same view",
      "Organizing settings into categories",
      "Tabbed navigation within a section"
    ],
    "whenNotToUse": [
      "Single toggle between two states (use SegmentedControl)",
      "Selecting a value for a form (use Select or Radio)",
      "Top-level page navigation (use Navigation)"
    ],
    "alternatives": [
      "SegmentedControl",
      "Accordion",
      "Navigation"
    ],
    "context": "both"
  }
}
