{
  "schema": "face",
  "schema-version": 1,
  "name": "Popover",
  "description": "Floating interactive surface anchored to a trigger element",
  "props": {
    "interactive": {
      "type": "boolean",
      "required": false,
      "description": "Whether the popover content is interactive (focusable).",
      "default": true
    },
    "content": {
      "type": "string",
      "required": false,
      "description": "Content rendered inside the floating surface."
    },
    "className": {
      "type": "string",
      "required": false,
      "description": "Additional class name for the content element."
    },
    "children": {
      "type": "string",
      "required": false,
      "description": "Trigger element (the anchor)."
    },
    "open": {
      "type": "boolean",
      "required": false,
      "description": "Controlled open state."
    },
    "openDelay": {
      "type": "number",
      "required": false,
      "description": "Delay before opening (ms)."
    },
    "closeDelay": {
      "type": "number",
      "required": false,
      "description": "Delay before closing (ms)."
    },
    "side": {
      "type": "enum",
      "required": false,
      "description": "Preferred side placement.",
      "options": [
        "top",
        "right",
        "bottom",
        "left"
      ]
    },
    "align": {
      "type": "enum",
      "required": false,
      "description": "Alignment along the side.",
      "options": [
        "start",
        "center",
        "end"
      ]
    },
    "sideOffset": {
      "type": "number",
      "required": false,
      "description": "Offset from the trigger along the side axis (px)."
    },
    "onOpenChange": {
      "type": "function",
      "required": false,
      "description": "Called when the open state changes."
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "interactive": true,
        "children": "Open popover",
        "content": "Popover content"
      }
    },
    {
      "name": "Non-Interactive",
      "props": {
        "interactive": false,
        "children": "Hover me",
        "content": "Info tooltip-like"
      }
    }
  ],
  "behavior": {
    "dismissOnEscape": true,
    "dismissOnClickOutside": true,
    "returnFocusOnClose": false,
    "autoFocusOnOpen": "none"
  },
  "keyboard": {
    "Escape": {
      "action": "close"
    }
  },
  "aria": {
    "notes": [
      "The trigger exposes aria-expanded reflecting the open/closed state.",
      "No ARIA role is set on the floating content in the click (popover) variant; supply aria-label or aria-labelledby on the popover to give the content an accessible name when needed."
    ]
  },
  "composition": {
    "required": [
      "trigger",
      "content"
    ],
    "recommended": [
      "arrow"
    ],
    "parts": {
      "trigger": {
        "slot": "trigger"
      },
      "content": {
        "slot": "content"
      },
      "arrow": {
        "slot": "arrow",
        "parent": "content"
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-overlay-content-max-w",
      "--uf-overlay-content-border-width"
    ],
    "semanticFallbacks": [
      "--uf-spacing-2",
      "--uf-spacing-3",
      "--uf-radius",
      "--uf-membrane",
      "--uf-z-overlay",
      "--uf-duration-enter",
      "--uf-duration-exit",
      "--uf-ease-enter",
      "--uf-font-size-sm",
      "--uf-font-weight",
      "--uf-overlay-surface-bg",
      "--uf-overlay-surface-border",
      "--uf-overlay-surface-blur",
      "--uf-overlay-enter-y",
      "--uf-overlay-enter-scale"
    ],
    "notes": [
      "Popover is the interactive click variant of Overlay and inherits Overlay positioning and surface tokens.",
      "Use Modal for blocking focus-trapped decisions rather than expanding Popover styling."
    ]
  },
  "platform": {
    "popover": true,
    "anchorPositioning": true
  },
  "usage": {
    "whenToUse": [
      "Additional info on hover/click",
      "Mini forms or filters",
      "Rich tooltip content"
    ],
    "whenNotToUse": [
      "Full dialog (use Modal)",
      "Simple text hint (use Tooltip)",
      "Side panel (use Drawer)"
    ],
    "alternatives": [
      "Tooltip",
      "Modal",
      "Drawer"
    ],
    "context": "app"
  }
}
