{
  "schema": "face",
  "schema-version": 1,
  "name": "Tree",
  "description": "Nested items that expand and collapse, with one item selected.",
  "props": {
    "items": {
      "type": "array",
      "required": false,
      "description": "Items in order, nested through `items`; an item repeating a value used anywhere earlier in the tree is dropped."
    },
    "value": {
      "type": "string",
      "required": false,
      "description": "Value of the selected item (controlled); `null` selects nothing, as does a value no item has."
    },
    "defaultValue": {
      "type": "string",
      "required": false,
      "description": "Value of the item selected on mount (uncontrolled); later changes are ignored."
    },
    "expanded": {
      "type": "array",
      "required": false,
      "description": "Values of the expanded items (controlled); values of items that are not branches are kept but show nothing."
    },
    "defaultExpanded": {
      "type": "array",
      "required": false,
      "description": "Values of the items expanded on mount (uncontrolled); later changes are ignored."
    },
    "variant": {
      "type": "enum",
      "required": false,
      "description": "`lines` draws a guide line along the nested items of every expanded item; `default` draws none.",
      "options": [
        "default",
        "lines"
      ],
      "default": "default"
    },
    "aria-label": {
      "type": "string",
      "required": false,
      "description": "Names the tree; without it and `aria-labelledby` the name is \"Tree\"."
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "aria-label": "Files",
        "items": [
          {
            "value": "src",
            "label": "src",
            "icon": "folder",
            "items": [
              {
                "value": "components",
                "label": "components",
                "icon": "folder",
                "items": [
                  {
                    "value": "button",
                    "label": "Button.tsx",
                    "icon": "file"
                  },
                  {
                    "value": "tile",
                    "label": "Tile.tsx",
                    "icon": "file"
                  }
                ]
              },
              {
                "value": "assets",
                "label": "assets",
                "icon": "folder",
                "items": [
                  {
                    "value": "icons",
                    "label": "icons",
                    "icon": "folder",
                    "items": [
                      {
                        "value": "search-icon",
                        "label": "search.svg",
                        "icon": "file"
                      },
                      {
                        "value": "folder-icon",
                        "label": "folder.svg",
                        "icon": "file"
                      }
                    ]
                  }
                ]
              },
              {
                "value": "index",
                "label": "index.ts",
                "icon": "file"
              }
            ]
          },
          {
            "value": "readme",
            "label": "README.md",
            "icon": "file"
          }
        ],
        "defaultExpanded": [
          "src",
          "components",
          "assets",
          "icons"
        ],
        "defaultValue": "button"
      }
    },
    {
      "name": "Guide Lines",
      "props": {
        "aria-label": "Workspace",
        "variant": "lines",
        "items": [
          {
            "value": "workspace",
            "label": "Workspace",
            "icon": "folder",
            "items": [
              {
                "value": "overview",
                "label": "Overview",
                "icon": "file"
              },
              {
                "value": "settings",
                "label": "Settings",
                "icon": "settings",
                "meta": "3"
              },
              {
                "value": "tokens",
                "label": "Tokens",
                "icon": "theme",
                "disabled": true
              }
            ]
          }
        ],
        "defaultExpanded": [
          "workspace"
        ],
        "defaultValue": "overview"
      }
    }
  ],
  "behavior": {
    "rovingFocus": true,
    "typeahead": true,
    "selectionFollowsFocus": false,
    "activation": "click, Enter and Space select the item and toggle a branch; a click on the arrow only toggles",
    "disabled": "a disabled item and everything nested in it are skipped, never selected or expanded"
  },
  "keyboard": {
    "ArrowDown": {
      "action": "focusNextVisible"
    },
    "ArrowUp": {
      "action": "focusPreviousVisible"
    },
    "ArrowRight": {
      "action": "expandOrFocusFirstChild",
      "rtl": "ArrowLeft"
    },
    "ArrowLeft": {
      "action": "collapseOrFocusParent",
      "rtl": "ArrowRight"
    },
    "Home": {
      "action": "focusFirst"
    },
    "End": {
      "action": "focusLast"
    },
    "Enter": {
      "action": "selectAndToggle"
    },
    "Space": {
      "action": "selectAndToggle"
    },
    "*": {
      "action": "expandSiblings"
    },
    "printable": {
      "action": "typeahead"
    }
  },
  "aria": {
    "role": "tree",
    "defaultName": "Tree"
  },
  "composition": {
    "required": [
      "root",
      "item"
    ],
    "recommended": [
      "indicator",
      "label",
      "group"
    ],
    "parts": {
      "root": {
        "slot": "root"
      },
      "item": {
        "slot": "item",
        "parent": "root",
        "multiple": true
      },
      "indicator": {
        "slot": "indicator",
        "parent": "item"
      },
      "icon": {
        "slot": "icon",
        "parent": "item"
      },
      "label": {
        "slot": "label",
        "parent": "item"
      },
      "meta": {
        "slot": "meta",
        "parent": "item"
      },
      "group": {
        "slot": "group",
        "parent": "root",
        "multiple": true
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-tree-branch-indicator-size"
    ],
    "semanticFallbacks": [
      "--uf-control-height",
      "--uf-control-pad-icon",
      "--uf-control-pad-text",
      "--uf-option-indent",
      "--uf-membrane",
      "--uf-radius",
      "--uf-font-weight-bold",
      "--uf-color-hover-bg",
      "--uf-color-active-bg",
      "--uf-color-fg-muted",
      "--uf-color-border",
      "--uf-motion-duration-control",
      "--uf-motion-ease-standard"
    ],
    "notes": [
      "Rows reuse the option anatomy; each level indents by --uf-option-indent, so a child's arrow sits under its parent's icon.",
      "The branch arrow slot is --uf-tree-branch-indicator-size wide on every row, leaves included, so labels align."
    ]
  },
  "platform": {},
  "usage": {
    "whenToUse": [
      "File system browser",
      "Hierarchical data display",
      "Nested category navigation"
    ],
    "whenNotToUse": [
      "Flat list (use Table)",
      "Site or app navigation links (use Navigation)",
      "Rows with their own controls (use Table)"
    ],
    "alternatives": [
      "Table",
      "Navigation",
      "Accordion"
    ],
    "context": "app"
  }
}
