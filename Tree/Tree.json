{
  "schema": "face",
  "schema-version": 1,
  "name": "Tree",
  "description": "Hierarchical tree view with expand/collapse and selection",
  "props": {
    "items": {
      "type": "array",
      "required": false,
      "description": "Recursive tree nodes. Nodes may use kind \"button\", \"tile\", or \"custom\", plus icon, rightText, actions, content, or render."
    },
    "expandedIds": {
      "type": "array",
      "required": false,
      "description": "Currently expanded node IDs."
    },
    "defaultExpandedIds": {
      "type": "array",
      "required": false,
      "description": "Uncontrolled initial expanded node IDs."
    },
    "selectedId": {
      "type": "string",
      "required": false,
      "description": "Currently selected node ID."
    },
    "defaultSelectedId": {
      "type": "string",
      "required": false,
      "description": "Uncontrolled initial selected node ID."
    },
    "onExpandedChange": {
      "type": "function",
      "required": false,
      "description": "Callback when expanded nodes change."
    },
    "onSelectedChange": {
      "type": "function",
      "required": false,
      "description": "Callback when selected node changes."
    },
    "renderNode": {
      "type": "function",
      "required": false,
      "description": "Global render override for custom node bodies. Tree still owns nesting, expansion, focus, and selection."
    },
    "className": {
      "type": "string",
      "required": false,
      "description": "Additional class name on the root element."
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "items": [
          {
            "id": "src",
            "label": "src",
            "icon": "folder",
            "children": [
              {
                "id": "components",
                "label": "components",
                "icon": "folder",
                "children": [
                  {
                    "id": "button",
                    "label": "Button.tsx",
                    "icon": "file"
                  },
                  {
                    "id": "tile",
                    "label": "Tile.tsx",
                    "icon": "file",
                    "kind": "tile"
                  }
                ]
              },
              {
                "id": "assets",
                "label": "assets",
                "icon": "folder",
                "children": [
                  {
                    "id": "icons",
                    "label": "icons",
                    "icon": "folder",
                    "children": [
                      {
                        "id": "search-icon",
                        "label": "search.svg",
                        "icon": "file"
                      },
                      {
                        "id": "folder-icon",
                        "label": "folder.svg",
                        "icon": "file"
                      }
                    ]
                  }
                ]
              },
              {
                "id": "index",
                "label": "index.ts",
                "icon": "file"
              }
            ]
          },
          {
            "id": "readme",
            "label": "README.md",
            "icon": "file"
          }
        ],
        "defaultExpandedIds": [
          "src",
          "components",
          "assets",
          "icons"
        ],
        "defaultSelectedId": "button"
      }
    },
    {
      "name": "Mixed Rows",
      "props": {
        "items": [
          {
            "id": "workspace",
            "label": "Workspace",
            "icon": "folder",
            "kind": "tile",
            "children": [
              {
                "id": "overview",
                "label": "Overview",
                "icon": "file",
                "kind": "tile"
              },
              {
                "id": "settings",
                "label": "Settings",
                "icon": "settings",
                "rightText": "3"
              },
              {
                "id": "tokens",
                "label": "Tokens",
                "icon": "theme"
              }
            ]
          }
        ],
        "defaultExpandedIds": [
          "workspace"
        ],
        "defaultSelectedId": "overview"
      }
    }
  ],
  "behavior": {
    "rovingFocus": true,
    "typeahead": true,
    "autoFocusOnOpen": "none"
  },
  "keyboard": {
    "ArrowDown": {
      "action": "focusNextVisible"
    },
    "ArrowUp": {
      "action": "focusPreviousVisible"
    },
    "ArrowRight": {
      "action": "expandOrFocusChild"
    },
    "ArrowLeft": {
      "action": "collapseOrFocusParent"
    },
    "Home": {
      "action": "focusFirst"
    },
    "End": {
      "action": "focusLast"
    },
    "Enter": {
      "action": "select"
    },
    "Space": {
      "action": "select"
    },
    "*": {
      "action": "expandAllSiblings"
    }
  },
  "aria": {
    "role": "tree",
    "required": [
      "aria-label"
    ]
  },
  "composition": {
    "required": [
      "root",
      "branch",
      "item"
    ],
    "recommended": [
      "itemIndicator",
      "itemText"
    ],
    "parts": {
      "root": {
        "slot": "root"
      },
      "branch": {
        "slot": "branch",
        "parent": "root",
        "multiple": true
      },
      "item": {
        "slot": "item",
        "parent": "branch",
        "multiple": true
      },
      "itemIndicator": {
        "slot": "itemIndicator",
        "parent": "item"
      },
      "itemText": {
        "slot": "itemText",
        "parent": "item"
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-tree-branch-indicator-size"
    ],
    "semanticFallbacks": [
      "--uf-control-height",
      "--uf-control-pad-y",
      "--uf-control-pad-text",
      "--uf-control-gap",
      "--uf-radius",
      "--uf-font-size-sm",
      "--uf-font-weight-bold",
      "--uf-color-fg",
      "--uf-color-hover-bg"
    ],
    "notes": [
      "Tree node rows use Button-compatible geometry; branch indicators use a tree-local size alias.",
      "Expansion/selection state is machine-owned and should not leak styling outside tree data parts."
    ]
  },
  "platform": {},
  "usage": {
    "whenToUse": [
      "File system browser",
      "Hierarchical data display",
      "Nested category navigation"
    ],
    "whenNotToUse": [
      "Flat list (use Table)",
      "Simple nav (use Navigation)"
    ],
    "alternatives": [
      "Table",
      "Navigation",
      "Accordion"
    ],
    "context": "app"
  }
}
