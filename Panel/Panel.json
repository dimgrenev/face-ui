{
  "schema": "face",
  "schema-version": 1,
  "name": "Panel",
  "description": "Collapsible panel navigation with nested groups",
  "props": {
    "items": {
      "type": "array",
      "required": false,
      "description": "Panel item definitions (supports nested groups)."
    },
    "collapsed": {
      "type": "boolean",
      "required": false,
      "description": "Whether the panel is collapsed."
    },
    "defaultCollapsed": {
      "type": "boolean",
      "required": false,
      "description": "Uncontrolled initial collapsed state.",
      "default": false
    },
    "selectedId": {
      "type": "string",
      "required": false,
      "description": "Currently selected item ID."
    },
    "defaultSelectedId": {
      "type": "string",
      "required": false,
      "description": "Uncontrolled initial selected item ID."
    },
    "width": {
      "type": "any",
      "required": false,
      "description": "Width when expanded.",
      "default": 260
    },
    "collapsedWidth": {
      "type": "any",
      "required": false,
      "description": "Width when collapsed.",
      "default": 60
    },
    "surface": {
      "type": "enum",
      "required": false,
      "description": "Surface behavior on compact viewports.",
      "options": [
        "auto",
        "inline",
        "sheet"
      ],
      "default": "auto"
    },
    "surfaceBreakpoint": {
      "type": "number",
      "required": false,
      "description": "Breakpoint where auto surfaces switch to sheet mode."
    },
    "open": {
      "type": "boolean",
      "required": false,
      "description": "Controlled drawer state for sheet mode."
    },
    "defaultOpen": {
      "type": "boolean",
      "required": false,
      "description": "Uncontrolled initial drawer state for sheet mode.",
      "default": false
    },
    "trigger": {
      "type": "ReactNode",
      "required": false,
      "description": "Optional trigger for sheet mode."
    },
    "surfaceTitle": {
      "type": "ReactNode",
      "required": false,
      "description": "Optional title used in compact sheet header."
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "items": [
          {
            "id": "overview",
            "label": "Overview",
            "icon": "layout-sidebar-left-open"
          },
          {
            "id": "projects",
            "label": "Projects",
            "icon": "folder"
          },
          {
            "id": "automations",
            "label": "Automations",
            "icon": "component"
          },
          {
            "id": "settings",
            "label": "Settings",
            "icon": "settings"
          }
        ],
        "defaultSelectedId": "overview",
        "surface": "inline",
        "width": 260
      }
    },
    {
      "name": "Collapsed",
      "props": {
        "items": [
          {
            "id": "overview",
            "label": "Overview",
            "icon": "layout-sidebar-left-open"
          },
          {
            "id": "projects",
            "label": "Projects",
            "icon": "folder"
          },
          {
            "id": "automations",
            "label": "Automations",
            "icon": "component"
          },
          {
            "id": "settings",
            "label": "Settings",
            "icon": "settings"
          }
        ],
        "defaultSelectedId": "projects",
        "surface": "inline",
        "defaultCollapsed": true
      }
    },
    {
      "name": "Compact overlay",
      "props": {
        "items": [
          {
            "id": "overview",
            "label": "Overview",
            "icon": "layout-sidebar-left-open"
          },
          {
            "id": "projects",
            "label": "Projects",
            "icon": "folder"
          },
          {
            "id": "automations",
            "label": "Automations",
            "icon": "component"
          },
          {
            "id": "settings",
            "label": "Settings",
            "icon": "settings"
          }
        ],
        "defaultSelectedId": "automations",
        "surface": "sheet",
        "defaultOpen": true,
        "surfaceTitle": "Workspace"
      }
    }
  ],
  "behavior": {},
  "keyboard": {},
  "aria": {
    "role": "complementary",
    "required": [
      "aria-label"
    ]
  },
  "composition": {
    "required": [
      "root"
    ],
    "recommended": [
      "header",
      "content",
      "footer",
      "collapseButton"
    ],
    "parts": {
      "root": {
        "slot": "root"
      },
      "header": {
        "slot": "header",
        "parent": "root"
      },
      "content": {
        "slot": "content",
        "parent": "root"
      },
      "footer": {
        "slot": "footer",
        "parent": "root"
      },
      "collapseButton": {
        "slot": "collapseButton",
        "parent": "header"
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-sidebar-bg",
      "--uf-sidebar-fg",
      "--uf-sidebar-muted",
      "--uf-sidebar-hover-bg",
      "--uf-sidebar-active-bg",
      "--uf-sidebar-row-radius",
      "--uf-sidebar-section-gap",
      "--face-runtime-sidebar-sheet-w",
      "--uf-sidebar-sheet-w-default",
      "--uf-sidebar-sheet-viewport-gap",
      "--uf-resizable-handle-size"
    ],
    "semanticFallbacks": [
      "--uf-content-inset",
      "--uf-membrane",
      "--uf-control-height",
      "--uf-control-pad-y",
      "--uf-control-pad-text",
      "--uf-control-gap",
      "--uf-font-size-sm",
      "--uf-font-weight",
      "--uf-font-weight-bold",
      "--uf-color-bg",
      "--uf-color-panel",
      "--uf-color-surface-sidebar",
      "--uf-color-fg",
      "--uf-color-fg-muted",
      "--uf-color-hover-bg",
      "--uf-color-active-bg",
      "--uf-color-border"
    ],
    "notes": [
      "Panel uses Button, Icon and Text for item rendering and compact-overlay triggers.",
      "width and collapsedWidth are layout inputs; compact-overlay width is bridged through --face-runtime-sidebar-sheet-w.",
      "Panel remains a higher-risk navigation primitive; behavior refactors require baseline coverage.",
      "Resizable panel handles use --uf-resizable-handle-size for the shared resizable machine CSS."
    ]
  },
  "platform": {},
  "usage": {
    "whenToUse": [
      "Sidebar content area",
      "Split-view detail pane",
      "Collapsible side section"
    ],
    "whenNotToUse": [
      "Overlay content (use Modal)",
      "Simple content block (use Card)"
    ],
    "alternatives": [
      "Card",
      "Modal"
    ],
    "context": "app"
  }
}
