{
  "schema": "face",
  "schema-version": 1,
  "name": "Toc",
  "description": "A table of contents: native links to the sections of this document, nested by level, with the current one marked.",
  "props": {
    "items": {
      "type": "array",
      "required": false,
      "description": "Entries in document order; an empty list renders nothing. Groups and separators are dropped with a report."
    },
    "value": {
      "type": "string",
      "required": false,
      "description": "Controlled current entry, marked `aria-current=\"location\"`; `null` or a value missing from `items` marks none."
    },
    "defaultValue": {
      "type": "string",
      "required": false,
      "description": "Uncontrolled current entry on mount, read once; by default no entry is current.",
      "default": null
    },
    "line": {
      "type": "enum",
      "required": false,
      "description": "Rail with a marker at the current entry, at the inline start or end of the list; `none` removes both.",
      "options": [
        "start",
        "end",
        "none"
      ],
      "default": "start"
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "line": "start",
        "items": [
          {
            "value": "intro",
            "label": "Introduction",
            "level": 1
          },
          {
            "value": "setup",
            "label": "Setup",
            "level": 1
          },
          {
            "value": "tokens",
            "label": "Design tokens",
            "level": 2
          },
          {
            "value": "themes",
            "label": "Themes",
            "level": 3
          },
          {
            "value": "usage",
            "label": "Usage",
            "level": 1
          }
        ],
        "defaultValue": "tokens"
      }
    },
    {
      "name": "Line At End",
      "props": {
        "line": "end",
        "items": [
          {
            "value": "intro",
            "label": "Introduction",
            "level": 1
          },
          {
            "value": "setup",
            "label": "Setup",
            "level": 1
          },
          {
            "value": "tokens",
            "label": "Design tokens",
            "level": 2
          },
          {
            "value": "themes",
            "label": "Themes",
            "level": 3
          },
          {
            "value": "usage",
            "label": "Usage",
            "level": 1
          }
        ],
        "defaultValue": "setup"
      }
    },
    {
      "name": "Without Line",
      "props": {
        "line": "none",
        "items": [
          {
            "value": "intro",
            "label": "Introduction",
            "level": 1
          },
          {
            "value": "setup",
            "label": "Setup",
            "level": 1
          },
          {
            "value": "tokens",
            "label": "Design tokens",
            "level": 2
          },
          {
            "value": "themes",
            "label": "Themes",
            "level": 3
          },
          {
            "value": "usage",
            "label": "Usage",
            "level": 1
          }
        ],
        "defaultValue": "intro"
      }
    },
    {
      "name": "Controlled",
      "props": {
        "items": [
          {
            "value": "intro",
            "label": "Introduction",
            "level": 1
          },
          {
            "value": "setup",
            "label": "Setup",
            "level": 1
          },
          {
            "value": "tokens",
            "label": "Design tokens",
            "level": 2
          },
          {
            "value": "themes",
            "label": "Themes",
            "level": 3
          },
          {
            "value": "usage",
            "label": "Usage",
            "level": 1
          }
        ],
        "value": "usage"
      }
    }
  ],
  "behavior": {
    "navigation": "Entries are native links to #value. A plain click or Enter makes the entry current, calls onSelect and lets the browser scroll to the section and update the hash; onSelect's preventDefault keeps the page still. A modified click opens the link elsewhere and changes nothing.",
    "current": "value marks the current entry; the consumer may drive it from scrolling. A value missing from items marks none, and an uncontrolled one waits for items that arrive later.",
    "outline": "level nests an entry in a sublist under the previous entry of a smaller level; indentation follows the nesting.",
    "line": "line puts a rail and a marker at the inline start or end of the list; the marker follows the current entry and its wrapped height.",
    "empty": "An empty list renders no navigation landmark."
  },
  "keyboard": {
    "Tab": {
      "action": "focusNextEntry"
    },
    "Enter": {
      "action": "followFocusedEntry"
    }
  },
  "aria": {
    "role": "navigation",
    "label": "Native aria-label/aria-labelledby name the nav; default Table of contents.",
    "current": "The current entry's link has aria-current=location.",
    "structure": "Entries are links in nested lists that mirror the outline."
  },
  "composition": {
    "required": [
      "root",
      "list",
      "item",
      "link"
    ],
    "parts": {
      "root": {
        "slot": "root"
      },
      "list": {
        "slot": "list",
        "parent": "root"
      },
      "item": {
        "slot": "item",
        "parent": "list",
        "multiple": true
      },
      "link": {
        "slot": "link",
        "parent": "item"
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-toc-line-inset",
      "--uf-toc-line-gap",
      "--uf-toc-rail-w",
      "--uf-toc-indicator-w"
    ],
    "semanticFallbacks": [
      "--uf-spacing-2",
      "--uf-membrane",
      "--uf-control-height",
      "--uf-control-pad-y",
      "--uf-control-pad-text",
      "--uf-control-font-size",
      "--uf-control-line-height",
      "--uf-option-indent",
      "--uf-radius",
      "--uf-color-fg",
      "--uf-color-hover-bg",
      "--uf-color-border",
      "--uf-motion-duration-control",
      "--uf-motion-ease-standard"
    ],
    "notes": [
      "Entries are links with the full-width option rhythm and Membrane; nesting indents the text by --uf-option-indent per level.",
      "The rail and the marker are the top list's ::before and ::after; the marker moves with shared motion tokens."
    ]
  },
  "platform": {},
  "usage": {
    "whenToUse": [
      "Documentation page navigation",
      "Long article section links",
      "Page outline sidebar"
    ],
    "whenNotToUse": [
      "App navigation (use Navigation)",
      "Breadcrumb trail (use Breadcrumb)"
    ],
    "alternatives": [
      "Navigation",
      "Breadcrumb"
    ],
    "context": "both"
  }
}
