{
  "name": "Sheet",
  "props": {
    "side": {
      "type": "enum",
      "required": false,
      "description": "side prop",
      "options": [
        "bottom",
        "top"
      ],
      "default": "bottom"
    },
    "title": {
      "type": "string",
      "required": false,
      "description": "Title content rendered inside the modal."
    },
    "className": {
      "type": "string",
      "required": false,
      "description": "Additional class name for the content element."
    },
    "children": {
      "type": "string",
      "required": false,
      "description": "Body content."
    },
    "open": {
      "type": "boolean",
      "required": false,
      "description": "Controlled open state."
    },
    "closeOnOverlayClick": {
      "type": "boolean",
      "required": false,
      "description": "components API compatibility: overlay click behavior."
    },
    "closable": {
      "type": "boolean",
      "required": false,
      "description": "Whether the modal can be closed via Escape / backdrop click."
    },
    "description": {
      "type": "string",
      "required": false,
      "description": "Description content rendered below the title."
    },
    "actions": {
      "type": "array",
      "required": false,
      "description": "Optional footer actions."
    },
    "trigger": {
      "type": "string",
      "required": false,
      "description": "Trigger element that toggles the modal open."
    },
    "width": {
      "type": "number",
      "required": false,
      "description": "Width in px for left/right variants."
    },
    "height": {
      "type": "number",
      "required": false,
      "description": "Height in px for top/bottom variants."
    },
    "onOpenChange": {
      "type": "function",
      "required": false,
      "description": "Called when the open state changes."
    },
    "surfaceBreakpoint": {
      "type": "number",
      "required": false,
      "description": "Breakpoint where auto surfaces switch to sheet mode."
    },
    "autoFocusOnOpen": {
      "type": "boolean",
      "required": false,
      "description": "Move focus into the modal when it opens. Disable for bounded previews that render open modals inline."
    },
    "portal": {
      "type": "boolean",
      "required": false,
      "description": "Render overlay into document.body. Disable for bounded component previews."
    },
    "backdropClassName": {
      "type": "string",
      "required": false,
      "description": "Additional class name for the backdrop element."
    },
    "positionerClassName": {
      "type": "string",
      "required": false,
      "description": "Additional class name for the positioner element."
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "open": true,
        "portal": false,
        "trigger": "Open sheet",
        "title": "Bottom sheet",
        "description": "Compact actions and selections.",
        "children": "Sheet content",
        "actions": [
          {
            "label": "Cancel",
            "variant": "outline"
          },
          {
            "label": "Apply",
            "variant": "accent"
          }
        ]
      }
    }
  ],
  "description": "Mobile-first bottom/top sheet overlay with drag-to-dismiss and focus trap",
  "behavior": {
    "focusTrap": true,
    "scrollLock": true,
    "dismissOnEscape": true,
    "dismissOnClickOutside": true,
    "returnFocusOnClose": true,
    "autoFocusOnOpen": "first-focusable",
    "dragToDismiss": true
  },
  "keyboard": {
    "Escape": {
      "action": "close"
    },
    "Tab": {
      "action": "focusTrap",
      "scope": "sheet"
    }
  },
  "aria": {
    "role": "dialog",
    "modal": true,
    "labelledBy": "sheet-title"
  },
  "composition": {
    "required": [
      "root",
      "overlay",
      "content"
    ],
    "recommended": [
      "title",
      "description",
      "close",
      "handle"
    ],
    "parts": {
      "root": {
        "slot": "root"
      },
      "overlay": {
        "slot": "overlay",
        "parent": "root"
      },
      "content": {
        "slot": "content",
        "parent": "root"
      },
      "handle": {
        "slot": "handle",
        "parent": "content"
      },
      "title": {
        "slot": "title",
        "parent": "content"
      },
      "description": {
        "slot": "description",
        "parent": "content"
      },
      "close": {
        "slot": "close",
        "parent": "content"
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-modal-sheet-inset",
      "--uf-modal-sheet-gap",
      "--face-runtime-modal-h",
      "--uf-responsive-panel-inset",
      "--uf-responsive-panel-border-width",
      "--uf-responsive-panel-pad",
      "--uf-responsive-panel-enter-y"
    ],
    "semanticFallbacks": [
      "--uf-spacing-1",
      "--uf-spacing-6",
      "--uf-membrane",
      "--uf-radius-lg",
      "--uf-color-fg",
      "--uf-overlay-backdrop-bg",
      "--uf-overlay-backdrop-blur",
      "--uf-overlay-surface-bg",
      "--uf-overlay-surface-border",
      "--uf-overlay-surface-blur",
      "--uf-overlay-surface-shadow",
      "--uf-duration-enter",
      "--uf-duration-exit",
      "--uf-ease-enter",
      "--uf-z-overlay"
    ],
    "notes": [
      "Sheet is a thin Drawer wrapper constrained to top/bottom placements and inherits Modal/Drawer overlay tokens.",
      "Drag-to-dismiss is a behavioral contract; no separate visual token namespace exists yet."
    ]
  },
  "platform": {
    "dialog": true,
    "inert": true
  },
  "usage": {
    "whenToUse": [
      "Mobile bottom sheet",
      "Compact viewport overlay content"
    ],
    "whenNotToUse": [
      "Desktop dialog (use Modal)",
      "Side panel (use Drawer)"
    ],
    "alternatives": [
      "Modal",
      "Drawer"
    ],
    "context": "app"
  }
}
