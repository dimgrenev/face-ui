{
  "schema": "face",
  "schema-version": 1,
  "name": "Breadcrumb",
  "description": "A navigation trail whose middle collapses into an overflow list once it exceeds `maxItems`.",
  "props": {
    "items": {
      "type": "array",
      "required": false,
      "description": "Ordered locations from root to current; the last kept item is the current page. Groups and separators are dropped with a report."
    },
    "separator": {
      "type": "ReactNode",
      "required": false,
      "description": "Decorative separator. '/' uses the slash icon; empty content removes the separator.",
      "default": "/"
    },
    "membrane": {
      "type": "boolean",
      "required": false,
      "description": "Membrane spacing around inline items and the overflow trigger.",
      "default": true
    },
    "maxItems": {
      "type": "number",
      "required": false,
      "description": "Visible positions including the overflow button, an integer from 3; null shows every item.",
      "default": 4
    },
    "labels": {
      "type": "object",
      "required": false,
      "description": "Names of the component's own controls: `more` names the overflow button and its dialog."
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "separator": "/",
        "membrane": true,
        "items": [
          {
            "label": "Home",
            "href": "#"
          },
          {
            "label": "Design",
            "href": "#"
          },
          {
            "label": "System",
            "href": "#"
          },
          {
            "label": "Components",
            "href": "#"
          },
          {
            "label": "Navigation",
            "href": "#"
          },
          {
            "label": "Breadcrumb"
          }
        ],
        "maxItems": 4
      }
    },
    {
      "name": "Without Membrane",
      "props": {
        "items": [
          {
            "label": "Home",
            "href": "#"
          },
          {
            "label": "Library",
            "href": "#"
          },
          {
            "label": "Breadcrumb"
          }
        ],
        "membrane": false
      }
    },
    {
      "name": "Custom Separator",
      "props": {
        "items": [
          {
            "label": "Home",
            "href": "#"
          },
          {
            "label": "Library",
            "href": "#"
          },
          {
            "label": "Breadcrumb"
          }
        ],
        "separator": ">"
      }
    },
    {
      "name": "Arrow Separator",
      "props": {
        "items": [
          {
            "label": "Home",
            "href": "#"
          },
          {
            "label": "Library",
            "href": "#"
          },
          {
            "label": "Breadcrumb"
          }
        ],
        "separator": "→"
      }
    },
    {
      "name": "Uncollapsed",
      "props": {
        "maxItems": null,
        "items": [
          {
            "label": "Home",
            "href": "#"
          },
          {
            "label": "Design",
            "href": "#"
          },
          {
            "label": "System",
            "href": "#"
          },
          {
            "label": "Components",
            "href": "#"
          },
          {
            "label": "Navigation",
            "href": "#"
          },
          {
            "label": "Breadcrumb"
          }
        ]
      }
    }
  ],
  "behavior": {
    "navigation": "href remains a native link; callbacks receive the event and may preventDefault. Without href, callbacks are native buttons and inactive locations are text.",
    "overflow": "maxItems includes the overflow position; null shows all. Root and current are preserved. Hidden ancestors use the same renderer inside a named Popover.",
    "empty": "An empty trail renders no navigation landmark."
  },
  "keyboard": {
    "Tab": {
      "action": "focusNextInteractiveLocation"
    },
    "Enter": {
      "action": "activateFocusedLinkOrButton"
    },
    "Space": {
      "action": "activateFocusedButton"
    },
    "Escape": {
      "action": "closeOverflow"
    }
  },
  "aria": {
    "role": "navigation",
    "label": "Native aria-label/aria-labelledby name the nav; default Breadcrumb. labels.more names the overflow button and dialog.",
    "current": "The last location has aria-current=page; a destination is optional.",
    "separator": "Separators are decorative and hidden from assistive technology."
  },
  "composition": {
    "required": [
      "root",
      "list",
      "item"
    ],
    "parts": {
      "root": {
        "slot": "root"
      },
      "list": {
        "slot": "list",
        "parent": "root"
      },
      "item": {
        "slot": "item",
        "parent": "list",
        "multiple": true
      },
      "link": {
        "slot": "link",
        "parent": "item"
      },
      "separator": {
        "slot": "separator",
        "parent": "item"
      },
      "current": {
        "slot": "current",
        "parent": "item"
      },
      "action": {
        "slot": "action",
        "parent": "item"
      },
      "label": {
        "slot": "label",
        "parent": "item"
      }
    }
  },
  "tokenMapping": {
    "component": [],
    "semanticFallbacks": [
      "--uf-membrane",
      "--uf-control-height",
      "--uf-control-pad-y",
      "--uf-control-pad-text",
      "--uf-radius",
      "--uf-font-size-sm",
      "--uf-font-weight-bold",
      "--uf-color-fg",
      "--uf-color-fg-muted",
      "--uf-color-hover-bg"
    ],
    "notes": [
      "Inline locations share control geometry and Membrane. Overflow uses the shared ghost Button and Popover.",
      "Separator and wrapping belong to Breadcrumb; there is no duplicated Button skin."
    ]
  },
  "platform": {},
  "usage": {
    "whenToUse": [
      "Deep page hierarchy navigation",
      "Multi-level content structure"
    ],
    "whenNotToUse": [
      "Flat navigation (use Tabs)",
      "Single-level nav (use Navigation)"
    ],
    "alternatives": [
      "Navigation",
      "Tabs"
    ],
    "context": "both"
  }
}
