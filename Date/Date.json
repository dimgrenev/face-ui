{
  "schema": "face",
  "schema-version": 1,
  "name": "Date",
  "description": "Unified date/time picker with multi-view and range support",
  "props": {
    "open": {
      "type": "boolean",
      "required": false,
      "description": "Controlled visibility; disabled, readOnly and hidden fields cannot open."
    },
    "defaultOpen": {
      "type": "boolean",
      "required": false,
      "description": "Initial visibility for an uncontrolled picker.",
      "default": false
    },
    "locale": {
      "type": "string",
      "required": false,
      "description": "Date formatting language, numbering system and default first weekday; dates stay Gregorian.",
      "default": "en-US"
    },
    "labels": {
      "type": "object",
      "required": false,
      "description": "Internal action and view labels; field label, placeholder and surfaceTitle keep their own content APIs."
    },
    "timezone": {
      "type": "string",
      "required": false,
      "description": "Zone for instants and today's civil date. Defaults to UTC.",
      "default": "UTC"
    },
    "weekStartsOn": {
      "type": "enum",
      "required": false,
      "description": "Override the locale's first weekday: 0=Sunday through 6=Saturday.",
      "options": [
        0,
        1,
        2,
        3,
        4,
        5,
        6
      ]
    },
    "format": {
      "type": "string",
      "required": false,
      "description": "Display pattern; see the supported tokens and quoted literals in the Date docs."
    },
    "min": {
      "type": "any",
      "required": false,
      "description": "Inclusive lower bound in timezone; a date-only bound includes its whole day.",
      "default": null
    },
    "max": {
      "type": "any",
      "required": false,
      "description": "Inclusive upper bound in timezone; a date-only bound includes its whole day.",
      "default": null
    },
    "disabledDates": {
      "type": "array",
      "required": false,
      "description": "Unavailable whole days; Date instants are converted into timezone before taking the day.",
      "default": []
    },
    "disabledTime": {
      "type": "object",
      "required": false,
      "description": "Unavailable hours (0–23) and minutes (0–59) for every day in time/datetime mode."
    },
    "closeOnSelect": {
      "type": "boolean",
      "required": false,
      "description": "Close panel after completing selection"
    },
    "showNow": {
      "type": "boolean",
      "required": false,
      "description": "Show the shortcut to the current day or time in timezone.",
      "default": true
    },
    "showClear": {
      "type": "boolean",
      "required": false,
      "description": "Show the clear action; it is disabled when the selection is empty.",
      "default": true
    },
    "surface": {
      "type": "enum",
      "required": false,
      "description": "surface prop",
      "options": [
        "auto",
        "popover",
        "sheet"
      ],
      "default": "auto"
    },
    "surfaceBreakpoint": {
      "type": "number",
      "required": false,
      "description": "surfaceBreakpoint prop"
    },
    "surfaceTitle": {
      "type": "ReactNode",
      "required": false,
      "description": "surfaceTitle prop"
    },
    "label": {
      "type": "ReactNode",
      "required": false,
      "description": "Control label"
    },
    "description": {
      "type": "ReactNode",
      "required": false,
      "description": "Helper text below control"
    },
    "error": {
      "type": "ReactNode",
      "required": false,
      "description": "Error message below control"
    },
    "name": {
      "type": "string",
      "required": false,
      "description": "Native form field name. Ranges serialize as an ISO start/end interval."
    },
    "form": {
      "type": "string",
      "required": false,
      "description": "Associate the field with a form by id."
    },
    "required": {
      "type": "boolean",
      "required": false,
      "description": "Require a complete selection for native form validation.",
      "default": false
    },
    "disabled": {
      "type": "boolean",
      "required": false,
      "description": "Disable interactions",
      "default": false
    },
    "readOnly": {
      "type": "boolean",
      "required": false,
      "description": "Read-only mode",
      "default": false
    },
    "placeholder": {
      "type": "string",
      "required": false,
      "description": "Trigger placeholder text"
    },
    "membrane": {
      "type": "boolean",
      "required": false,
      "description": "Enable membrane wrapper around trigger",
      "default": true
    },
    "fullWidth": {
      "type": "boolean",
      "required": false,
      "description": "Stretch control to container width",
      "default": true
    },
    "mode": {
      "type": "enum",
      "required": false,
      "description": "Picker mode: date, datetime, time, week, month or year",
      "options": [
        "date",
        "datetime",
        "time",
        "month",
        "year",
        "week"
      ],
      "default": "date"
    },
    "openTo": {
      "type": "enum",
      "required": false,
      "description": "Initial opened view",
      "options": [
        "day",
        "hours",
        "minutes",
        "month",
        "year"
      ]
    },
    "selection": {
      "type": "enum",
      "required": false,
      "description": "Single value or range endpoints; week owns its range selection.",
      "options": [
        "single",
        "range"
      ],
      "default": "single"
    },
    "presets": {
      "type": "array",
      "required": false,
      "description": "Explicit shortcuts with unique id, label and selection-shaped value; an omitted or empty array renders none."
    },
    "value": {
      "type": "any",
      "required": false,
      "description": "Controlled civil ISO or Date instant, or a range of these; null clears selection."
    },
    "defaultValue": {
      "type": "any",
      "required": false,
      "description": "Initial uncontrolled value; ignored while value is controlled.",
      "default": null
    },
    "valueFormat": {
      "type": "enum",
      "required": false,
      "description": "Callback representation; form submission always uses civil ISO values.",
      "options": [
        "iso",
        "date"
      ],
      "default": "iso"
    },
    "excludeDisabledDates": {
      "type": "boolean",
      "required": false,
      "description": "Exclude unavailable days from the whole range; false constrains only its endpoints.",
      "default": true
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "mode": "date",
        "selection": "single",
        "defaultValue": null,
        "valueFormat": "iso",
        "locale": "en-US",
        "timezone": "UTC",
        "min": null,
        "max": null,
        "showNow": true,
        "showClear": true,
        "surface": "auto",
        "required": false,
        "disabled": false,
        "readOnly": false,
        "membrane": true,
        "fullWidth": true,
        "label": "Date",
        "placeholder": "Pick date"
      }
    },
    {
      "name": "DateTime",
      "props": {
        "mode": "datetime",
        "openTo": "day",
        "label": "Date & Time",
        "value": "2026-03-03T12:30"
      }
    },
    {
      "name": "Time",
      "props": {
        "mode": "time",
        "openTo": "hours",
        "label": "Time",
        "value": "2026-03-03T08:15"
      }
    },
    {
      "name": "Range",
      "props": {
        "mode": "date",
        "selection": "range",
        "label": "Date range",
        "value": {
          "start": "2026-03-03",
          "end": "2026-03-09"
        },
        "presets": [
          {
            "id": "release-week",
            "label": "Release week",
            "value": {
              "start": "2026-03-02",
              "end": "2026-03-08"
            }
          },
          {
            "id": "review-window",
            "label": "Review window",
            "value": {
              "start": "2026-03-09",
              "end": "2026-03-13"
            }
          }
        ]
      }
    },
    {
      "name": "Week",
      "props": {
        "mode": "week",
        "label": "Week",
        "value": {
          "start": "2026-03-02",
          "end": "2026-03-08"
        }
      }
    },
    {
      "name": "Month",
      "props": {
        "mode": "month",
        "openTo": "month",
        "label": "Month",
        "value": "2026-06-01"
      }
    },
    {
      "name": "Year",
      "props": {
        "mode": "year",
        "openTo": "year",
        "label": "Year",
        "value": "2028-01-01"
      }
    },
    {
      "name": "With Validation",
      "props": {
        "mode": "date",
        "label": "Limited date",
        "min": "2026-03-01",
        "max": "2026-03-31",
        "disabledDates": [
          "2026-03-08",
          "2026-03-15",
          "2026-03-22"
        ],
        "description": "Only March 2026 is selectable",
        "error": null
      }
    },
    {
      "name": "Read Only",
      "props": {
        "mode": "date",
        "label": "Read only date",
        "readOnly": true,
        "value": "2026-03-03"
      }
    }
  ],
  "behavior": {
    "dismissOnEscape": true,
    "dismissOnClickOutside": true,
    "returnFocusOnClose": true,
    "rovingFocus": true
  },
  "keyboard": {
    "Escape": {
      "action": "close"
    },
    "ArrowRight": {
      "action": "nextDay"
    },
    "ArrowLeft": {
      "action": "previousDay"
    },
    "ArrowDown": {
      "action": "nextWeek"
    },
    "ArrowUp": {
      "action": "previousWeek"
    },
    "Enter": {
      "action": "select"
    },
    "Space": {
      "action": "select"
    }
  },
  "aria": {
    "role": "combobox",
    "required": [
      "aria-label",
      "aria-expanded"
    ]
  },
  "composition": {
    "required": [
      "root",
      "trigger",
      "content",
      "calendar"
    ],
    "recommended": [
      "label",
      "description",
      "error"
    ],
    "parts": {
      "root": {
        "slot": "root"
      },
      "label": {
        "slot": "label",
        "parent": "root"
      },
      "trigger": {
        "slot": "trigger",
        "parent": "root"
      },
      "content": {
        "slot": "content",
        "parent": "root"
      },
      "calendar": {
        "slot": "calendar",
        "parent": "content"
      },
      "description": {
        "slot": "description",
        "parent": "root"
      },
      "error": {
        "slot": "error",
        "parent": "root"
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-date-content-max-width",
      "--uf-date-content-max-height",
      "--uf-date-content-viewport-gap",
      "--uf-date-sheet-inset",
      "--uf-date-sheet-gap",
      "--uf-date-panel-pad",
      "--uf-date-sheet-enter-y"
    ],
    "semanticFallbacks": [
      "--uf-spacing-1",
      "--uf-spacing-8",
      "--uf-membrane",
      "--uf-control-height",
      "--uf-control-pad-y",
      "--uf-control-pad-text",
      "--uf-control-pad-icon",
      "--uf-control-gap",
      "--uf-radius",
      "--uf-color-fg",
      "--uf-color-fg-muted",
      "--uf-color-hover-bg",
      "--uf-color-destructive",
      "--uf-color-error",
      "--uf-overlay-surface-bg",
      "--uf-overlay-surface-shadow",
      "--uf-overlay-surface-blur",
      "--uf-overlay-enter-y",
      "--uf-overlay-enter-scale",
      "--uf-duration-enter",
      "--uf-duration-exit",
      "--uf-ease-enter",
      "--uf-z-dropdown",
      "--uf-z-overlay"
    ],
    "notes": [
      "Date label, value, description and error text render through Text; actions render through Button.",
      "Popover and sheet surfaces inherit overlay semantic tokens for surface, blur, shadow and motion.",
      "Date values, locale and timezone are product data and intentionally outside visual token ownership."
    ]
  },
  "platform": {
    "popover": true
  },
  "usage": {
    "whenToUse": [
      "Formatted date display",
      "Relative time display"
    ],
    "whenNotToUse": [
      "Date input with calendar trigger",
      "Calendar view (use Calendar)"
    ],
    "alternatives": [
      "Calendar",
      "Text"
    ],
    "context": "both"
  }
}
