{
  "schema": "face",
  "schema-version": 1,
  "name": "Button",
  "description": "An action the reader can take: a labelled control with optional icons, a loading state and a copy-to-clipboard shortcut.",
  "props": {
    "children": {
      "type": "ReactNode",
      "required": false,
      "description": "Label of the button; with `iconOnly` it stays as the accessible name only."
    },
    "meta": {
      "type": "ReactNode",
      "required": false,
      "description": "Secondary text at the inline end of the label area, such as a shortcut or count."
    },
    "variant": {
      "type": "enum",
      "required": false,
      "description": "Visual variant.",
      "options": [
        "default",
        "primary",
        "secondary",
        "accent",
        "outline",
        "ghost",
        "destructive"
      ],
      "default": "default"
    },
    "icon": {
      "type": "ReactNode",
      "required": false,
      "description": "Icon (string from registry, ReactNode, or SVG element)."
    },
    "iconPosition": {
      "type": "enum",
      "required": false,
      "description": "Icon at the start or end of the label, following text direction. Default: start.",
      "options": [
        "start",
        "end"
      ],
      "default": "start"
    },
    "iconOnly": {
      "type": "boolean",
      "required": false,
      "description": "Hide the visual label while preserving its accessible text. Compact buttons are square.",
      "default": false
    },
    "disabled": {
      "type": "boolean",
      "required": false,
      "description": "Disabled state.",
      "default": false
    },
    "loading": {
      "type": "boolean",
      "required": false,
      "description": "Loading state (shows spinner, dims text).",
      "default": false
    },
    "stretchText": {
      "type": "boolean",
      "required": false,
      "description": "Stretch text area (flex:1).",
      "default": false
    },
    "chevron": {
      "type": "enum",
      "required": false,
      "description": "Trailing disclosure chevron: `down` flips with aria-expanded; `end` points to the inline end and mirrors in right-to-left text.",
      "options": [
        "down",
        "end"
      ]
    },
    "aria-expanded": {
      "type": "boolean",
      "required": false,
      "description": "Standard expanded state, also used to orient the disclosure chevron.",
      "options": [
        "false",
        "true"
      ]
    },
    "fullWidth": {
      "type": "boolean",
      "required": false,
      "description": "Full width button.",
      "default": false
    },
    "align": {
      "type": "enum",
      "required": false,
      "description": "Inline alignment of the content, following text direction.",
      "options": [
        "start",
        "center",
        "end"
      ]
    },
    "indent": {
      "type": "number",
      "required": false,
      "description": "Indent steps for nested option-like rows, an integer from 0 to 9."
    },
    "membrane": {
      "type": "boolean",
      "required": false,
      "description": "Membrane spacing around the button.",
      "default": true
    },
    "copyText": {
      "type": "string",
      "required": false,
      "description": "Copy text to clipboard on click (Clipboard integration)."
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "children": "Create",
        "icon": "plus",
        "fullWidth": false
      }
    },
    {
      "name": "Primary",
      "props": {
        "children": "Primary",
        "variant": "primary"
      }
    },
    {
      "name": "Secondary",
      "props": {
        "children": "Secondary",
        "variant": "secondary"
      }
    },
    {
      "name": "Accent",
      "props": {
        "children": "Accent",
        "variant": "accent"
      }
    },
    {
      "name": "Outline",
      "props": {
        "children": "Outline",
        "variant": "outline"
      }
    },
    {
      "name": "Ghost",
      "props": {
        "children": "Ghost",
        "variant": "ghost"
      }
    },
    {
      "name": "Destructive",
      "props": {
        "children": "Delete",
        "variant": "destructive"
      }
    },
    {
      "name": "Disabled",
      "props": {
        "children": "Disabled",
        "disabled": true
      }
    },
    {
      "name": "Full Width",
      "props": {
        "children": "Full Width",
        "fullWidth": true
      }
    },
    {
      "name": "Selector",
      "props": {
        "children": "GPT-5.5",
        "chevron": "down"
      }
    },
    {
      "name": "Side Selector",
      "props": {
        "children": "Nested",
        "chevron": "end"
      }
    }
  ],
  "behavior": {
    "loading": "Loading state shows a spinner and blocks activation with native disabled."
  },
  "keyboard": {
    "Enter": {
      "action": "activate"
    },
    "Space": {
      "action": "activate"
    }
  },
  "aria": {
    "role": "button",
    "states": [
      "aria-busy=true when loading"
    ]
  },
  "composition": {
    "required": [
      "root"
    ],
    "recommended": [
      "icon",
      "text",
      "label",
      "indicator"
    ],
    "parts": {
      "root": {
        "slot": "root"
      },
      "icon": {
        "slot": "icon",
        "parent": "root"
      },
      "text": {
        "slot": "text",
        "parent": "root"
      },
      "label": {
        "slot": "label",
        "parent": "text"
      },
      "indicator": {
        "slot": "indicator",
        "parent": "text"
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-control-pad-start",
      "--uf-control-pad-end",
      "--uf-button-focus-ring-width",
      "--uf-button-outline-width",
      "--uf-button-bg",
      "--uf-button-fg",
      "--uf-button-hover-bg",
      "--uf-button-hover-fg",
      "--uf-button-ring-color",
      "--uf-selector-indicator-gap",
      "--uf-selector-indicator-offset-inline-start",
      "--uf-selector-indicator-edge-gap",
      "--uf-selector-indicator-size",
      "--uf-icon-only-size",
      "--face-runtime-option-level",
      "--uf-interactive-weight",
      "--uf-spinner-size",
      "--uf-spinner-size-sm",
      "--uf-spinner-border-width",
      "--uf-spinner-border-width-sm"
    ],
    "semanticFallbacks": [
      "--uf-control-height",
      "--uf-control-font-size",
      "--uf-control-line-height",
      "--uf-control-letter-spacing",
      "--uf-control-pad-y",
      "--uf-control-pad-text",
      "--uf-control-pad-icon",
      "--uf-control-gap",
      "--uf-font-weight",
      "--uf-radius",
      "--uf-membrane",
      "--uf-option-indent",
      "--uf-color-fg",
      "--uf-color-bg",
      "--uf-color-primary",
      "--uf-color-primary-fg",
      "--uf-color-accent",
      "--uf-color-accent-fg",
      "--uf-color-hover-bg",
      "--uf-color-active-bg",
      "--uf-color-destructive",
      "--uf-color-destructive-soft",
      "--uf-color-disabled-opacity",
      "--uf-motion-duration-emphasis",
      "--uf-motion-duration-spin",
      "--uf-motion-iteration-indefinite",
      "--uf-motion-ease-emphasized",
      "--uf-motion-ease-linear"
    ],
    "notes": [
      "Variants set component foreground/background tokens on the root and consume shared control geometry.",
      "Selector mode renders a compact indicator inside the text slot so the chevron stays close to the label.",
      "Hover font-weight feedback uses --uf-interactive-weight and loading spinner geometry/motion consume shared Face UI tokens.",
      "Use Text for pure typography; Button text is action copy inside an interactive control."
    ]
  },
  "platform": {},
  "usage": {
    "whenToUse": [
      "Explicit user action trigger",
      "Form submission",
      "Navigation trigger",
      "Destructive action confirmation"
    ],
    "whenNotToUse": [
      "Pure text display (use Text)",
      "Binary toggle (use Switcher)",
      "Selection among peers (use Radio/Tabs)",
      "Navigation link (use anchor or Navigation)"
    ],
    "alternatives": [
      "Text",
      "Switcher",
      "Radio",
      "Tabs"
    ],
    "context": "both"
  }
}
