{
  "schema": "face",
  "schema-version": 1,
  "name": "Modal",
  "description": "Centered dialog surface for focused decisions and workflows",
  "props": {
    "placement": {
      "type": "enum",
      "required": false,
      "description": "Viewport placement of the modal surface.",
      "options": [
        "center",
        "left",
        "right",
        "top",
        "bottom"
      ],
      "default": "center"
    },
    "edge": {
      "type": "enum",
      "required": false,
      "description": "Inset adds the system viewport gap, radius, and border; flush attaches the surface to its placement edge.",
      "options": [
        "inset",
        "flush"
      ],
      "default": "inset"
    },
    "width": {
      "type": "number",
      "required": false,
      "description": "Preferred surface width in pixels, constrained by the viewport."
    },
    "height": {
      "type": "number",
      "required": false,
      "description": "Preferred surface height in pixels, constrained by the viewport."
    },
    "open": {
      "type": "boolean",
      "required": false,
      "description": "Controlled open state."
    },
    "closeOnOverlayClick": {
      "type": "boolean",
      "required": false,
      "description": "Close the surface when its backdrop is clicked.",
      "default": true
    },
    "closable": {
      "type": "boolean",
      "required": false,
      "description": "Whether the surface can be closed via Escape / backdrop click.",
      "default": true
    },
    "title": {
      "type": "string",
      "required": false,
      "description": "Title content rendered inside the surface."
    },
    "description": {
      "type": "string",
      "required": false,
      "description": "Description content rendered below the title."
    },
    "children": {
      "type": "string",
      "required": false,
      "description": "Body content."
    },
    "actions": {
      "type": "array",
      "required": false,
      "description": "Optional footer actions."
    },
    "trigger": {
      "type": "string",
      "required": false,
      "description": "Trigger element that toggles the modal open."
    },
    "autoFocusOnOpen": {
      "type": "boolean",
      "required": false,
      "description": "Move focus into the surface when it opens. Disable for bounded previews that render it inline.",
      "default": true
    },
    "scrollLock": {
      "type": "boolean",
      "required": false,
      "description": "Lock body scroll while the modal is open. Opt-in; off by default.",
      "default": false
    },
    "portal": {
      "type": "boolean",
      "required": false,
      "description": "Render overlay into document.body. Disable for bounded component previews.",
      "default": true
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "open": true,
        "portal": false,
        "autoFocusOnOpen": false,
        "placement": "center",
        "edge": "inset",
        "title": "Modal",
        "description": "Focused work surface",
        "children": "Review the workspace details before creating it.",
        "actions": [
          {
            "label": "Cancel",
            "variant": "outline"
          },
          {
            "label": "Create",
            "variant": "accent"
          }
        ]
      }
    },
    {
      "name": "Right edge workspace",
      "props": {
        "open": true,
        "portal": false,
        "autoFocusOnOpen": false,
        "placement": "right",
        "edge": "flush",
        "width": 420,
        "title": "Customer details",
        "description": "Account health and recent activity",
        "children": "Plan: Enterprise. Last active 12 minutes ago.",
        "actions": [
          {
            "label": "Edit customer",
            "variant": "accent"
          }
        ]
      }
    }
  ],
  "behavior": {
    "focusTrap": true,
    "scrollLock": false,
    "dismissOnEscape": true,
    "dismissOnClickOutside": true,
    "returnFocusOnClose": true,
    "autoFocusOnOpen": "first-focusable"
  },
  "keyboard": {
    "Escape": {
      "action": "close"
    },
    "Tab": {
      "action": "focusTrap",
      "scope": "modal"
    }
  },
  "aria": {
    "role": "dialog",
    "modal": true,
    "labelledBy": "modal-title",
    "describedBy": "modal-description"
  },
  "composition": {
    "required": [
      "root",
      "backdrop",
      "positioner",
      "content"
    ],
    "recommended": [
      "trigger",
      "title",
      "description",
      "close"
    ],
    "parts": {
      "root": {
        "slot": "root"
      },
      "trigger": {
        "slot": "trigger",
        "parent": "root"
      },
      "backdrop": {
        "slot": "backdrop",
        "parent": "root"
      },
      "positioner": {
        "slot": "positioner",
        "parent": "root"
      },
      "content": {
        "slot": "content",
        "parent": "positioner"
      },
      "title": {
        "slot": "title",
        "parent": "content"
      },
      "description": {
        "slot": "description",
        "parent": "content"
      },
      "close": {
        "slot": "close",
        "parent": "content"
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-modal-zero-blur",
      "--uf-modal-pad",
      "--uf-modal-max-w",
      "--uf-modal-viewport-gap",
      "--uf-modal-enter-y",
      "--face-runtime-modal-w"
    ],
    "semanticFallbacks": [
      "--uf-content-inset",
      "--uf-control-height",
      "--uf-radius-lg",
      "--uf-font-size",
      "--uf-z-modal",
      "--uf-duration-enter",
      "--uf-duration-exit",
      "--uf-ease-enter",
      "--uf-color-fg",
      "--uf-color-fg-muted",
      "--uf-overlay-backdrop-bg",
      "--uf-overlay-backdrop-blur",
      "--uf-overlay-surface-bg",
      "--uf-overlay-surface-blur",
      "--uf-overlay-surface-shadow"
    ],
    "notes": [
      "placement selects centered or edge-aligned dialog geometry; edge selects inset or flush attachment independently.",
      "width and height write private runtime custom properties while default sizing remains in the modal token namespace."
    ]
  },
  "platform": {
    "dialog": true,
    "inert": true
  },
  "usage": {
    "whenToUse": [
      "Focused dialog requiring user decision",
      "Confirmation before destructive action",
      "Content that needs full attention"
    ],
    "whenNotToUse": [
      "Displaying additional info (use Popover)",
      "Persistent page navigation (use Panel)",
      "Non-blocking notification (use Toaster)"
    ],
    "alternatives": [
      "Panel",
      "Popover",
      "Toaster"
    ],
    "context": "app"
  }
}
