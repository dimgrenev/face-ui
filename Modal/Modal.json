{
  "name": "Modal",
  "description": "Overlay surface component unifying dialog, drawer, and alert dialog",
  "props": {
    "open": {
      "type": "boolean",
      "required": false,
      "description": "Controlled open state."
    },
    "variant": {
      "type": "enum",
      "required": false,
      "description": "Visual placement variant.",
      "options": [
        "center",
        "left",
        "right",
        "top",
        "bottom"
      ],
      "default": "right"
    },
    "closeOnOverlayClick": {
      "type": "boolean",
      "required": false,
      "description": "components API compatibility: overlay click behavior.",
      "default": true
    },
    "closable": {
      "type": "boolean",
      "required": false,
      "description": "Whether the modal can be closed via Escape / backdrop click.",
      "default": true
    },
    "title": {
      "type": "string",
      "required": false,
      "description": "Title content rendered inside the modal."
    },
    "description": {
      "type": "string",
      "required": false,
      "description": "Description content rendered below the title."
    },
    "children": {
      "type": "string",
      "required": false,
      "description": "Body content."
    },
    "actions": {
      "type": "array",
      "required": false,
      "description": "Optional footer actions."
    },
    "trigger": {
      "type": "string",
      "required": false,
      "description": "Trigger element that toggles the modal open."
    },
    "width": {
      "type": "number",
      "required": false,
      "description": "Width in px for left/right variants.",
      "default": 400
    },
    "height": {
      "type": "number",
      "required": false,
      "description": "Height in px for top/bottom variants.",
      "default": 420
    },
    "onOpenChange": {
      "type": "function",
      "required": false,
      "description": "Called when the open state changes."
    },
    "surface": {
      "type": "enum",
      "required": false,
      "description": "Surface behavior on compact viewports.",
      "options": [
        "auto",
        "dialog",
        "sheet"
      ],
      "default": "auto"
    },
    "surfaceBreakpoint": {
      "type": "number",
      "required": false,
      "description": "Breakpoint where auto surfaces switch to sheet mode."
    },
    "autoFocusOnOpen": {
      "type": "boolean",
      "required": false,
      "description": "Move focus into the modal when it opens. Disable for bounded previews that render open modals inline.",
      "default": true
    },
    "portal": {
      "type": "boolean",
      "required": false,
      "description": "Render overlay into document.body. Disable for bounded component previews.",
      "default": true
    },
    "className": {
      "type": "string",
      "required": false,
      "description": "Additional class name for the content element."
    },
    "backdropClassName": {
      "type": "string",
      "required": false,
      "description": "Additional class name for the backdrop element."
    },
    "positionerClassName": {
      "type": "string",
      "required": false,
      "description": "Additional class name for the positioner element."
    }
  },
  "states": [
    {
      "name": "Default (Center)",
      "props": {
        "open": true,
        "portal": false,
        "variant": "center",
        "title": "Dialog Title",
        "description": "This is a dialog.",
        "actions": [
          {
            "label": "Cancel",
            "variant": "outline"
          },
          {
            "label": "Continue",
            "variant": "accent"
          }
        ]
      }
    },
    {
      "name": "Drawer Left",
      "props": {
        "open": true,
        "portal": false,
        "variant": "left",
        "title": "Left Drawer"
      }
    },
    {
      "name": "Drawer Right",
      "props": {
        "open": true,
        "portal": false,
        "variant": "right",
        "title": "Right Drawer"
      }
    },
    {
      "name": "Sheet Bottom",
      "props": {
        "open": true,
        "portal": false,
        "variant": "bottom",
        "title": "Bottom Sheet"
      }
    },
    {
      "name": "Alert (Non-Closable)",
      "props": {
        "open": true,
        "portal": false,
        "closable": false,
        "title": "Are you sure?"
      }
    }
  ],
  "behavior": {
    "focusTrap": true,
    "scrollLock": true,
    "dismissOnEscape": true,
    "dismissOnClickOutside": true,
    "returnFocusOnClose": true,
    "autoFocusOnOpen": "first-focusable"
  },
  "keyboard": {
    "Escape": {
      "action": "close"
    },
    "Tab": {
      "action": "focusTrap",
      "scope": "modal"
    }
  },
  "aria": {
    "role": "dialog",
    "modal": true,
    "labelledBy": "modal-title",
    "describedBy": "modal-description"
  },
  "composition": {
    "required": [
      "root",
      "overlay",
      "content"
    ],
    "recommended": [
      "title",
      "description",
      "close"
    ],
    "parts": {
      "root": {
        "slot": "root"
      },
      "overlay": {
        "slot": "overlay",
        "parent": "root"
      },
      "content": {
        "slot": "content",
        "parent": "root"
      },
      "title": {
        "slot": "title",
        "parent": "content"
      },
      "description": {
        "slot": "description",
        "parent": "content"
      },
      "close": {
        "slot": "close",
        "parent": "content"
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-modal-zero-blur",
      "--uf-modal-sheet-inset",
      "--uf-modal-sheet-gap",
      "--uf-modal-pad",
      "--uf-modal-max-w",
      "--uf-modal-viewport-gap",
      "--uf-modal-enter-y",
      "--uf-modal-side-enter-x",
      "--uf-modal-side-w-default",
      "--uf-modal-stack-h-default",
      "--face-runtime-modal-w",
      "--face-runtime-modal-h"
    ],
    "semanticFallbacks": [
      "--uf-content-inset",
      "--uf-control-height",
      "--uf-radius-lg",
      "--uf-font-size",
      "--uf-z-modal",
      "--uf-duration-enter",
      "--uf-duration-exit",
      "--uf-ease-enter",
      "--uf-color-fg",
      "--uf-color-fg-muted",
      "--uf-overlay-backdrop-bg",
      "--uf-overlay-backdrop-blur",
      "--uf-overlay-surface-bg",
      "--uf-overlay-surface-blur",
      "--uf-overlay-surface-shadow"
    ],
    "notes": [
      "Modal variants control placement; surface color, blur and motion come from overlay semantic tokens.",
      "Width/height props write private runtime custom properties while default sizing remains in the modal token namespace."
    ]
  },
  "platform": {
    "dialog": true,
    "inert": true
  },
  "usage": {
    "whenToUse": [
      "Focused dialog requiring user decision",
      "Confirmation before destructive action",
      "Content that needs full attention"
    ],
    "whenNotToUse": [
      "Displaying additional info (use Popover)",
      "Side panel content (use Drawer)",
      "Non-blocking notification (use Toaster)"
    ],
    "alternatives": [
      "Drawer",
      "Popover",
      "Toaster"
    ],
    "context": "app"
  }
}
