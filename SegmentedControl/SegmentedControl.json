{
  "schema": "face",
  "schema-version": 1,
  "name": "SegmentedControl",
  "props": {
    "items": {
      "type": "array",
      "required": false,
      "description": "Choices in visual, keyboard and form order; missing items render an empty group.",
      "default": []
    },
    "disabled": {
      "type": "boolean",
      "required": false,
      "description": "Disable every control and exclude the group from FormData.",
      "default": false
    },
    "orientation": {
      "type": "enum",
      "required": false,
      "description": "Visual axis; single radio mode supports both arrow pairs.",
      "options": [
        "horizontal",
        "vertical"
      ],
      "default": "horizontal"
    },
    "aria-label": {
      "type": "string",
      "required": false,
      "description": "Accessible group name when there is no visible heading."
    },
    "aria-labelledby": {
      "type": "string",
      "required": false,
      "description": "Visible heading IDs that name this group."
    },
    "name": {
      "type": "string",
      "required": false,
      "description": "Native FormData key; multiple selections produce repeated entries."
    },
    "form": {
      "type": "string",
      "required": false,
      "description": "ID of an external form that owns the selection."
    },
    "autoFocus": {
      "type": "boolean",
      "required": false,
      "description": "Focus the selected enabled choice, or the first enabled choice, on mount.",
      "default": false
    },
    "membrane": {
      "type": "boolean",
      "required": false,
      "description": "Shared outer spacing around each item; toggling preserves DOM and focus.",
      "default": true
    },
    "multiple": {
      "type": "boolean",
      "required": false,
      "description": "False selects one item without clearing on reselect; true toggles independent options.",
      "default": false
    },
    "value": {
      "type": "any",
      "required": false,
      "description": "Controlled selection: string/null for single, readonly string[] for multiple. Unknown keys are omitted."
    },
    "defaultValue": {
      "type": "any",
      "required": false,
      "description": "Initial selection, restored on form reset: string/null for single, readonly string[] for multiple."
    }
  },
  "states": [
    {
      "name": "Single view",
      "props": {
        "items": [
          {
            "value": "grid",
            "label": "Grid"
          },
          {
            "value": "list",
            "label": "List"
          },
          {
            "value": "board",
            "label": "Board"
          }
        ],
        "defaultValue": "grid",
        "aria-label": "View"
      }
    },
    {
      "name": "Multiple filters",
      "props": {
        "multiple": true,
        "items": [
          {
            "value": "email",
            "label": "Email"
          },
          {
            "value": "push",
            "label": "Push"
          }
        ],
        "defaultValue": [
          "email"
        ],
        "aria-label": "Channels"
      }
    },
    {
      "name": "Vertical",
      "props": {
        "orientation": "vertical",
        "items": [
          {
            "value": "compact",
            "label": "Compact"
          },
          {
            "value": "comfortable",
            "label": "Comfortable"
          }
        ],
        "defaultValue": "compact",
        "aria-label": "Density"
      }
    }
  ],
  "description": "Compact single-choice radio strip or a group of independently pressed options",
  "behavior": {
    "rovingFocus": true
  },
  "keyboard": {
    "ArrowRight": {
      "action": "focusNext"
    },
    "ArrowLeft": {
      "action": "focusPrevious"
    },
    "ArrowDown": {
      "action": "focusNext"
    },
    "ArrowUp": {
      "action": "focusPrevious"
    },
    "Home": {
      "action": "focusFirst"
    },
    "End": {
      "action": "focusLast"
    },
    "Enter": {
      "action": "selectOrToggle"
    },
    "Space": {
      "action": "selectOrToggle"
    }
  },
  "aria": {
    "role": "radiogroup",
    "required": [
      "aria-label"
    ]
  },
  "composition": {
    "required": [
      "root",
      "item"
    ],
    "parts": {
      "root": {
        "slot": "root"
      },
      "item": {
        "slot": "item",
        "parent": "root",
        "multiple": true
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-toggle-border-width"
    ],
    "semanticFallbacks": [
      "--uf-membrane",
      "--uf-overlay-surface-border",
      "--uf-radius",
      "--uf-control-height",
      "--uf-control-pad-y",
      "--uf-control-pad-text",
      "--uf-color-fg",
      "--uf-color-hover-bg",
      "--uf-color-active-bg",
      "--uf-border-width-thin"
    ],
    "notes": [
      "One implementation owns SegmentedControl and compatibility Toggle.",
      "Shared Membrane owns item spacing; orientation changes layout and multiple changes selection semantics.",
      "Selection uses fill and a stable border, without changing text metrics."
    ]
  },
  "platform": {},
  "usage": {
    "whenToUse": [
      "Toggle between 2-4 views",
      "View mode switching",
      "Filter presets"
    ],
    "whenNotToUse": [
      "Many or dynamically searched options (use Select)",
      "Navigating content panels (use Tabs)",
      "Validated required form choices (use Radio or Select)",
      "Binary on/off (use Switcher)"
    ],
    "alternatives": [
      "Tabs",
      "Radio",
      "Switcher"
    ],
    "context": "both"
  }
}
