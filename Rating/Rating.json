{
  "schema": "face",
  "schema-version": 1,
  "name": "Rating",
  "description": "Short star scale for native score input or a precise readonly average",
  "props": {
    "value": {
      "type": "number",
      "required": false,
      "description": "Controlled finite score, bounded to 0..max. Zero means unrated.",
      "min": 0,
      "max": 10,
      "step": 0.1
    },
    "defaultValue": {
      "type": "number",
      "required": false,
      "description": "Initial uncontrolled score, restored by form reset. Defaults to 0.",
      "default": 0,
      "min": 0,
      "max": 10,
      "step": 0.5
    },
    "max": {
      "type": "number",
      "required": false,
      "description": "Number of stars: an integer from 1 to 10. Defaults to 5.",
      "default": 5,
      "min": 1,
      "max": 10,
      "step": 1
    },
    "disabled": {
      "type": "boolean",
      "required": false,
      "description": "Disable editing and native form submission, retaining the displayed score.",
      "default": false
    },
    "readOnly": {
      "type": "boolean",
      "required": false,
      "description": "Display a precise average as a measurement, without editing or required validation.",
      "default": false
    },
    "allowHalf": {
      "type": "boolean",
      "required": false,
      "description": "Allow half-star input steps. Readonly averages always retain exact fractions.",
      "default": false
    },
    "label": {
      "type": "ReactNode",
      "required": false,
      "description": "Noninteractive visible name; empty content falls back to native naming attributes."
    },
    "aria-label": {
      "type": "string",
      "required": false,
      "description": "Name override, or a name when no visible label is provided."
    },
    "aria-labelledby": {
      "type": "string",
      "required": false,
      "description": "External naming elements; takes precedence over label and aria-label."
    },
    "form": {
      "type": "string",
      "required": false,
      "description": "Id of an external native form that owns this score."
    },
    "autoFocus": {
      "type": "boolean",
      "required": false,
      "description": "Focus the selected or first editable choice on mount. Defaults to false.",
      "default": false
    },
    "membrane": {
      "type": "boolean",
      "required": false,
      "description": "Shared membrane spacing around each choice and the label. Defaults to true.",
      "default": true
    },
    "name": {
      "type": "string",
      "required": false,
      "description": "Nonempty native form key; use a distinct name for each independent rating."
    },
    "required": {
      "type": "boolean",
      "required": false,
      "description": "Require a score before submitting an editable rating. Defaults to false.",
      "default": false
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "defaultValue": 3,
        "max": 5,
        "label": "Your rating"
      }
    },
    {
      "name": "Half Stars",
      "props": {
        "defaultValue": 2.5,
        "allowHalf": true,
        "label": "Your rating"
      }
    },
    {
      "name": "Average Rating",
      "props": {
        "value": 4.2,
        "readOnly": true,
        "label": "Average rating"
      }
    },
    {
      "name": "Full Rating",
      "props": {
        "defaultValue": 5,
        "label": "Your rating"
      }
    },
    {
      "name": "Ten Stars",
      "props": {
        "defaultValue": 7,
        "max": 10,
        "label": "Your rating"
      }
    },
    {
      "name": "Disabled",
      "props": {
        "value": 4,
        "disabled": true,
        "label": "Locked rating"
      }
    }
  ],
  "behavior": {
    "rovingFocus": true,
    "nativeForm": true,
    "readOnly": "meter",
    "reselect": "preserve",
    "navigation": "wrap"
  },
  "keyboard": {
    "ArrowRight": {
      "action": "nextInWritingDirection"
    },
    "ArrowLeft": {
      "action": "previousInWritingDirection"
    },
    "ArrowDown": {
      "action": "next"
    },
    "ArrowUp": {
      "action": "previous"
    },
    "Home": {
      "action": "firstChoice"
    },
    "End": {
      "action": "lastChoice"
    },
    "Space": {
      "action": "selectFocusedChoice"
    }
  },
  "aria": {
    "role": "radiogroup",
    "required": [
      "accessible name"
    ],
    "readOnlyRole": "meter"
  },
  "composition": {
    "required": [
      "root",
      "list",
      "indicator"
    ],
    "recommended": [
      "label"
    ],
    "parts": {
      "root": {
        "slot": "root"
      },
      "label": {
        "slot": "label",
        "parent": "root"
      },
      "list": {
        "slot": "list",
        "parent": "root"
      },
      "item": {
        "slot": "item",
        "parent": "list",
        "multiple": true
      },
      "input": {
        "slot": "input",
        "parent": "item"
      },
      "indicator": {
        "slot": "indicator",
        "parent": "list",
        "multiple": true
      }
    },
    "notes": [
      "Editable mode adds native input/item parts; readOnly retains the root, list and decorative indicators."
    ]
  },
  "tokenMapping": {
    "component": [
      "--uf-rating-gap"
    ],
    "semanticFallbacks": [
      "--uf-membrane",
      "--uf-control-height",
      "--uf-radius",
      "--uf-color-fg",
      "--uf-color-hover-bg",
      "--uf-color-disabled-opacity"
    ],
    "notes": [
      "One shared Membrane surrounds every choice; half choices retain at least 24px hit width.",
      "The canonical 20px star glyph fills from the logical start of its ink bounds; readonly values retain exact fractions."
    ]
  },
  "platform": {},
  "usage": {
    "whenToUse": [
      "User review rating input",
      "Product rating display",
      "Satisfaction score"
    ],
    "whenNotToUse": [
      "Progress indication (use Progress)",
      "Numeric input (use Slider or Input)"
    ],
    "alternatives": [
      "Slider",
      "Input"
    ],
    "context": "both"
  }
}
