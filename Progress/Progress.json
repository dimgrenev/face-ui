{
  "schema": "face",
  "schema-version": 1,
  "name": "Progress",
  "description": "Loading progress indicator bar or circular ring",
  "props": {
    "value": {
      "type": "number",
      "required": false,
      "description": "Current value. Values outside 0..max are clamped for rendering and accessibility.",
      "default": 0
    },
    "max": {
      "type": "number",
      "required": false,
      "description": "Maximum value (default 100).",
      "default": 100
    },
    "indeterminate": {
      "type": "boolean",
      "required": false,
      "description": "Renders an unknown-duration progress state without exposing aria-valuenow.",
      "default": false
    },
    "tone": {
      "type": "enum",
      "required": false,
      "description": "Semantic feedback tone.",
      "options": [
        "neutral",
        "positive",
        "warning",
        "destructive"
      ],
      "default": "neutral"
    },
    "shape": {
      "type": "enum",
      "required": false,
      "description": "Visual progress shape.",
      "options": [
        "linear",
        "circle"
      ],
      "default": "linear"
    },
    "showValue": {
      "type": "boolean",
      "required": false,
      "description": "Show the computed percentage in the header or beside a circular ring.",
      "default": false
    },
    "label": {
      "type": "string",
      "required": false,
      "description": "Optional label rendered in the header for linear progress or beside the ring for circular progress."
    },
    "ariaLabel": {
      "type": "string",
      "required": false,
      "description": "Accessible label for the progressbar when no visible label is rendered."
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "value": 28,
        "max": 100,
        "tone": "neutral",
        "shape": "linear",
        "showValue": true,
        "label": "Typography"
      }
    },
    {
      "name": "Complete",
      "props": {
        "value": 100,
        "showValue": true,
        "label": "Deployment"
      }
    },
    {
      "name": "Positive",
      "props": {
        "value": 100,
        "tone": "positive",
        "showValue": true,
        "label": "Checks passed"
      }
    },
    {
      "name": "Warning",
      "props": {
        "value": 82,
        "tone": "warning",
        "showValue": true,
        "label": "Storage used"
      }
    },
    {
      "name": "Destructive",
      "props": {
        "value": 96,
        "tone": "destructive",
        "showValue": true,
        "label": "Quota used"
      }
    },
    {
      "name": "Circle",
      "props": {
        "value": 28,
        "shape": "circle",
        "showValue": true,
        "ariaLabel": "Context progress"
      }
    },
    {
      "name": "Indeterminate",
      "props": {
        "indeterminate": true,
        "label": "Loading assets"
      }
    }
  ],
  "behavior": {},
  "keyboard": {},
  "aria": {
    "role": "progressbar",
    "required": [
      "aria-valuenow",
      "aria-valuemin",
      "aria-valuemax",
      "aria-label or aria-labelledby"
    ]
  },
  "composition": {
    "required": [
      "root",
      "track",
      "indicator"
    ],
    "recommended": [
      "label"
    ],
    "parts": {
      "root": {
        "slot": "root"
      },
      "label": {
        "slot": "label",
        "parent": "root"
      },
      "track": {
        "slot": "track",
        "parent": "root"
      },
      "indicator": {
        "slot": "indicator",
        "parent": "track"
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-progress-track-height",
      "--uf-progress-track-inset-inline",
      "--uf-progress-label-min-width",
      "--uf-progress-circle-size",
      "--uf-progress-track-bg",
      "--uf-progress-indicator-bg",
      "--uf-progress-indicator-positive-bg",
      "--uf-progress-indicator-warning-bg",
      "--uf-progress-indicator-destructive-bg"
    ],
    "semanticFallbacks": [
      "--uf-membrane",
      "--uf-control-height",
      "--uf-control-gap",
      "--uf-control-pad-y",
      "--uf-control-pad-text",
      "--uf-radius-full",
      "--uf-font-size-sm",
      "--uf-color-fg",
      "--uf-color-hover-bg",
      "--uf-color-success",
      "--uf-color-warning",
      "--uf-color-destructive",
      "--uf-motion-duration-control",
      "--uf-motion-duration-loading",
      "--uf-motion-iteration-indefinite",
      "--uf-motion-ease-standard",
      "--uf-motion-ease-in-out"
    ],
    "notes": [
      "Progress labels render through Text.",
      "Linear progress uses a label/value header plus a one-membrane track inset to the same horizontal rhythm as Input and Select labels.",
      "Circular progress maps the same percent into --uf-progress-percent for a conic-gradient ring.",
      "Determinate width/ring fill and indeterminate animation remain behavior/data outputs, with motion driven by shared Face UI motion tokens."
    ]
  },
  "platform": {},
  "usage": {
    "whenToUse": [
      "Upload progress indicator",
      "Step completion percentage",
      "Loading state with known duration"
    ],
    "whenNotToUse": [
      "Content-shaped loading placeholders (use Skeleton)",
      "Step-by-step wizard (use Steps)"
    ],
    "alternatives": [
      "Skeleton",
      "Steps"
    ],
    "context": "both"
  }
}
