{
  "schema": "face",
  "schema-version": 1,
  "name": "Progress",
  "description": "Task completion with known or unknown duration, as a linear bar or circular ring",
  "props": {
    "value": {
      "type": "number",
      "required": false,
      "description": "Finite amount completed; values outside 0..max are bounded. Defaults to 0.",
      "default": 0
    },
    "max": {
      "type": "number",
      "required": false,
      "description": "Finite positive total amount of work. Defaults to 100.",
      "default": 100
    },
    "indeterminate": {
      "type": "boolean",
      "required": false,
      "description": "Unknown duration: omit aria-valuenow and numeric text. Defaults to false.",
      "default": false
    },
    "aria-label": {
      "type": "string",
      "required": false,
      "description": "Accessible name when no visible label is present, or an explicit name override."
    },
    "aria-labelledby": {
      "type": "string",
      "required": false,
      "description": "IDs of external naming elements; takes precedence over label and aria-label."
    },
    "aria-valuetext": {
      "type": "string",
      "required": false,
      "description": "Speech-only value description; formatValue controls visible text as well."
    },
    "tone": {
      "type": "enum",
      "required": false,
      "description": "Semantic feedback color, independent of the numeric value. Defaults to neutral.",
      "options": [
        "neutral",
        "positive",
        "warning",
        "destructive"
      ],
      "default": "neutral"
    },
    "shape": {
      "type": "enum",
      "required": false,
      "description": "Linear bar or circular ring; both display the same exact fraction. Defaults to linear.",
      "options": [
        "linear",
        "circle"
      ],
      "default": "linear"
    },
    "showValue": {
      "type": "boolean",
      "required": false,
      "description": "Show formatted value text. Unknown task progress never displays a numeric value.",
      "default": false
    },
    "label": {
      "type": "ReactNode",
      "required": false,
      "description": "Noninteractive visible label. Name an unlabelled indicator with native aria-label or aria-labelledby."
    },
    "membrane": {
      "type": "boolean",
      "required": false,
      "description": "Membrane spacing around the complete indicator. Defaults to true.",
      "default": true
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "value": 28,
        "max": 100,
        "tone": "neutral",
        "shape": "linear",
        "showValue": true,
        "label": "Uploading assets"
      }
    },
    {
      "name": "Complete",
      "props": {
        "value": 100,
        "showValue": true,
        "label": "Deployment"
      }
    },
    {
      "name": "Positive",
      "props": {
        "value": 100,
        "tone": "positive",
        "showValue": true,
        "label": "Checks passed"
      }
    },
    {
      "name": "Warning",
      "props": {
        "value": 82,
        "tone": "warning",
        "showValue": true,
        "label": "Upload paused"
      }
    },
    {
      "name": "Destructive",
      "props": {
        "value": 96,
        "tone": "destructive",
        "showValue": true,
        "label": "Upload failed"
      }
    },
    {
      "name": "Circle",
      "props": {
        "value": 28,
        "shape": "circle",
        "showValue": true,
        "aria-label": "Import progress"
      }
    },
    {
      "name": "Indeterminate",
      "props": {
        "indeterminate": true,
        "label": "Loading assets"
      }
    }
  ],
  "behavior": {},
  "keyboard": {},
  "aria": {
    "role": "progressbar",
    "required": [
      "aria-label or aria-labelledby"
    ],
    "notes": [
      "Known progress exposes aria-valuenow/min/max. Unknown progress omits aria-valuenow."
    ]
  },
  "composition": {
    "required": [
      "root",
      "track",
      "indicator"
    ],
    "recommended": [
      "label"
    ],
    "parts": {
      "root": {
        "slot": "root"
      },
      "label": {
        "slot": "label",
        "parent": "root"
      },
      "track": {
        "slot": "track",
        "parent": "root"
      },
      "indicator": {
        "slot": "indicator",
        "parent": "track"
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-range-track-height",
      "--uf-range-circle-size",
      "--uf-range-track-bg",
      "--uf-range-indicator-bg",
      "--uf-range-indicator-positive-bg",
      "--uf-range-indicator-warning-bg",
      "--uf-range-indicator-destructive-bg"
    ],
    "semanticFallbacks": [
      "--uf-membrane",
      "--uf-control-height",
      "--uf-control-gap",
      "--uf-control-pad-y",
      "--uf-control-pad-text",
      "--uf-radius-full",
      "--uf-font-size-sm",
      "--uf-color-fg",
      "--uf-color-hover-bg",
      "--uf-color-success",
      "--uf-color-warning",
      "--uf-color-destructive",
      "--uf-motion-duration-control",
      "--uf-motion-duration-loading",
      "--uf-motion-iteration-indefinite",
      "--uf-motion-ease-standard",
      "--uf-motion-ease-in-out"
    ],
    "notes": [
      "Progress and Meter share one presentation and the canonical Membrane.",
      "Both shapes use the exact bounded fraction through --uf-range-percent.",
      "Use formatValue for localized units and native aria-valuetext for a speech-only override."
    ]
  },
  "platform": {},
  "usage": {
    "whenToUse": [
      "Upload progress indicator",
      "Step completion percentage",
      "Loading state with known duration"
    ],
    "whenNotToUse": [
      "Content-shaped loading placeholders (use Skeleton)",
      "Step-by-step wizard (use Steps)",
      "Known measurements such as quota, storage or context usage (use Meter)"
    ],
    "alternatives": [
      "Skeleton",
      "Steps",
      "Meter"
    ],
    "context": "both"
  }
}
