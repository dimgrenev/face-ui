{
  "schema": "face",
  "schema-version": 1,
  "name": "Tile",
  "description": "Interactive row with nested action buttons. Acts as a single clickable surface while allowing independent nested Button actions (like Notion sidebar tabs). Uses div[role=button] to allow valid HTML nesting of child buttons.",
  "props": {
    "text": {
      "type": "string",
      "required": false,
      "description": "Primary label."
    },
    "rightText": {
      "type": "string",
      "required": false,
      "description": "Optional secondary text at the far right of the label area."
    },
    "variant": {
      "type": "enum",
      "required": false,
      "description": "Visual variant.",
      "options": [
        "default",
        "ghost",
        "accent"
      ],
      "default": "default"
    },
    "intent": {
      "type": "enum",
      "required": false,
      "description": "Semantic row intent. Use option for generic rows, navigation for selected app routes, disclosure for parent rows, tree for nested project rows, tab for tab controls, and section for non-interactive headings.",
      "options": [
        "option",
        "navigation",
        "disclosure",
        "tree",
        "tab",
        "section"
      ],
      "default": "option"
    },
    "density": {
      "type": "enum",
      "required": false,
      "description": "Internal spacing density. Default follows Button text padding; compact tightens tree/sidebar rows; spacious gives inspection rows more breathing room.",
      "options": [
        "default",
        "compact",
        "spacious"
      ],
      "default": "default"
    },
    "tone": {
      "type": "enum",
      "required": false,
      "description": "Semantic visual tone for row foreground and hover treatment.",
      "options": [
        "neutral",
        "muted",
        "accent",
        "positive",
        "warning",
        "destructive"
      ],
      "default": "neutral"
    },
    "actionVisibility": {
      "type": "enum",
      "required": false,
      "description": "How the actions slot is exposed: reveal on hover/focus/active, hover only, always visible, or hidden.",
      "options": [
        "reveal",
        "hover",
        "always",
        "hidden"
      ],
      "default": "reveal"
    },
    "icon": {
      "type": "string",
      "required": false,
      "description": "Icon (string from registry or ReactNode)."
    },
    "iconPosition": {
      "type": "enum",
      "required": false,
      "description": "Icon position relative to text.",
      "options": [
        "left",
        "right"
      ],
      "default": "left"
    },
    "leading": {
      "type": "ReactNode",
      "required": false,
      "description": "Isolated leading slot for nested controls. Use icon for decorative icons and leading for actionable controls."
    },
    "meta": {
      "type": "ReactNode",
      "required": false,
      "description": "Trailing non-interactive metadata rendered before actions."
    },
    "disabled": {
      "type": "boolean",
      "required": false,
      "description": "Disabled state.",
      "default": false
    },
    "busy": {
      "type": "boolean",
      "required": false,
      "description": "Marks the row busy with data-busy and aria-busy without disabling it by itself.",
      "default": false
    },
    "active": {
      "type": "boolean",
      "required": false,
      "description": "Active / selected state.",
      "default": false
    },
    "selectedDescendant": {
      "type": "boolean",
      "required": false,
      "description": "Marks parent rows that contain the selected descendant, commonly while collapsed.",
      "default": false
    },
    "interactive": {
      "type": "boolean",
      "required": false,
      "description": "Override interactive semantics. Set false for section/header rows that should not expose button behavior."
    },
    "stretchText": {
      "type": "boolean",
      "required": false,
      "description": "Stretch text area (flex:1)."
    },
    "selector": {
      "type": "boolean",
      "required": false,
      "description": "Render a compact selector indicator after the label.",
      "default": false
    },
    "selectorOpen": {
      "type": "boolean",
      "required": false,
      "description": "Open state for the selector indicator.",
      "default": false
    },
    "fullWidth": {
      "type": "boolean",
      "required": false,
      "description": "Full width tile.",
      "default": true
    },
    "align": {
      "type": "enum",
      "required": false,
      "description": "Text alignment.",
      "options": [
        "left",
        "right",
        "center"
      ],
      "default": "left"
    },
    "level": {
      "type": "number",
      "required": false,
      "description": "Nesting level for option-like rows: 0..9"
    },
    "truncate": {
      "type": "boolean",
      "required": false,
      "description": "Truncate overflowing text content with ellipsis.",
      "default": true
    },
    "membrane": {
      "type": "boolean",
      "required": false,
      "description": "Membrane spacing around the tile.",
      "default": true
    },
    "actions": {
      "type": "string",
      "required": false,
      "description": "Nested action buttons. Rendered at the far right; their clicks do not bubble to the tile."
    },
    "children": {
      "type": "string",
      "required": false,
      "description": "Custom children (overrides text/icon rendering)."
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "text": "Page title",
        "icon": "file"
      }
    },
    {
      "name": "Navigation Active",
      "props": {
        "intent": "navigation",
        "text": "Current page",
        "icon": "file",
        "active": true
      }
    },
    {
      "name": "Disclosure Parent",
      "props": {
        "intent": "disclosure",
        "text": "Project",
        "icon": "folder",
        "selector": true,
        "selectorOpen": true,
        "actionVisibility": "hover",
        "actions": "[Button icon=plus]"
      }
    },
    {
      "name": "Tree Row",
      "props": {
        "intent": "tree",
        "density": "compact",
        "text": "src/components/Button.tsx",
        "icon": "file",
        "level": 2
      }
    },
    {
      "name": "Tab",
      "props": {
        "intent": "tab",
        "text": "Preview",
        "icon": "browser",
        "active": true,
        "fullWidth": false,
        "actionVisibility": "hover",
        "actions": "[Button icon=close]"
      }
    },
    {
      "name": "Section",
      "props": {
        "intent": "section",
        "text": "Collections",
        "interactive": false
      }
    },
    {
      "name": "Busy Destructive",
      "props": {
        "text": "Delete chat?",
        "tone": "destructive",
        "busy": true,
        "actionVisibility": "always",
        "actions": "[Button icon=close]"
      }
    }
  ],
  "behavior": {},
  "keyboard": {
    "Enter": {
      "action": "activate"
    },
    "Space": {
      "action": "activate"
    }
  },
  "aria": {
    "role": "button"
  },
  "composition": {
    "required": [
      "root"
    ],
    "recommended": [
      "icon",
      "text",
      "indicator",
      "actions"
    ],
    "parts": {
      "root": {
        "slot": "root"
      },
      "leading": {
        "slot": "leading",
        "parent": "root"
      },
      "icon": {
        "slot": "icon",
        "parent": "root"
      },
      "text": {
        "slot": "text",
        "parent": "root"
      },
      "indicator": {
        "slot": "indicator",
        "parent": "text"
      },
      "meta": {
        "slot": "meta",
        "parent": "root"
      },
      "actions": {
        "slot": "actions",
        "parent": "root"
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-tile-pad",
      "--uf-tile-level-compensation",
      "--uf-tile-action-size",
      "--uf-tile-focus-ring-width",
      "--uf-tile-selector-indicator-opacity",
      "--uf-tile-selector-indicator-hover-opacity",
      "--uf-tile-bg",
      "--uf-tile-fg",
      "--uf-tile-hover-bg",
      "--uf-selector-indicator-gap",
      "--uf-selector-indicator-offset-inline-start",
      "--uf-selector-indicator-edge-gap",
      "--uf-selector-indicator-size",
      "--face-runtime-option-level"
    ],
    "semanticFallbacks": [
      "--uf-membrane",
      "--uf-control-height",
      "--uf-control-gap",
      "--uf-control-font-size",
      "--uf-control-line-height",
      "--uf-font-weight",
      "--uf-font-weight-bold",
      "--uf-radius",
      "--uf-color-fg",
      "--uf-color-hover-bg",
      "--uf-color-primary",
      "--uf-button-ring-color",
      "--uf-motion-duration-fast",
      "--uf-motion-duration-emphasis",
      "--uf-motion-ease-standard",
      "--uf-motion-ease-emphasized",
      "--uf-option-indent"
    ],
    "notes": [
      "Tile text and rightText render through Text; nested actions should remain Button or UF action components.",
      "Selector mode renders a compact indicator inside the text slot and defaults stretchText to false unless explicitly overridden.",
      "Level indentation is driven by --face-runtime-option-level from the level prop and shared option indentation tokens.",
      "Hover font-weight feedback and action reveal transitions consume shared Face UI motion tokens."
    ]
  },
  "platform": {},
  "usage": {
    "whenToUse": [
      "Grid item in dashboard",
      "Clickable card-like block",
      "Feature selection grid"
    ],
    "whenNotToUse": [
      "Standard content container (use Card)",
      "Navigation item (use Button)"
    ],
    "alternatives": [
      "Card",
      "Button"
    ],
    "context": "both"
  }
}
