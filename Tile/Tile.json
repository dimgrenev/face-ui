{
  "schema": "face",
  "schema-version": 1,
  "name": "Tile",
  "description": "Composed row with an optional primary action and independent leading/action controls. A composed button-like row uses a real sibling button; structural rows keep their explicit role.",
  "props": {
    "children": {
      "type": "ReactNode",
      "required": false,
      "description": "Label of the row; plain text truncates, rich content keeps its own layout."
    },
    "variant": {
      "type": "enum",
      "required": false,
      "description": "Visual variant.",
      "options": [
        "default",
        "ghost"
      ],
      "default": "default"
    },
    "density": {
      "type": "enum",
      "required": false,
      "description": "Density adjusts internal padding while keeping the shared control rhythm.",
      "options": [
        "default",
        "spacious"
      ],
      "default": "default"
    },
    "tone": {
      "type": "enum",
      "required": false,
      "description": "Semantic visual tone for muted, accent, status, or destructive rows.",
      "options": [
        "neutral",
        "muted",
        "accent",
        "positive",
        "warning",
        "destructive"
      ],
      "default": "neutral"
    },
    "actionVisibility": {
      "type": "enum",
      "required": false,
      "description": "Controls how the actions slot is revealed.",
      "options": [
        "reveal",
        "hover",
        "always",
        "hidden"
      ],
      "default": "reveal"
    },
    "icon": {
      "type": "ReactNode",
      "required": false,
      "description": "Icon (string from registry or ReactNode)."
    },
    "iconPosition": {
      "type": "enum",
      "required": false,
      "description": "Icon at the start or end of the label, following text direction. Default: start.",
      "options": [
        "start",
        "end"
      ],
      "default": "start"
    },
    "leading": {
      "type": "ReactNode",
      "required": false,
      "description": "Isolated leading slot for nested controls such as disclosure or file action buttons."
    },
    "meta": {
      "type": "ReactNode",
      "required": false,
      "description": "Secondary text or status at the inline end of the row, before actions."
    },
    "disabled": {
      "type": "boolean",
      "required": false,
      "description": "Disable the primary action. Nested controls own their disabled state.",
      "default": false
    },
    "active": {
      "type": "boolean",
      "required": false,
      "description": "Active / selected state.",
      "default": false
    },
    "interactive": {
      "type": "boolean",
      "required": false,
      "description": "Enable a primary action; inferred from onClick, aria-expanded or an explicit button/tab role."
    },
    "stretchText": {
      "type": "boolean",
      "required": false,
      "description": "Stretch text area (flex:1)."
    },
    "chevron": {
      "type": "enum",
      "description": "Trailing disclosure chevron: `down` flips with aria-expanded; `end` points to the inline end, mirrors in right-to-left text and turns down when expanded.",
      "enum": [
        "down",
        "end"
      ],
      "required": false,
      "options": [
        "down",
        "end"
      ]
    },
    "aria-expanded": {
      "type": "boolean",
      "required": false,
      "description": "Expanded state of the controlled region; makes the row a disclosure button and orients the chevron.",
      "options": [
        "false",
        "true"
      ]
    },
    "aria-busy": {
      "type": "boolean",
      "required": false,
      "description": "Busy state of the row region, reflected by the wait cursor.",
      "options": [
        "false",
        "true"
      ]
    },
    "fullWidth": {
      "type": "boolean",
      "required": false,
      "description": "Full width tile.",
      "default": true
    },
    "align": {
      "type": "enum",
      "required": false,
      "description": "Inline alignment of the content, following text direction. Default: start.",
      "options": [
        "start",
        "center",
        "end"
      ],
      "default": "start"
    },
    "indent": {
      "type": "number",
      "required": false,
      "description": "Indent steps for nested rows, an integer from 0 to 9."
    },
    "truncate": {
      "type": "boolean",
      "required": false,
      "description": "Truncate overflowing text content with ellipsis.",
      "default": true
    },
    "membrane": {
      "type": "boolean",
      "required": false,
      "description": "Membrane spacing around the tile.",
      "default": true
    },
    "actions": {
      "type": "ReactNode",
      "required": false,
      "description": "Nested action buttons at the inline end; their clicks do not reach the tile."
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "children": "Page title",
        "icon": "file"
      }
    },
    {
      "name": "Navigation Active",
      "props": {
        "children": "Current page",
        "icon": "file",
        "active": true
      }
    },
    {
      "name": "Disclosure Parent",
      "props": {
        "children": "Project",
        "icon": "folder",
        "chevron": "down",
        "aria-expanded": true,
        "actionVisibility": "hover",
        "actions": "[Button icon=plus]"
      }
    },
    {
      "name": "Tree Row",
      "props": {
        "children": "src/components/Button.tsx",
        "icon": "file",
        "indent": 2
      }
    },
    {
      "name": "Section",
      "props": {
        "tone": "muted",
        "children": "Collections",
        "interactive": false
      }
    },
    {
      "name": "Busy Destructive",
      "props": {
        "children": "Delete chat?",
        "tone": "destructive",
        "aria-busy": true,
        "actionVisibility": "always",
        "actions": "[Button icon=close]"
      }
    }
  ],
  "behavior": {},
  "keyboard": {
    "Enter": {
      "action": "activate"
    },
    "Space": {
      "action": "activate"
    }
  },
  "aria": {
    "role": "button"
  },
  "composition": {
    "required": [
      "root"
    ],
    "recommended": [
      "icon",
      "text",
      "indicator",
      "actions"
    ],
    "parts": {
      "root": {
        "slot": "root"
      },
      "leading": {
        "slot": "leading",
        "parent": "root"
      },
      "icon": {
        "slot": "icon",
        "parent": "root"
      },
      "text": {
        "slot": "text",
        "parent": "root"
      },
      "indicator": {
        "slot": "indicator",
        "parent": "text"
      },
      "meta": {
        "slot": "meta",
        "parent": "root"
      },
      "actions": {
        "slot": "actions",
        "parent": "root"
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-tile-pad",
      "--uf-tile-level-compensation",
      "--uf-tile-action-size",
      "--uf-tile-focus-ring-width",
      "--uf-tile-selector-indicator-opacity",
      "--uf-tile-selector-indicator-hover-opacity",
      "--uf-tile-bg",
      "--uf-tile-fg",
      "--uf-tile-hover-bg",
      "--uf-selector-indicator-gap",
      "--uf-selector-indicator-offset-inline-start",
      "--uf-selector-indicator-edge-gap",
      "--uf-selector-indicator-size",
      "--face-runtime-option-level"
    ],
    "semanticFallbacks": [
      "--uf-membrane",
      "--uf-control-height",
      "--uf-control-gap",
      "--uf-control-font-size",
      "--uf-control-line-height",
      "--uf-font-weight",
      "--uf-font-weight-bold",
      "--uf-radius",
      "--uf-color-fg",
      "--uf-color-hover-bg",
      "--uf-color-primary",
      "--uf-button-ring-color",
      "--uf-motion-duration-fast",
      "--uf-motion-duration-emphasis",
      "--uf-motion-ease-standard",
      "--uf-motion-ease-emphasized",
      "--uf-option-indent"
    ],
    "notes": [
      "Tile label and meta are plain slots; nested actions should remain Button or UF action components.",
      "Selector mode renders a compact indicator inside the text slot and defaults stretchText to false unless explicitly overridden.",
      "Indentation is driven by --face-runtime-option-level from the indent prop and shared option indentation tokens.",
      "Hover font-weight feedback and action reveal transitions consume shared Face UI motion tokens."
    ]
  },
  "platform": {},
  "usage": {
    "whenToUse": [
      "Grid item in dashboard",
      "Clickable card-like block",
      "Feature selection grid"
    ],
    "whenNotToUse": [
      "Standard content container (use Card)",
      "Navigation item (use Button)"
    ],
    "alternatives": [
      "Card",
      "Button"
    ],
    "context": "both"
  }
}
