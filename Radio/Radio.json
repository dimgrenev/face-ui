{
  "schema": "face",
  "schema-version": 1,
  "name": "Radio",
  "description": "Radio group for single-option selection",
  "props": {
    "options": {
      "type": "array",
      "required": false,
      "description": "Visible options in navigation order. Empty or missing options render an empty group."
    },
    "value": {
      "type": "string",
      "required": false,
      "description": "Controlled selection; null means no selection. Parent updates do not emit a change."
    },
    "defaultValue": {
      "type": "string",
      "required": false,
      "description": "Uncontrolled initial selection, restored by form reset."
    },
    "orientation": {
      "type": "enum",
      "required": false,
      "description": "Visual arrangement and ARIA orientation. Both arrow pairs remain available.",
      "options": [
        "horizontal",
        "vertical"
      ],
      "default": "vertical"
    },
    "autoFocus": {
      "type": "boolean",
      "required": false,
      "description": "Focus the selected enabled option, or the first enabled option, on mount.",
      "default": false
    },
    "aria-label": {
      "type": "string",
      "required": false,
      "description": "Accessible group name when there is no external visible heading."
    },
    "aria-labelledby": {
      "type": "string",
      "required": false,
      "description": "Ids of visible headings that name this group."
    },
    "disabled": {
      "type": "boolean",
      "required": false,
      "description": "Disable every option; native inputs leave focus navigation and form submission.",
      "default": false
    },
    "form": {
      "type": "string",
      "required": false,
      "description": "Id of an external native form that owns all options."
    },
    "membrane": {
      "type": "boolean",
      "required": false,
      "description": "Shared outer spacing around each option; preserves native controls when toggled.",
      "default": true
    },
    "name": {
      "type": "string",
      "required": false,
      "description": "Nonempty native group and FormData key; use a distinct name for each independent group in a form."
    },
    "required": {
      "type": "boolean",
      "required": false,
      "description": "Require a selection before submission. Native group validation requires a nonempty name.",
      "default": false
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "aria-label": "Example choice",
        "options": [
          {
            "value": "one",
            "label": "Option one"
          },
          {
            "value": "two",
            "label": "Option two"
          },
          {
            "value": "three",
            "label": "Option three",
            "disabled": true
          }
        ],
        "defaultValue": "one"
      }
    },
    {
      "name": "Horizontal",
      "props": {
        "aria-label": "Example choice",
        "options": [
          {
            "value": "one",
            "label": "Option one"
          },
          {
            "value": "two",
            "label": "Option two"
          },
          {
            "value": "three",
            "label": "Option three",
            "disabled": true
          }
        ],
        "defaultValue": "one",
        "orientation": "horizontal"
      }
    },
    {
      "name": "Disabled",
      "props": {
        "aria-label": "Example choice",
        "options": [
          {
            "value": "one",
            "label": "Option one"
          },
          {
            "value": "two",
            "label": "Option two"
          },
          {
            "value": "three",
            "label": "Option three",
            "disabled": true
          }
        ],
        "defaultValue": "one",
        "disabled": true
      }
    }
  ],
  "behavior": {
    "rovingFocus": true
  },
  "keyboard": {
    "Tab": {
      "action": "enterOrLeaveGroup"
    },
    "Space": {
      "action": "selectFocused"
    },
    "ArrowDown": {
      "action": "focusAndSelectNext"
    },
    "ArrowUp": {
      "action": "focusAndSelectPrevious"
    },
    "ArrowRight": {
      "action": "focusAndSelectRight",
      "condition": "RTL reverses option order"
    },
    "ArrowLeft": {
      "action": "focusAndSelectLeft",
      "condition": "RTL reverses option order"
    }
  },
  "aria": {
    "role": "radiogroup",
    "notes": [
      "Name the group with aria-label or aria-labelledby. Options use native labeled radio inputs.",
      "Native required validation needs a nonempty name; independent groups in one form must use distinct names."
    ]
  },
  "composition": {
    "required": [
      "root",
      "item",
      "input",
      "indicator",
      "label"
    ],
    "recommended": [],
    "parts": {
      "root": {
        "slot": "root"
      },
      "item": {
        "slot": "item",
        "parent": "root",
        "multiple": true
      },
      "input": {
        "slot": "input",
        "parent": "item"
      },
      "indicator": {
        "slot": "indicator",
        "parent": "item"
      },
      "label": {
        "slot": "label",
        "parent": "item"
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-radio-indicator-size"
    ],
    "semanticFallbacks": [
      "--uf-control-line-height",
      "--uf-control-height",
      "--uf-control-gap",
      "--uf-control-pad-y",
      "--uf-control-pad-icon",
      "--uf-control-pad-text",
      "--uf-radius",
      "--uf-color-fg",
      "--uf-color-hover-bg",
      "--uf-color-disabled-opacity"
    ],
    "notes": [
      "Radio indicator size is a component-local alias over the shared control line-height.",
      "Option labels route through Text; the hidden native input preserves form behavior while the visual shell stays token-driven."
    ]
  },
  "platform": {},
  "usage": {
    "whenToUse": [
      "Mutually exclusive single selection",
      "Settings with few visible options",
      "Survey single-choice questions"
    ],
    "whenNotToUse": [
      "Multiple selections (use Checkbox)",
      "Many options (use Select)",
      "Binary toggle (use Switcher)"
    ],
    "alternatives": [
      "Select",
      "Checkbox",
      "Switcher",
      "SegmentedControl"
    ],
    "context": "both"
  }
}
