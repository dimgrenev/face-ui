{
  "schema": "face",
  "schema-version": 1,
  "name": "Radio",
  "description": "Radio group for single-option selection",
  "props": {
    "options": {
      "type": "array",
      "required": false,
      "description": "Radio options to render.",
      "default": [
        {
          "value": "one",
          "label": "Option one"
        },
        {
          "value": "two",
          "label": "Option two"
        },
        {
          "value": "three",
          "label": "Option three",
          "disabled": true
        }
      ]
    },
    "value": {
      "type": "string",
      "required": false,
      "description": "Currently selected value."
    },
    "defaultValue": {
      "type": "string",
      "required": false,
      "description": "Uncontrolled initial selected value.",
      "default": "one"
    },
    "orientation": {
      "type": "enum",
      "required": false,
      "description": "Layout orientation.",
      "options": [
        "horizontal",
        "vertical"
      ],
      "default": "vertical"
    },
    "ariaLabel": {
      "type": "string",
      "required": false,
      "description": "Accessible label for the radio group (role=\"radiogroup\" requires a name)."
    },
    "disabled": {
      "type": "boolean",
      "required": false,
      "description": "Disabled state for the entire group.",
      "default": false
    },
    "required": {
      "type": "boolean",
      "required": false,
      "description": "Mark as required.",
      "default": false
    },
    "name": {
      "type": "string",
      "required": false,
      "description": "Form field name."
    },
    "membrane": {
      "type": "boolean",
      "required": false,
      "description": "Outer membrane wrapper around control geometry.",
      "default": true
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "options": [
          {
            "value": "one",
            "label": "Option one"
          },
          {
            "value": "two",
            "label": "Option two"
          },
          {
            "value": "three",
            "label": "Option three",
            "disabled": true
          }
        ],
        "defaultValue": "one"
      }
    },
    {
      "name": "Horizontal",
      "props": {
        "options": [
          {
            "value": "one",
            "label": "Option one"
          },
          {
            "value": "two",
            "label": "Option two"
          },
          {
            "value": "three",
            "label": "Option three",
            "disabled": true
          }
        ],
        "defaultValue": "one",
        "orientation": "horizontal"
      }
    },
    {
      "name": "Disabled",
      "props": {
        "options": [
          {
            "value": "one",
            "label": "Option one"
          },
          {
            "value": "two",
            "label": "Option two"
          },
          {
            "value": "three",
            "label": "Option three",
            "disabled": true
          }
        ],
        "defaultValue": "one",
        "disabled": true
      }
    }
  ],
  "behavior": {
    "rovingFocus": true
  },
  "keyboard": {
    "ArrowDown": {
      "action": "focusNext"
    },
    "ArrowUp": {
      "action": "focusPrevious"
    },
    "ArrowRight": {
      "action": "focusNext"
    },
    "ArrowLeft": {
      "action": "focusPrevious"
    }
  },
  "aria": {
    "role": "radiogroup",
    "required": [
      "aria-label"
    ]
  },
  "composition": {
    "required": [
      "root",
      "item",
      "indicator"
    ],
    "recommended": [],
    "parts": {
      "root": {
        "slot": "root"
      },
      "item": {
        "slot": "item",
        "parent": "root",
        "multiple": true
      },
      "indicator": {
        "slot": "indicator",
        "parent": "item"
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-radio-indicator-size"
    ],
    "semanticFallbacks": [
      "--uf-control-line-height",
      "--uf-control-height",
      "--uf-control-gap",
      "--uf-control-pad-y",
      "--uf-control-pad-icon",
      "--uf-control-pad-text",
      "--uf-radius",
      "--uf-color-fg",
      "--uf-color-hover-bg",
      "--uf-color-disabled-opacity"
    ],
    "notes": [
      "Radio indicator size is a component-local alias over the shared control line-height.",
      "Option labels route through Text; the hidden native input preserves form behavior while the visual shell stays token-driven."
    ]
  },
  "platform": {},
  "usage": {
    "whenToUse": [
      "Mutually exclusive single selection",
      "Settings with few visible options",
      "Survey single-choice questions"
    ],
    "whenNotToUse": [
      "Multiple selections (use Checkbox)",
      "Many options (use Select)",
      "Binary toggle (use Switcher)"
    ],
    "alternatives": [
      "Select",
      "Checkbox",
      "Switcher",
      "SegmentedControl"
    ],
    "context": "both"
  }
}
