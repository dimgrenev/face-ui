{
  "schema": "face",
  "schema-version": 1,
  "name": "Radio",
  "description": "A field of native radio inputs for one choice among visible items.",
  "props": {
    "label": {
      "type": "ReactNode",
      "required": false,
      "description": "Visible name of the value. Empty content leaves naming to aria-label/aria-labelledby."
    },
    "description": {
      "type": "ReactNode",
      "required": false,
      "description": "Help for entering the value, announced with the focused control."
    },
    "error": {
      "type": "ReactNode",
      "required": false,
      "description": "Validation message; marks the field invalid unless aria-invalid is explicit. Not a live region."
    },
    "labelPosition": {
      "type": "enum",
      "required": false,
      "description": "Label above the control, or at its inline start (stacks when narrow). Defaults to top.",
      "options": [
        "top",
        "start"
      ]
    },
    "items": {
      "type": "array",
      "required": false,
      "description": "Choices in navigation order; an item repeating an earlier value is dropped."
    },
    "value": {
      "type": "string",
      "required": false,
      "description": "Controlled selection; `null`, or a value missing from `items`, checks nothing."
    },
    "defaultValue": {
      "type": "string",
      "required": false,
      "description": "Uncontrolled initial selection, restored by form reset."
    },
    "orientation": {
      "type": "enum",
      "required": false,
      "description": "Stacks the items in a column or a row and sets aria-orientation; all four arrows move either way.",
      "options": [
        "horizontal",
        "vertical"
      ],
      "default": "vertical"
    },
    "autoFocus": {
      "type": "boolean",
      "required": false,
      "description": "Focuses the selected enabled item, else the first enabled one, on mount.",
      "default": false
    },
    "aria-label": {
      "type": "string",
      "required": false,
      "description": "Names the group when there is no visible `label`."
    },
    "aria-labelledby": {
      "type": "string",
      "required": false,
      "description": "Ids of the elements that name the group; wins over `label` and `aria-label`."
    },
    "disabled": {
      "type": "boolean",
      "required": false,
      "description": "Disables every item; native inputs leave the tab order and form submission.",
      "default": false
    },
    "form": {
      "type": "string",
      "required": false,
      "description": "Id of an external native form that owns every input."
    },
    "membrane": {
      "type": "boolean",
      "required": false,
      "description": "Shared outer spacing around each item; toggling it keeps the native inputs.",
      "default": true
    },
    "name": {
      "type": "string",
      "required": false,
      "description": "Nonempty native group and FormData key; use a distinct name for each independent group in a form."
    },
    "required": {
      "type": "boolean",
      "required": false,
      "description": "Require a selection before submission. Native group validation requires a nonempty name.",
      "default": false
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "label": "Example choice",
        "items": [
          {
            "value": "one",
            "label": "Option one"
          },
          {
            "value": "two",
            "label": "Option two"
          },
          {
            "value": "three",
            "label": "Option three",
            "disabled": true
          }
        ],
        "defaultValue": "one"
      }
    },
    {
      "name": "Horizontal",
      "props": {
        "label": "Example choice",
        "items": [
          {
            "value": "one",
            "label": "Option one"
          },
          {
            "value": "two",
            "label": "Option two"
          },
          {
            "value": "three",
            "label": "Option three",
            "disabled": true
          }
        ],
        "defaultValue": "one",
        "orientation": "horizontal"
      }
    },
    {
      "name": "Disabled",
      "props": {
        "label": "Example choice",
        "items": [
          {
            "value": "one",
            "label": "Option one"
          },
          {
            "value": "two",
            "label": "Option two"
          },
          {
            "value": "three",
            "label": "Option three",
            "disabled": true
          }
        ],
        "defaultValue": "one",
        "disabled": true
      }
    },
    {
      "name": "Invalid",
      "props": {
        "label": "Example choice",
        "description": "Pick the option that applies.",
        "error": "Choose an option.",
        "name": "example-choice",
        "required": true,
        "items": [
          {
            "value": "one",
            "label": "Option one"
          },
          {
            "value": "two",
            "label": "Option two"
          }
        ]
      }
    }
  ],
  "behavior": {
    "rovingFocus": true
  },
  "keyboard": {
    "Tab": {
      "action": "enterOrLeaveGroup"
    },
    "Space": {
      "action": "selectFocused"
    },
    "ArrowDown": {
      "action": "focusAndSelectNext"
    },
    "ArrowUp": {
      "action": "focusAndSelectPrevious"
    },
    "ArrowRight": {
      "action": "focusAndSelectRight",
      "condition": "RTL reverses option order"
    },
    "ArrowLeft": {
      "action": "focusAndSelectLeft",
      "condition": "RTL reverses option order"
    },
    "Home": {
      "action": "focusAndSelectFirst"
    },
    "End": {
      "action": "focusAndSelectLast"
    }
  },
  "aria": {
    "role": "radiogroup",
    "notes": [
      "Name the group with label, aria-label or aria-labelledby; description and error describe the group and every radio. Options use native labeled radio inputs.",
      "Native required validation needs a nonempty name; independent groups in one form must use distinct names."
    ]
  },
  "composition": {
    "required": [
      "root",
      "list",
      "item",
      "input",
      "indicator",
      "label"
    ],
    "recommended": [],
    "parts": {
      "root": {
        "slot": "root"
      },
      "list": {
        "slot": "list",
        "parent": "root"
      },
      "item": {
        "slot": "item",
        "parent": "list",
        "multiple": true
      },
      "input": {
        "slot": "input",
        "parent": "item"
      },
      "indicator": {
        "slot": "indicator",
        "parent": "item"
      },
      "label": {
        "slot": "label",
        "parent": "item"
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-radio-indicator-size"
    ],
    "semanticFallbacks": [
      "--uf-control-line-height",
      "--uf-control-height",
      "--uf-control-gap",
      "--uf-control-pad-y",
      "--uf-control-pad-icon",
      "--uf-control-pad-text",
      "--uf-radius",
      "--uf-color-fg",
      "--uf-color-hover-bg",
      "--uf-color-disabled-opacity"
    ],
    "notes": [
      "Radio indicator size is a component-local alias over the shared control line-height.",
      "Option labels route through Text; the hidden native input preserves form behavior while the visual shell stays token-driven."
    ]
  },
  "platform": {},
  "usage": {
    "whenToUse": [
      "Mutually exclusive single selection",
      "Settings with few visible options",
      "Survey single-choice questions"
    ],
    "whenNotToUse": [
      "Multiple selections (use Checkbox)",
      "Many options (use Select)",
      "Binary toggle (use Switcher)"
    ],
    "alternatives": [
      "Select",
      "Checkbox",
      "Switcher",
      "SegmentedControl"
    ],
    "context": "both"
  }
}
