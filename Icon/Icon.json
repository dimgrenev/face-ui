{
  "name": "Icon",
  "description": "Face UI icon renderer. Built-in icons always render at 20x20; unsupported sources render notdef.",
  "props": {
    "name": {
      "type": "string",
      "required": false,
      "description": "Registry icon name (backward-compatible)."
    },
    "icon": {
      "type": "any",
      "required": false,
      "description": "Compatibility input. String names resolve to Face UI icons; custom sources render notdef."
    },
    "src": {
      "type": "string",
      "required": false,
      "description": "Deprecated compatibility input. External URLs render notdef."
    },
    "size": {
      "type": "number",
      "required": false,
      "description": "Compatibility-only. Face UI icons always render at 20x20."
    },
    "square": {
      "type": "boolean",
      "required": false,
      "description": "Compatibility-only. Face UI icons always render at 20x20."
    },
    "className": {
      "type": "string",
      "required": false,
      "description": "className prop"
    },
    "style": {
      "type": "object",
      "required": false,
      "description": "style prop"
    },
    "label": {
      "type": "string",
      "required": false,
      "description": "Accessible label. If omitted, icon is decorative."
    },
    "title": {
      "type": "string",
      "required": false,
      "description": "Optional title element for inline SVG."
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "name": "settings",
        "size": 20
      }
    },
    {
      "name": "Compatibility Size Ignored",
      "props": {
        "name": "settings",
        "size": 20
      }
    },
    {
      "name": "Direction Left",
      "props": {
        "name": "left",
        "size": 20
      }
    },
    {
      "name": "Direction Right",
      "props": {
        "name": "right",
        "size": 20
      }
    },
    {
      "name": "Compatibility Small Size Ignored",
      "props": {
        "name": "legend",
        "size": 20
      }
    }
  ],
  "behavior": {},
  "keyboard": {},
  "aria": {
    "role": "img"
  },
  "composition": {
    "required": [
      "root"
    ],
    "parts": {
      "root": {
        "slot": "root"
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-icon-size"
    ],
    "semanticFallbacks": [
      "--uf-color-background"
    ],
    "notes": [
      "Icon inherits color through currentColor and does not own palette semantics.",
      "Parent component slots may provide --uf-icon-size, but the rendered Icon DOM box remains 20x20.",
      "Some built-in glyphs use --uf-color-background for internal knockouts; keep this tied to theme background until icon theming is formalized."
    ]
  },
  "platform": {},
  "usage": {
    "whenToUse": [
      "Visual indicators in buttons/menus",
      "Status icons",
      "Navigation icons"
    ],
    "whenNotToUse": [
      "Decorative images (use Media)",
      "User avatars (use Avatar)"
    ],
    "alternatives": [
      "Media",
      "Avatar"
    ],
    "context": "both"
  }
}
