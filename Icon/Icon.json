{
  "schema": "face",
  "schema-version": 1,
  "name": "Icon",
  "description": "Local Iconoteka pictograms, with Face UI's stable sizing and API.",
  "props": {
    "name": {
      "type": "string",
      "required": true,
      "description": "Stable Face UI alias. Unknown names render notdef; a blank name renders nothing."
    },
    "aria-label": {
      "type": "string",
      "required": false,
      "description": "Accessible name; icons without a label or title are decorative."
    },
    "title": {
      "type": "string",
      "required": false,
      "description": "Native pointer hint and accessible name when aria-label is absent."
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "name": "settings"
      }
    },
    {
      "name": "Direction Left",
      "props": {
        "name": "left"
      }
    },
    {
      "name": "Direction Right",
      "props": {
        "name": "right"
      }
    },
    {
      "name": "Accessible",
      "props": {
        "name": "account",
        "aria-label": "Account"
      }
    }
  ],
  "behavior": {},
  "keyboard": {},
  "aria": {
    "role": "img"
  },
  "composition": {
    "required": [
      "root"
    ],
    "parts": {
      "root": {
        "slot": "root"
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-icon-size"
    ],
    "semanticFallbacks": [
      "--uf-color-background"
    ],
    "notes": [
      "Icon inherits currentColor and does not own palette semantics.",
      "Rendered icons keep a 20x20 box; Iconoteka contours use a native 24x24 viewBox.",
      "SVG counters are transparent and remain correct in both themes."
    ]
  },
  "platform": {},
  "usage": {
    "whenToUse": [
      "Visual indicators in buttons/menus",
      "Status icons",
      "Navigation icons"
    ],
    "whenNotToUse": [
      "Decorative images (use Media)",
      "User avatars (use Avatar)"
    ],
    "alternatives": [
      "Media",
      "Avatar"
    ],
    "context": "both"
  }
}
