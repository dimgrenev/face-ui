{
  "schema": "face",
  "schema-version": 1,
  "name": "Command",
  "description": "A search field that filters a list of commands, in the page or in a dialog.",
  "props": {
    "items": {
      "type": "array",
      "required": false,
      "description": "Commands and labelled groups in list order; an item repeating an earlier value is dropped.",
      "contract": {
        "item": {
          "type": "object",
          "required": [
            "value",
            "label"
          ],
          "properties": {
            "value": {
              "type": "string",
              "description": "Stable key, unique within the collection; an empty string is a valid key."
            },
            "label": {
              "type": "node",
              "description": "Visible content."
            },
            "disabled": {
              "type": "boolean",
              "required": false,
              "description": "Keeps the item visible but out of selection and keyboard navigation."
            },
            "textValue": {
              "type": "string",
              "required": false,
              "description": "Plain text for typeahead and filtering when `label` is not a string."
            },
            "icon": {
              "type": "node",
              "required": false,
              "description": "Icon at the start of the label."
            },
            "keywords": {
              "type": "array",
              "required": false,
              "description": "More words the search finds the item by, such as synonyms; they are not shown."
            }
          }
        },
        "group": {
          "type": "object",
          "required": [
            "type",
            "label",
            "items"
          ],
          "properties": {
            "type": {
              "type": "literal",
              "value": "group"
            },
            "label": {
              "type": "node",
              "description": "Visible group heading."
            },
            "items": {
              "type": "array",
              "description": "The grouped items, in order."
            }
          }
        }
      }
    },
    "search": {
      "type": "string",
      "required": false,
      "description": "Search text that filters the items; the parent owns it while set."
    },
    "defaultSearch": {
      "type": "string",
      "required": false,
      "description": "Search text on mount when `search` is not set; read once.",
      "default": ""
    },
    "placeholder": {
      "type": "string",
      "required": false,
      "description": "Hint in the empty search field and the dialog trigger; names the search without aria-label."
    },
    "surface": {
      "type": "enum",
      "required": false,
      "description": "Where the search shows: in the page, or in a dialog opened from a trigger; auto is a dialog below 900px. Default auto.",
      "options": [
        "auto",
        "inline",
        "dialog"
      ],
      "default": "auto"
    },
    "open": {
      "type": "boolean",
      "required": false,
      "description": "Controlled visibility of the dialog; an inline Command is always shown."
    },
    "defaultOpen": {
      "type": "boolean",
      "required": false,
      "description": "Dialog visibility on mount when `open` is not set; read once.",
      "default": false
    },
    "aria-label": {
      "type": "string",
      "required": false,
      "description": "Names the search field, its list and dialog, and the dialog trigger."
    },
    "aria-labelledby": {
      "type": "string",
      "required": false,
      "description": "Ids of the elements that name the search field, its list and dialog, and the trigger; wins over aria-label."
    },
    "labels": {
      "type": "object",
      "required": false,
      "description": "Strings Command renders itself: `empty` replaces the list when no item matches."
    }
  },
  "states": [
    {
      "name": "Default",
      "props": {
        "placeholder": "Type a command...",
        "aria-label": "Commands",
        "defaultSearch": "",
        "surface": "auto",
        "defaultOpen": false,
        "items": [
          {
            "value": "copy",
            "label": "Copy"
          },
          {
            "value": "paste",
            "label": "Paste"
          },
          {
            "value": "cut",
            "label": "Cut"
          }
        ]
      }
    },
    {
      "name": "Custom Placeholder",
      "props": {
        "placeholder": "Search actions..."
      }
    },
    {
      "name": "Grouped",
      "props": {
        "items": [
          {
            "type": "group",
            "label": "Edit",
            "items": [
              {
                "value": "copy",
                "label": "Copy",
                "keywords": [
                  "duplicate"
                ]
              },
              {
                "value": "paste",
                "label": "Paste",
                "disabled": true
              }
            ]
          },
          {
            "type": "group",
            "label": "View",
            "items": [
              {
                "value": "zoom",
                "label": "Zoom in"
              }
            ]
          }
        ]
      }
    }
  ],
  "behavior": {
    "rovingFocus": false,
    "activeDescendant": true,
    "typeahead": false,
    "filter": "every search word in textValue, a text label or keywords; case and accents ignored",
    "dismissOnEscape": true,
    "dismissOnClickOutside": true,
    "closeOnSelect": "dialog",
    "autoFocusOnOpen": "search field",
    "focusTrap": "dialog",
    "scrollLock": "dialog"
  },
  "keyboard": {
    "ArrowDown": {
      "action": "focusNext",
      "scope": "list"
    },
    "ArrowUp": {
      "action": "focusPrevious",
      "scope": "list"
    },
    "Enter": {
      "action": "select"
    },
    "Escape": {
      "action": "close",
      "scope": "dialog"
    }
  },
  "aria": {
    "role": "combobox"
  },
  "composition": {
    "required": [
      "root",
      "input",
      "list"
    ],
    "recommended": [
      "item",
      "group",
      "groupLabel",
      "empty"
    ],
    "parts": {
      "root": {
        "slot": "root"
      },
      "input": {
        "slot": "input",
        "parent": "root"
      },
      "list": {
        "slot": "list",
        "parent": "root"
      },
      "item": {
        "slot": "item",
        "parent": "list",
        "multiple": true
      },
      "group": {
        "slot": "group",
        "parent": "list",
        "multiple": true
      },
      "groupLabel": {
        "slot": "groupLabel",
        "parent": "group"
      },
      "empty": {
        "slot": "empty",
        "parent": "list"
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-command-border-width",
      "--uf-command-list-max-height",
      "--uf-command-dialog-list-viewport-gap",
      "--uf-command-dialog-enter-y",
      "--uf-command-dialog-inset",
      "--uf-command-dialog-viewport-gap"
    ],
    "semanticFallbacks": [
      "--uf-control-height",
      "--uf-control-font-size",
      "--uf-control-line-height",
      "--uf-control-pad-y",
      "--uf-control-pad-text",
      "--uf-control-pad-icon",
      "--uf-control-gap",
      "--uf-content-inset",
      "--uf-membrane",
      "--uf-font-size",
      "--uf-font-size-xs",
      "--uf-font-weight-bold",
      "--uf-radius",
      "--uf-radius-md",
      "--uf-z-overlay",
      "--uf-duration-enter",
      "--uf-duration-exit",
      "--uf-ease-enter",
      "--uf-color-bg",
      "--uf-color-fg",
      "--uf-color-fg-muted",
      "--uf-color-hover-bg",
      "--uf-overlay-surface-bg",
      "--uf-overlay-surface-border",
      "--uf-overlay-surface-blur",
      "--uf-overlay-surface-shadow"
    ],
    "notes": [
      "Command combines input, list and dialog surfaces; keep search input geometry on shared control tokens.",
      "Use UF product composites for domain-specific command rows instead of expanding this primitive contract."
    ]
  },
  "platform": {
    "dialog": true,
    "popover": true
  },
  "usage": {
    "whenToUse": [
      "Quick action search with keyboard",
      "Command palette (Cmd+K)",
      "Searchable action list"
    ],
    "whenNotToUse": [
      "Simple value selection (use Select)",
      "Contextual actions on element (use Menu)",
      "Navigation between pages (use Navigation)"
    ],
    "alternatives": [
      "Select",
      "Menu",
      "Navigation"
    ],
    "context": "app"
  }
}
