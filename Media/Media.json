{
  "schema": "face",
  "schema-version": 1,
  "name": "Media",
  "description": "Unified image, video, and audio renderer",
  "props": {
    "type": {
      "type": "enum",
      "required": false,
      "description": "Media type. Defaults to \"image\".",
      "options": [
        "image",
        "video",
        "audio"
      ],
      "default": "image"
    },
    "src": {
      "type": "string",
      "required": true,
      "description": "Source URL."
    },
    "alt": {
      "type": "string",
      "required": false,
      "description": "Alt text (for images).",
      "default": ""
    },
    "variant": {
      "type": "enum",
      "required": false,
      "description": "components API compatibility: image variant.",
      "options": [
        "default",
        "rounded",
        "circle",
        "thumbnail"
      ],
      "default": "default"
    },
    "lazy": {
      "type": "boolean",
      "required": false,
      "description": "components API compatibility aliases for image loading hints.",
      "default": false
    },
    "loading": {
      "type": "enum",
      "required": false,
      "description": "Image loading hint",
      "options": [
        "lazy",
        "eager"
      ]
    },
    "decoding": {
      "type": "enum",
      "required": false,
      "description": "Image decoding hint",
      "options": [
        "async",
        "sync",
        "auto"
      ]
    },
    "poster": {
      "type": "string",
      "required": false,
      "description": "Poster image (for video)."
    },
    "controls": {
      "type": "boolean",
      "required": false,
      "description": "Show native controls (for video/audio)."
    },
    "autoPlay": {
      "type": "boolean",
      "required": false,
      "description": "Auto-play media."
    },
    "loop": {
      "type": "boolean",
      "required": false,
      "description": "Loop playback."
    },
    "muted": {
      "type": "boolean",
      "required": false,
      "description": "Start muted."
    },
    "width": {
      "type": "string",
      "required": false,
      "description": "Explicit width."
    },
    "height": {
      "type": "string",
      "required": false,
      "description": "Explicit height."
    },
    "objectFit": {
      "type": "enum",
      "required": false,
      "description": "CSS object-fit for images/video.",
      "options": [
        "cover",
        "contain",
        "fill",
        "none"
      ]
    },
    "fallback": {
      "type": "string",
      "required": false,
      "description": "Fallback content shown on error."
    },
    "onError": {
      "type": "function",
      "required": false,
      "description": "Called when the media fails to load."
    },
    "onLoad": {
      "type": "function",
      "required": false,
      "description": "Called when the media finishes loading."
    },
    "className": {
      "type": "string",
      "required": false,
      "description": "Additional class name on the root element."
    },
    "membrane": {
      "type": "boolean",
      "required": false,
      "description": "Membrane spacing around media.",
      "default": false
    },
    "role": {
      "type": "string",
      "required": false,
      "description": "role prop"
    },
    "ariaLabel": {
      "type": "string",
      "required": false,
      "description": "Accessible label for the wrapper role. Sets aria-label."
    },
    "title": {
      "type": "string",
      "required": false,
      "description": "title prop"
    },
    "tabIndex": {
      "type": "number",
      "required": false,
      "description": "tabIndex prop"
    },
    "style": {
      "type": "object",
      "required": false,
      "description": "style prop"
    }
  },
  "states": [
    {
      "name": "Default Image",
      "props": {
        "type": "image",
        "alt": "Bright office lobby with glass-block wall, seating, and plants",
        "variant": "default",
        "lazy": false,
        "membrane": false,
        "src": "/assets/media/examples/office-core/lobby-day.webp"
      }
    },
    {
      "name": "Cover Fit",
      "props": {
        "src": "/assets/media/examples/office-core/lobby-glass-blocks.webp",
        "alt": "Office lobby with glass-block wall, seating, and a person standing by the window",
        "objectFit": "cover",
        "width": "200",
        "height": "200"
      }
    },
    {
      "name": "Contain Fit",
      "props": {
        "src": "/assets/media/examples/office-core/skyline-window-day.webp",
        "alt": "Two people looking out from a high-rise office window during the day",
        "objectFit": "contain",
        "width": "200",
        "height": "200"
      }
    }
  ],
  "behavior": {},
  "keyboard": {},
  "aria": {
    "nativeElement": "Root is a <div> container whose ARIA role is the pass-through `role` prop (no default → none). The `element` part is a native <img>/<video>/<audio>; for images the accessible name comes from `alt`, and playback semantics come from the native <video>/<audio> element.",
    "notes": [
      "No fixed root role is emitted. Pass `role` explicitly (e.g. \"img\") only when the container itself should expose one.",
      "For images provide `alt` for an accessible name; an empty `alt` marks the image presentational. `aria-label` is an optional wrapper label, not the image name."
    ]
  },
  "composition": {
    "required": [
      "root",
      "element"
    ],
    "recommended": [
      "fallback"
    ],
    "parts": {
      "root": {
        "slot": "root"
      },
      "element": {
        "slot": "element",
        "parent": "root"
      },
      "fallback": {
        "slot": "fallback",
        "parent": "root"
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-media-fallback-size"
    ],
    "semanticFallbacks": [
      "--uf-control-height",
      "--uf-radius",
      "--uf-radius-md",
      "--uf-radius-sm",
      "--uf-radius-full",
      "--uf-membrane",
      "--uf-color-hover-bg",
      "--uf-color-fg-muted",
      "--uf-color-border"
    ],
    "notes": [
      "Media fallback geometry is tokenized; width, height and objectFit remain product media layout inputs.",
      "Native audio/video controls are browser-owned and intentionally outside Face UI control styling."
    ]
  },
  "platform": {},
  "usage": {
    "whenToUse": [
      "Image display with alt text",
      "Video embedding",
      "Responsive media containers"
    ],
    "whenNotToUse": [
      "User avatars (use Avatar)",
      "Decorative icons (use Icon)"
    ],
    "alternatives": [
      "Avatar",
      "Icon"
    ],
    "context": "both"
  }
}
