{
  "schema": "face",
  "schema-version": 1,
  "name": "Toggle",
  "description": "Deprecated type/array adapter for SegmentedControl; one shared runtime",
  "props": {
    "items": {
      "type": "array",
      "required": false,
      "description": "Choices in visual, keyboard and form order; missing items render an empty group."
    },
    "disabled": {
      "type": "boolean",
      "required": false,
      "description": "Disable every control and exclude the group from FormData."
    },
    "orientation": {
      "type": "enum",
      "required": false,
      "description": "Visual axis; single radio mode supports both arrow pairs.",
      "options": [
        "horizontal",
        "vertical"
      ]
    },
    "aria-label": {
      "type": "string",
      "required": false,
      "description": "Accessible group name when there is no visible heading."
    },
    "aria-labelledby": {
      "type": "string",
      "required": false,
      "description": "Visible heading IDs that name this group."
    },
    "name": {
      "type": "string",
      "required": false,
      "description": "Native FormData key; multiple selections produce repeated entries."
    },
    "form": {
      "type": "string",
      "required": false,
      "description": "ID of an external form that owns the selection."
    },
    "autoFocus": {
      "type": "boolean",
      "required": false,
      "description": "Focus the selected enabled choice, or the first enabled choice, on mount."
    },
    "membrane": {
      "type": "boolean",
      "required": false,
      "description": "Shared outer spacing around each item; toggling preserves DOM and focus."
    },
    "type": {
      "type": "enum",
      "required": false,
      "description": "Legacy selection mode; new code uses SegmentedControl multiple.",
      "options": [
        "single",
        "multiple"
      ],
      "default": "multiple"
    },
    "value": {
      "type": "array",
      "required": false,
      "description": "Selected choices; single mode accepts at most one."
    },
    "defaultValue": {
      "type": "array",
      "required": false,
      "description": "Initial choices, restored on form reset."
    }
  },
  "states": [
    {
      "name": "Default (Multiple)",
      "props": {
        "type": "multiple"
      }
    },
    {
      "name": "Single",
      "props": {
        "type": "single"
      }
    },
    {
      "name": "Vertical",
      "props": {
        "orientation": "vertical"
      }
    },
    {
      "name": "Disabled",
      "props": {
        "disabled": true
      }
    }
  ],
  "behavior": {
    "rovingFocus": true
  },
  "keyboard": {
    "ArrowRight": {
      "action": "focusNext"
    },
    "ArrowLeft": {
      "action": "focusPrevious"
    },
    "Enter": {
      "action": "toggle"
    },
    "Space": {
      "action": "toggle"
    }
  },
  "aria": {
    "role": "group",
    "required": [
      "aria-label"
    ]
  },
  "composition": {
    "required": [
      "root",
      "item"
    ],
    "parts": {
      "root": {
        "slot": "root"
      },
      "item": {
        "slot": "item",
        "parent": "root",
        "multiple": true
      }
    }
  },
  "tokenMapping": {
    "component": [
      "--uf-toggle-border-width"
    ],
    "semanticFallbacks": [
      "--uf-membrane",
      "--uf-overlay-surface-border",
      "--uf-radius",
      "--uf-control-height",
      "--uf-control-pad-y",
      "--uf-control-pad-text",
      "--uf-color-fg",
      "--uf-color-hover-bg",
      "--uf-color-active-bg",
      "--uf-border-width-thin"
    ],
    "notes": [
      "Compatibility Toggle delegates to SegmentedControl, including native names/forms and shared Membrane."
    ]
  },
  "platform": {},
  "usage": {
    "whenToUse": [
      "Deprecated — use SegmentedControl instead"
    ],
    "whenNotToUse": [
      "Any new code (use SegmentedControl)"
    ],
    "alternatives": [
      "SegmentedControl"
    ],
    "context": "both"
  }
}
